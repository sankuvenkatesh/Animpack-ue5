"""Autodesk Maya File Import-Export for Blender 5.2.x

This add-on uses Autodesk Maya's mayapy.exe and Maya's FBX plug-in as a
conversion bridge. It does not parse .mb/.ma files directly in Blender.

Export: Blender -> temporary FBX -> Maya standalone -> .ma or .mb
Import: .ma or .mb -> Maya standalone -> temporary FBX -> Blender

Important: an FBX round-trip cannot preserve every Maya-only feature. Some
Maya-specific nodes, plug-ins, constraints, render settings and procedural
networks may not have an equivalent representation in FBX or Blender.
"""

import bpy
import json
import os
import subprocess
import tempfile
import textwrap
import traceback
from pathlib import Path
from bpy.props import (
    BoolProperty,
    IntProperty,
    StringProperty,
)
