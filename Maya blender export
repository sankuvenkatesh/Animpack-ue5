# -----------------------------------------------------------------------------
# Constants and paths
# -----------------------------------------------------------------------------

ADDON_MODULE = __package__ if __package__ else __name__
DEFAULT_MAYA_PATH = r"C:\Program Files\Autodesk\Maya2025\bin\mayapy.exe"
MAYA_EXTENSIONS = {".ma", ".mb"}


def _get_preferences():
    """Return this add-on's preferences, or None when run as a text script."""
    try:
        addon = bpy.context.preferences.addons.get(ADDON_MODULE)
        return addon.preferences if addon else None
    except (AttributeError, ReferenceError):
        return None


def _get_mayapy_path():
    prefs = _get_preferences()
    if prefs and prefs.mayapy_path.strip():
        return bpy.path.abspath(prefs.mayapy_path.strip())
    return bpy.path.abspath(DEFAULT_MAYA_PATH)


def _get_timeout():
    prefs = _get_preferences()
    return max(30, int(prefs.timeout_seconds)) if prefs else 600


def _ensure_fbx_operators():
    """Blender 5.2 exposes FBX through the FBX I/O extension/add-on."""
    missing = []
    try:
        if not hasattr(bpy.ops.export_scene, "fbx"):
            missing.append("FBX Export")
    except Exception:
        missing.append("FBX Export")
    try:
        if not hasattr(bpy.ops.import_scene, "fbx"):
            missing.append("FBX Import")
    except Exception:
        missing.append("FBX Import")

    if missing:
        raise RuntimeError(
            ", ".join(missing) + " operator(s) are unavailable. "
            "Enable/install Blender's FBX I/O extension, then try again."
        )


def _operator_supported_kwargs(operator, kwargs):
    """Filter kwargs against the current operator RNA for version tolerance."""
    try:
        properties = operator.get_rna_type().properties
        valid_names = {prop.identifier for prop in properties}
        return {key: value for key, value in kwargs.items() if key in valid_names}
    except Exception:
        return kwargs


def _call_operator(operator, **kwargs):
    kwargs = _operator_supported_kwargs(operator, kwargs)
    return operator('EXEC_DEFAULT', **kwargs)


def _normalise_maya_path(path):
    path = os.path.abspath(bpy.path.abspath(path))
    ext = Path(path).suffix.lower()
    if ext not in MAYA_EXTENSIONS:
        raise ValueError("The target/source file must use .ma or .mb extension.")
    return path


def _maya_script_source():
    """Code executed by Maya's own mayapy interpreter."""
    return textwrap.dedent(r'''
        import json
        import os
        import sys
        import traceback

        def mel_quote(value):
            value = os.path.abspath(value).replace("\\", "/")
            return '"' + value.replace('"', '\\"') + '"'

        def ensure_fbx_plugin(cmds):
            candidates = ("fbxmaya", "fbxmaya.mll", "fbxmaya.bundle")
            last_error = None
            for plugin_name in candidates:
                try:
                    try:
                        loaded = cmds.pluginInfo(plugin_name, query=True, loaded=True)
                    except Exception:
                        loaded = False
                    if not loaded:
                        cmds.loadPlugin(plugin_name, quiet=True)
                    return
                except Exception as exc:
                    last_error = exc
            raise RuntimeError("Could not load Maya's FBX plug-in (fbxmaya): %s" % last_error)

        def main():
            # args: script, mode, input_path, output_path, json_options
            if len(sys.argv) < 5:
                raise RuntimeError("Maya bridge received incomplete command-line arguments.")
            mode = sys.argv[1]
            input_path = os.path.abspath(sys.argv[2])
            output_path = os.path.abspath(sys.argv[3])
            options = json.loads(sys.argv[4]) if len(sys.argv) > 4 else {}

            if not os.path.isfile(input_path):
                raise RuntimeError("Input file does not exist: %s" % input_path)

            import maya.standalone
            maya.standalone.initialize(name="python")

            try:
                import maya.cmds as cmds
                import maya.mel as mel
                ensure_fbx_plugin(cmds)

                if mode == "maya_to_fbx":
                    cmds.file(new=True, force=True)
                    cmds.file(input_path, open=True, force=True, prompt=False)

                    mel.eval("FBXResetExport;")
                    mel.eval("FBXExportInAscii -v false;")
                    mel.eval("FBXExportCameras -v true;")
                    mel.eval("FBXExportLights -v true;")
                    mel.eval("FBXExportSkins -v true;")
                    mel.eval("FBXExportShapes -v true;")
                    mel.eval("FBXExportMaterials -v true;")
                    mel.eval("FBXExportInputConnections -v true;")
                    mel.eval("FBXExportBakeComplexAnimation -v %s;" % (
                        "true" if options.get("animations", True) else "false"))
                    mel.eval("FBXExport -f %s;" % mel_quote(output_path))

                elif mode == "fbx_to_maya":
                    cmds.file(new=True, force=True)
                    mel.eval("FBXResetImport;")
                    mel.eval("FBXImportMode -v add;")
                    mel.eval("FBXImport -f %s;" % mel_quote(input_path))

                    output_ext = os.path.splitext(output_path)[1].lower()
                    maya_file_type = "mayaAscii" if output_ext == ".ma" else "mayaBinary"
                    cmds.file(rename=output_path)
                    cmds.file(save=True, force=True, type=maya_file_type)
                else:
                    raise RuntimeError("Unknown Maya bridge mode: %s" % mode)

                if not os.path.isfile(output_path):
                    raise RuntimeError("Maya completed without creating the expected file: %s" % output_path)

            finally:
                try:
                    maya.standalone.uninitialize()
                except Exception:
                    pass

        try:
            main()
        except Exception:
            traceback.print_exc()
            sys.exit(1)
    ''')


def _maya_environment(mayapy_path, temp_root):
    env = os.environ.copy()
    maya_bin = os.path.dirname(os.path.abspath(mayapy_path))
    maya_root = os.path.dirname(maya_bin)
    env["MAYA_LOCATION"] = maya_root
    env["MAYA_APP_DIR"] = os.path.join(temp_root, "maya_app")
    env["PYTHONIOENCODING"] = "utf-8"
    env["PATH"] = maya_bin + os.pathsep + env.get("PATH", "")
    os.makedirs(env["MAYA_APP_DIR"], exist_ok=True)
    return env


def _run_maya_bridge(mayapy_path, mode, input_path, output_path, options=None):
    """Run Maya standalone and include useful diagnostic output on failure."""
    mayapy_path = os.path.abspath(bpy.path.abspath(mayapy_path))
    if not os.path.isfile(mayapy_path):
        raise FileNotFoundError(
            "Maya Python executable was not found:\n%s\n\n"
            "Open Edit > Preferences > Add-ons > Autodesk Maya File Import-Export "
            "and set the correct mayapy.exe path." % mayapy_path
        )

    input_path = os.path.abspath(input_path)
    output_path = os.path.abspath(output_path)
    if not os.path.isfile(input_path):
        raise FileNotFoundError("Bridge input file does not exist: %s" % input_path)

    with tempfile.TemporaryDirectory(prefix="blender_maya_bridge_") as temp_root:
        script_path = os.path.join(temp_root, "maya_bridge_job.py")
        with open(script_path, "w", encoding="utf-8") as handle:
            handle.write(_maya_script_source())

        command = [
            mayapy_path,
            script_path,
            mode,
            input_path,
            output_path,
            json.dumps(options or {}),
        ]
        env = _maya_environment(mayapy_path, temp_root)
        try:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                timeout=_get_timeout(),
                env=env,
                check=False,
                creationflags=(getattr(subprocess, "CREATE_NO_WINDOW", 0)
                               if os.name == "nt" else 0),
            )
        except subprocess.TimeoutExpired as exc:
            output = exc.stdout or ""
            if isinstance(output, bytes):
                output = output.decode("utf-8", "replace")
            raise RuntimeError(
                "Maya conversion exceeded the %d-second timeout.\n%s" %
                (_get_timeout(), output[-5000:])
            ) from exc

        if result.returncode != 0:
            detail = (result.stdout or "")[-7000:]
            raise RuntimeError(
                "Maya conversion failed (exit code %d).\n\n%s" %
                (result.returncode, detail or "Maya returned no diagnostic output.")
            )

    if not os.path.isfile(output_path):
        raise RuntimeError("Maya did not create the expected output file: %s" % output_path)


def _show_error(operator, title, message):
    message = str(message)
    print("[Maya File Bridge] %s\n%s" % (title, message))
    operator.report({'ERROR'}, title + ". See the system console for details.")


