# Blender scene selection helpers
# -----------------------------------------------------------------------------


def _visible_view_layer_objects(context):
    try:
        return list(context.view_layer.objects)
    except Exception:
        return list(context.scene.objects)


def _export_candidate_objects(context, settings):
    """Return Blender objects permitted by the selected export categories."""
    candidates = _visible_view_layer_objects(context)
    if settings.get("selected_only", False):
        selected = set(context.selected_objects)
        candidates = [obj for obj in candidates if obj in selected]

    include_types = set()
    if settings.get("models", True):
        include_types.add("MESH")
    if settings.get("lights", True):
        include_types.add("LIGHT")
    if settings.get("cameras", True):
        include_types.add("CAMERA")
    if settings.get("splines", True):
        include_types.update({"CURVE", "SURFACE", "FONT", "META"})
    if settings.get("models", True) or settings.get("animations", True):
        include_types.add("ARMATURE")
    if any((settings.get("models"), settings.get("lights"),
            settings.get("cameras"), settings.get("splines"),
            settings.get("animations"))):
        # Empties are useful as hierarchy/transform parents in an FBX scene.
        include_types.add("EMPTY")

    return [obj for obj in candidates if obj.type in include_types]


def _export_object_types(settings):
    types = set()
    if settings.get("models", True):
        types.update({"MESH", "ARMATURE"})
    if settings.get("animations", True):
        types.add("ARMATURE")
    if settings.get("lights", True):
        types.add("LIGHT")
    if settings.get("cameras", True):
        types.add("CAMERA")
    if settings.get("splines", True):
        # Blender's FBX writer groups curve-like datablocks under OTHER.
        types.add("OTHER")
    if types:
        types.add("EMPTY")
    return types


def _export_blender_scene_to_fbx(context, filepath, settings):
    _ensure_fbx_operators()
    objects = _export_candidate_objects(context, settings)
    if not objects:
        raise RuntimeError(
            "No objects match the export filters. Enable at least one category "
            "or disable 'Selected Objects Only'."
        )

    original_active = context.view_layer.objects.active
    original_selected = list(context.selected_objects)
    original_mode = context.mode
    mode_changed = False

    try:
        if context.object and context.object.mode != 'OBJECT':
            bpy.ops.object.mode_set(mode='OBJECT')
            mode_changed = True

        bpy.ops.object.select_all(action='DESELECT')
        for obj in objects:
            try:
                obj.select_set(True)
            except (RuntimeError, ReferenceError):
                pass
        context.view_layer.objects.active = objects[0]

        kwargs = {
            "filepath": filepath,
            "check_existing": False,
            "use_selection": True,
            "use_visible": False,
            "object_types": _export_object_types(settings),
            "use_mesh_modifiers": True,
            "use_mesh_modifiers_render": True,
            "mesh_smooth_type": "FACE",
            "add_leaf_bones": False,
            "bake_anim": bool(settings.get("animations", True)),
            "bake_anim_use_nla_strips": True,
            "bake_anim_use_all_actions": False,
            "bake_anim_step": 1.0,
            "path_mode": "AUTO",
            "axis_forward": "-Z",
            "axis_up": "Y",
        }
        result = _call_operator(bpy.ops.export_scene.fbx, **kwargs)
        if 'FINISHED' not in result:
            raise RuntimeError("Blender's FBX exporter did not finish successfully.")
        if not os.path.isfile(filepath):
            raise RuntimeError("Blender's FBX exporter did not create the temporary FBX file.")
    finally:
        try:
            bpy.ops.object.select_all(action='DESELECT')
        except Exception:
            pass
        for obj in original_selected:
            try:
                obj.select_set(True)
            except (RuntimeError, ReferenceError):
                pass
        try:
            context.view_layer.objects.active = original_active
        except (RuntimeError, ReferenceError):
            pass
        if mode_changed and original_active and original_active.name in bpy.data.objects:
            try:
                if original_mode == 'POSE':
                    bpy.ops.object.mode_set(mode='POSE')
                elif original_mode == 'EDIT_ARMATURE' and original_active.type == 'ARMATURE':
                    bpy.ops.object.mode_set(mode='EDIT')
                elif original_mode.startswith('EDIT_'):
                    bpy.ops.object.mode_set(mode='EDIT')
            except Exception:
                pass


def _remove_imported_object(obj):
    try:
        bpy.data.objects.remove(obj, do_unlink=True)
    except (ReferenceError, RuntimeError):
        pass


def _clear_animation_from_id(datablock):
    if datablock is None:
        return
    try:
        if getattr(datablock, "animation_data", None) is not None:
            datablock.animation_data_clear()
    except (AttributeError, ReferenceError, RuntimeError):
        pass


def _filter_imported_objects(imported_objects, options):
    """Apply import checkboxes to only the objects created by this import."""
    imported = [obj for obj in imported_objects if obj and obj.name in bpy.data.objects]
    imported_set = set(imported)
    remove_types = set()

    if not options.get("models", True):
        remove_types.add("MESH")
    if not options.get("lights", True):
        remove_types.add("LIGHT")
    if not options.get("cameras", True):
        remove_types.add("CAMERA")
    if not options.get("splines", True):
        remove_types.update({"CURVE", "SURFACE", "FONT", "META"})
    if not options.get("armatures", True):
        remove_types.add("ARMATURE")

    to_remove = {obj for obj in imported if obj.type in remove_types}

    # Avoid dangling Armature modifiers when the user excludes the armature.
    for obj in imported:
        if obj.type != 'MESH':
            continue
        for modifier in list(obj.modifiers):
            if modifier.type == 'ARMATURE' and modifier.object in to_remove:
                obj.modifiers.remove(modifier)

    for obj in list(to_remove):
        _remove_imported_object(obj)

    remaining = [obj for obj in imported if obj not in to_remove and obj.name in bpy.data.objects]

    if not options.get("animations", True):
        for obj in remaining:
            _clear_animation_from_id(obj)
            _clear_animation_from_id(getattr(obj, "data", None))
            if obj.type == 'MESH':
                _clear_animation_from_id(getattr(obj.data, "shape_keys", None))

    if not options.get("materials", True):
        for obj in remaining:
            materials = getattr(getattr(obj, "data", None), "materials", None)
            if materials is not None:
                try:
                    materials.clear()
                except (AttributeError, RuntimeError):
                    pass

    return remaining


def _apply_import_rotation(imported_objects, context):
    """Rotate the imported hierarchy 180 degrees around world X via a root empty.

    A parent wrapper is used instead of destructively applying rotation, so
    imported animation channels and armature rest data are left untouched.
    """
    imported = {obj for obj in imported_objects if obj and obj.name in bpy.data.objects}
    if not imported:
        return None

    roots = [obj for obj in imported if obj.parent not in imported]
    if not roots:
        return None

    wrapper = bpy.data.objects.new("Maya_Import_Rotation_X180", None)
    wrapper.empty_display_type = 'PLAIN_AXES'
    wrapper.empty_display_size = 0.5
    wrapper.rotation_euler[0] = 3.141592653589793

    try:
        context.collection.objects.link(wrapper)
    except Exception:
        context.scene.collection.objects.link(wrapper)

    # Parent the hierarchy roots without applying a parent inverse. The wrapper
    # rotation therefore transforms their world-space motion as one hierarchy.
    for obj in roots:
        obj.parent = wrapper
        obj.matrix_parent_inverse.identity()

    return wrapper


def _select_imported_objects(context, imported_objects, wrapper=None):
    targets = list(imported_objects)
    if wrapper is not None:
        targets.append(wrapper)
    try:
        bpy.ops.object.select_all(action='DESELECT')
    except Exception:
        pass
    valid = []
    for obj in targets:
        if obj and obj.name in bpy.data.objects:
            try:
                obj.select_set(True)
                valid.append(obj)
            except (RuntimeError, ReferenceError):
                pass
    if valid:
        try:
            context.view_layer.objects.active = wrapper if wrapper in valid else valid[0]
        except Exception:
            pass


def _import_fbx_into_blender(context, filepath, options):
    _ensure_fbx_operators()
    before = set(bpy.data.objects)
    kwargs = {
        "filepath": filepath,
        "use_anim": bool(options.get("animations", True)),
        "use_custom_normals": True,
        "use_image_search": True,
        "ignore_leaf_bones": False,
        "automatic_bone_orientation": False,
        "axis_forward": "-Z",
        "axis_up": "Y",
    }
    result = _call_operator(bpy.ops.import_scene.fbx, **kwargs)
    if 'FINISHED' not in result:
        raise RuntimeError("Blender's FBX importer did not finish successfully.")

    created = [obj for obj in bpy.data.objects if obj not in before]
    if not created:
        raise RuntimeError("FBX import finished, but no new Blender objects were created.")

    remaining = _filter_imported_objects(created, options)
    if not remaining:
        raise RuntimeError(
            "The FBX was imported, but all imported objects were removed by your import filters."
        )

    wrapper = _apply_import_rotation(remaining, context) if options.get("apply_rotation", False) else None
    _select_imported_objects(context, remaining, wrapper)
    return remaining, wrapper


