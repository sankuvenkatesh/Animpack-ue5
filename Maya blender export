                "splines": self.import_splines,
                "animations": self.import_animations,
                "materials": self.import_materials,
                "armatures": self.import_armatures,
                "apply_rotation": self.apply_rotation,
            }

            with tempfile.TemporaryDirectory(prefix="maya_to_blender_") as temp_dir:
                fbx_path = os.path.join(temp_dir, "maya_scene.fbx")
                _run_maya_bridge(
                    mayapy,
                    "maya_to_fbx",
                    source_path,
                    fbx_path,
                    options={"animations": self.import_animations},
                )
                imported, wrapper = _import_fbx_into_blender(context, fbx_path, settings)

            self.report({'INFO'}, "Imported %d object(s) from %s" % (len(imported), os.path.basename(source_path)))
            return {'FINISHED'}

        except Exception as exc:
            _show_error(self, "Maya import failed", exc)
            traceback.print_exc()
            return {'CANCELLED'}


