# -----------------------------------------------------------------------------


class EXPORT_SCENE_OT_maya(bpy.types.Operator, ExportHelper):
    bl_idname = "export_scene.maya"
    bl_label = "Export Maya Scene"
    bl_description = "Convert the Blender scene to Autodesk Maya .ma or .mb using Maya standalone"
    bl_options = {'REGISTER'}

    filename_ext = ".ma"
    check_extension = False  # allow both .ma and .mb instead of forcing .ma
    filter_glob: StringProperty(default="*.ma;*.mb", options={'HIDDEN'})

    export_models: BoolProperty(name="Models", description="Export mesh models and their skeletons", default=True)
    export_lights: BoolProperty(name="Lights", default=True)
    export_cameras: BoolProperty(name="Cameras", default=True)
    export_splines: BoolProperty(name="Splines / Curves", default=True)
    export_animations: BoolProperty(name="Animations", description="Bake Blender animation into the FBX bridge file", default=True)
    export_selected_only: BoolProperty(name="Selected Objects Only", description="Export only currently selected objects", default=False)

    def draw(self, context):
        layout = self.layout
        layout.label(text="Export Categories")
        col = layout.column(align=True)
        col.prop(self, "export_models")
        col.prop(self, "export_lights")
        col.prop(self, "export_cameras")
        col.prop(self, "export_splines")
        col.prop(self, "export_animations")
        layout.separator()
        layout.prop(self, "export_selected_only")
        layout.label(text="FBX is used internally for Maya conversion.", icon='INFO')

    def execute(self, context):
        try:
            target_path = _normalise_maya_path(self.filepath)
            os.makedirs(os.path.dirname(target_path) or ".", exist_ok=True)
            mayapy = _get_mayapy_path()
            settings = {
                "models": self.export_models,
                "lights": self.export_lights,
                "cameras": self.export_cameras,
                "splines": self.export_splines,
                "animations": self.export_animations,
                "selected_only": self.export_selected_only,
            }

            with tempfile.TemporaryDirectory(prefix="blender_to_maya_") as temp_dir:
                fbx_path = os.path.join(temp_dir, "blender_scene.fbx")
                _export_blender_scene_to_fbx(context, fbx_path, settings)
                _run_maya_bridge(
                    mayapy,
                    "fbx_to_maya",
                    fbx_path,
                    target_path,
                    options=settings,
                )

            self.report({'INFO'}, "Maya file exported: %s" % os.path.basename(target_path))
            return {'FINISHED'}

        except Exception as exc:
            _show_error(self, "Maya export failed", exc)
            traceback.print_exc()
            return {'CANCELLED'}


