    def poll_drop(cls, context):
        return bool(context and context.area and context.area.type in {'VIEW_3D', 'OUTLINER'})


# -----------------------------------------------------------------------------
# File menu entries and registration
# -----------------------------------------------------------------------------


def menu_func_import(self, context):
    self.layout.operator(IMPORT_SCENE_OT_maya.bl_idname, text="Maya (.ma / .mb)", icon='FILE')


def menu_func_export(self, context):
    self.layout.operator(EXPORT_SCENE_OT_maya.bl_idname, text="Maya (.ma / .mb)", icon='FILE')


CLASSES = (
    MAYAIO_AddonPreferences,
    IMPORT_SCENE_OT_maya,
    EXPORT_SCENE_OT_maya,
    MAYA_FH_files,
)


def register():
    registered = []
    try:
        for cls in CLASSES:
            bpy.utils.register_class(cls)
            registered.append(cls)
        bpy.types.TOPBAR_MT_file_import.append(menu_func_import)
        bpy.types.TOPBAR_MT_file_export.append(menu_func_export)
    except Exception:
        try:
            bpy.types.TOPBAR_MT_file_import.remove(menu_func_import)
        except Exception:
            pass
        try:
            bpy.types.TOPBAR_MT_file_export.remove(menu_func_export)
        except Exception:
            pass
        for cls in reversed(registered):
            try:
                bpy.utils.unregister_class(cls)
            except Exception:
                pass
        raise


def unregister():
    try:
        bpy.types.TOPBAR_MT_file_import.remove(menu_func_import)
    except Exception:
        pass
    try:
        bpy.types.TOPBAR_MT_file_export.remove(menu_func_export)
    except Exception:
        pass
    for cls in reversed(CLASSES):
        try:
            bpy.utils.unregister_class(cls)
        except Exception:
            pass


if __name__ == "__main__":
    register()

