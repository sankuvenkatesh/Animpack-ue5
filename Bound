#===================================
# HOW IT BEHAVES
#
#  Add-on ACTIVE
#    open a file : every object -> Bounds, every 3D viewport -> Wireframe
#    enable it   : the same is applied to the file that is open right now
#                  (startup scene, enabling mid-session, Reload Scripts)
#    save a file : the .blend is written with Wireframe viewports and NO Bounds
#                  objects (see below); your live session is then put straight back
#                  to how it was (Bounds + Wireframe)
#    disable it  : Bounds objects go back to their normal display type, so a plain
#                  Save afterwards is still portable. Viewports are left as they are.
#
#  Add-on NOT installed / switched off
#    open a file : nothing runs, so you get exactly what was saved -> Wireframe
#                  viewports, objects drawn as wireframe, never as Bounds boxes.
#
#  Why the saved file cannot contain Bounds: a Bounds object is drawn as a box in
#  EVERY viewport mode, and without the add-on no code exists to change it back.
#  So at save time each Bounds object is written with the display type it had
#  before the add-on switched it to Bounds (Wire if that is unknown).
#
#  Scope: the open / enable / save / disable handling covers EVERY object in the file
#  (all scenes; nested, hidden and excluded collections included — a collection has
#  no display type of its own). The panel and menu buttons act on the CURRENT SCENE.
#
#  Not covered: Blender's auto-save and quit.blend are written by Blender directly,
#  without calling the save handlers, so a file recovered from them (and any file
#  saved by an older version of this add-on) can still contain Bounds objects. Open
#  it with the add-on active and save again to make it portable.
#===================================

import bpy
from bpy.types import Operator, Panel, Menu
from bpy.props import EnumProperty
from bpy.app.handlers import persistent

# Live-session state captured right before a save so it can be put back afterwards:
#   {"shading": {space_pointer: shading_type}, "display": {object_pointer: display_type}}
# (pointers are fine here: nothing can reallocate data between save_pre and save_post)
_snapshot = None

# Display type each object had before it was switched to Bounds, so the saved file can
# get it back.   {_obj_key(obj): display_type}
# Rebuilt whenever a file is opened. An object that is missing here is written as Wire.
_orig_display = {}


#===================================
# --- Core helpers — iterate bpy.data.screens (NOT window_manager) ---
#===================================
def _iter_all_view3d_spaces():
    """Every 3D Viewport space across every screen, visible or not."""
    for screen in bpy.data.screens:
        for area in screen.areas:
            if area.type != 'VIEW_3D':
                continue
            for space in area.spaces:
                if space.type == 'VIEW_3D':
                    yield space


def _set_all_viewport_shading(mode):
    count = 0
    for space in _iter_all_view3d_spaces():
        try:
            if space.shading.type != mode:
                space.shading.type = mode
            count += 1
        except Exception:
            pass
    return count


def _obj_key(obj):
    """Key that still identifies an object after it is renamed or after undo/redo.
    session_uid survives both (a name does not survive a rename, a pointer may change
    after undo). Falls back to the name if session_uid is unavailable."""
    uid = getattr(obj, "session_uid", 0)
    return uid if uid else obj.name_full


def _set_object_display(obj, mode):
    """Set one object's display type. When it is switched TO Bounds, remember the
    type it had so the saved file can get it back."""
    current = obj.display_type
    if current == mode:
        return
    if mode == 'BOUNDS':
        _orig_display[_obj_key(obj)] = current
    obj.display_type = mode


def _set_all_objects_display(mode):
    """Every object in the file: all scenes, all collections (nested, hidden and
    excluded ones included) and objects that are not linked to any scene."""
    for obj in bpy.data.objects:
        try:
            _set_object_display(obj, mode)
        except Exception:
            pass


def _revert_bounds_objects():
    """Bounds -> the display type the object had before (Wire if unknown).
    Objects in any other display type are left alone."""
    for obj in bpy.data.objects:
        try:
            if obj.display_type == 'BOUNDS':
                obj.display_type = _orig_display.get(_obj_key(obj), 'WIRE')
        except Exception:
            pass


def _apply_working_state():
    """Bounds + Wireframe — what you see in Blender while the add-on is active."""
    _set_all_objects_display('BOUNDS')
    return _set_all_viewport_shading('WIREFRAME')


def _apply_file_state():
    """What gets written into the .blend: Wireframe viewports and no Bounds objects."""
    _revert_bounds_objects()
    return _set_all_viewport_shading('WIREFRAME')


#===================================
# --- Snapshot / restore of the live session around a save ---
#===================================
def _take_snapshot():
    snap = {"shading": {}, "display": {}}
    for space in _iter_all_view3d_spaces():
        try:
            snap["shading"][space.as_pointer()] = space.shading.type
        except Exception:
            pass
    for obj in bpy.data.objects:
        try:
            snap["display"][obj.as_pointer()] = obj.display_type
        except Exception:
            pass
    return snap


def _restore_snapshot():
    """Put the live session back exactly as it was before the save wrote the file
    state: viewport shading AND every object's display type."""
    global _snapshot
    snap, _snapshot = _snapshot, None
    if not snap:
        return

    for space in _iter_all_view3d_spaces():
        wanted = snap["shading"].get(space.as_pointer())
        if wanted is None:
            continue
        try:
            if space.shading.type != wanted:
                space.shading.type = wanted
        except Exception:
            pass

    for obj in bpy.data.objects:
        wanted = snap["display"].get(obj.as_pointer())
        if wanted is None:
            continue
        try:
            if obj.display_type != wanted:
                obj.display_type = wanted
        except Exception:
            pass


#===================================
# --- Timer entry points ---
# A timer repeats for as long as its function returns a number. These two wrappers
# ALWAYS return None (= run once), so the functions they call stay free to return
# values for other callers.
#===================================
def _restore_snapshot_once():
    _restore_snapshot()
    return None


def _apply_working_state_once():
    _apply_working_state()
    return None


#===================================
# --- Manual operator: apply Bounds + Wireframe right now ---
#===================================
class OBJECTDISPLAY_OT_apply_fallback(Operator):
    """Immediately set all objects to Bounds and all viewports to Wireframe.
This is the same state the add-on applies whenever a file is opened"""
    bl_idname = "objectsdisplay.apply_fallback"
    bl_label = "Apply Bounds + Wireframe"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        n = _apply_working_state()
        self.report({'INFO'}, f"Bounds + Wireframe applied to {n} viewport(s)")
        return {'FINISHED'}


#===================================
# --- Save / Load Handlers (@persistent so they survive file loads) ---
#===================================
@persistent
def _save_pre_handler(*_args):
    global _snapshot

    # If an earlier save's restore is still pending, its snapshot is the true
    # session state — keep it instead of snapshotting the already-changed state.
    if _snapshot is None:
        _snapshot = _take_snapshot()

    # Safety net: if the save fails, save_post never fires. Timers only run once
    # Blender's main loop is free again (i.e. after the save), so this always restores.
    if not bpy.app.timers.is_registered(_restore_snapshot_once):
        bpy.app.timers.register(_restore_snapshot_once, first_interval=0.1)

    # Write the portable state into the file about to be saved:
    # Wireframe viewports, no Bounds objects.
    _apply_file_state()


@persistent
def _save_post_handler(*_args):
    # The file is fully written now — put the live session back right away
    _restore_snapshot()


@persistent
def _load_post_handler(*_args):
    global _snapshot
    _snapshot = None          # a snapshot from the previous file is meaningless now
    _orig_display.clear()     # so are the remembered display types
    # Viewports aren't ready the instant load_post fires; defer.
    if not bpy.app.timers.is_registered(_apply_working_state_once):
        bpy.app.timers.register(_apply_working_state_once, first_interval=0.3)


#===================================
# --- Main Operator ---
# Scope note: ALL / UNSELECTED / COLLECTION work on the CURRENT SCENE (selection and
# the active collection are per scene / view layer anyway). Only the save / open /
# enable / disable handling above covers every object in the file.
#===================================
class OBJECTSDISPLAY_OT_objects_viewport_display(Operator):
    """Set the viewport display mode of the objects chosen by the scope"""
    bl_idname = "objectsdisplay.objects_viewport_display"
    bl_label = "Objects Viewport Display"
    bl_options = {'REGISTER', 'UNDO'}

    select_method: EnumProperty(
        name="Select Method",
        items=[
            ('ALL',        "All",        "All objects in the current scene", 0),
            ('SELECTED',   "Selected",   "Selected objects",                 1),
            ('UNSELECTED', "Unselected", "Unselected objects in the current scene", 2),
            ('COLLECTION', "Collection", "Objects in the active collection", 3),
        ],
        default='SELECTED',
    )
    display_mode: EnumProperty(
        name="Display Mode",
        items=[
            ('BOUNDS',   "Bounds",   "Bounds mode",   0),
            ('WIRE',     "Wire",     "Wire mode",     1),
            ('SOLID',    "Solid",    "Solid mode",    2),
            ('TEXTURED', "Textured", "Textured mode", 3),
        ],
        default='TEXTURED',
    )

    def _iter_selected(self, context):
        if not context.selected_objects:
            self.report({'INFO'}, "No objects are selected")
            return []
        return list(context.selected_objects)

    def _iter_unselected(self, context):
        if not context.selected_objects:
            self.report({'INFO'}, "Nothing selected — operating on all objects")
            return list(context.scene.objects)
        sel = set(context.selected_objects)
        return [o for o in context.scene.objects if o not in sel]

    def _iter_collection(self, context):
        active = context.view_layer.active_layer_collection
        if active == context.view_layer.layer_collection:
            self.report({'WARNING'}, "Select a specific collection, not the scene root")
            return []
        coll = active.collection
        if not coll.all_objects:
            self.report({'INFO'}, "Collection is empty")
            return []
        return list(coll.all_objects)

    def _rename_collection(self, context, mode):
        coll = context.view_layer.active_layer_collection.collection
        if (coll == context.scene.collection or
                coll.library is not None or
                coll.override_library is not None):
            self.report({'INFO'}, "Collection name is read-only; skipping rename")
            return
        for suffix in ("_WIRE", "_BOUNDS", "_SOLID", "_TEXTURED",
                       " WIRE", " BOUNDS", " SOLID", " TEXTURED",
                       "-WIRE", "-BOUNDS", "-SOLID", "-TEXTURED"):
            if coll.name.endswith(suffix):
                coll.name = coll.name[: -len(suffix)]
                break
        # Only the two special modes are tagged. Solid / Textured are the normal
        # state, so they carry no tag (any old tag was stripped above).
        if mode in ('WIRE', 'BOUNDS'):
            coll.name += "_" + mode

    def execute(self, context):
        objects = []
        match self.select_method:
            case 'ALL':        objects = list(context.scene.objects)
            case 'SELECTED':   objects = self._iter_selected(context)
            case 'UNSELECTED': objects = self._iter_unselected(context)
            case 'COLLECTION': objects = self._iter_collection(context)

        changed = 0
        for obj in objects:
            try:
                _set_object_display(obj, self.display_mode)
                changed += 1
            except Exception:
                pass

        # Only tag the collection name when something was actually changed
        if self.select_method == 'COLLECTION' and changed:
            self._rename_collection(context, self.display_mode)
        return {'FINISHED'}

    @classmethod
    def description(cls, context, properties):
        scope = {
            'ALL':        "all objects in the current scene",
            'SELECTED':   "the selected objects",
            'UNSELECTED': "the unselected objects in the current scene",
            'COLLECTION': "the objects in the active collection",
        }.get(properties.select_method, "")
        mode = {
            'BOUNDS': "Bounds", 'WIRE': "Wire",
            'SOLID': "Solid", 'TEXTURED': "Textured",
        }.get(properties.display_mode, "")
        return f"Set the viewport display mode of {scope} to {mode}"


#===================================
# --- Sidebar Panel ---
#===================================
class OBJECTDISPLAY_PT_objectdisplay_panel(Panel):
    bl_label = "Display Modes"
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "View"

    def draw(self, context):
        layout = self.layout

        box = layout.box()
        box.label(text="Viewport Visibility:", icon='RESTRICT_VIEW_OFF')
        for scope in ('Collection', 'All', 'Selected', 'Unselected'):
            row = box.row(align=True)
            row.label(text=scope + ":")
            for mode, icon in (
                ('BOUNDS',   'PIVOT_BOUNDBOX'),
                ('WIRE',     'MOD_WIREFRAME'),
                ('SOLID',    'SHADING_SOLID'),
                ('TEXTURED', 'TEXTURE'),
            ):
                op = row.operator("objectsdisplay.objects_viewport_display",
                                  text="", icon=icon)
                op.select_method = scope.upper()
                op.display_mode  = mode

        box2 = layout.box()
        box2.label(text="Save Behaviour:", icon='FILE_TICK')
        col = box2.column(align=True)
        col.label(text="Saved file: Wireframe, no Bounds")
        col.label(text="Opened here: Bounds + Wireframe")
        box2.operator("objectsdisplay.apply_fallback",
                      icon='SHADING_WIRE', text="Apply Bounds + Wireframe")


#===================================
# --- Menus ---
#===================================
def _draw_viewport_menu(layout, scope_label, scope_id):
    for mode, icon, text in (
        ('BOUNDS',   'PIVOT_BOUNDBOX',  f"Display {scope_label} as bounds"),
        ('WIRE',     'MOD_WIREFRAME',   f"Display {scope_label} as wire"),
        ('SOLID',    'SHADING_SOLID',   f"Display {scope_label} as solid"),
        ('TEXTURED', 'TEXTURE',         f"Display {scope_label} as textured"),
    ):
        op = layout.operator("objectsdisplay.objects_viewport_display",
                             text=text, icon=icon)
        op.select_method = scope_id
        op.display_mode  = mode


class OBJECTDISPLAY_MT_viewport_object_submenu(Menu):
    bl_label = "Object Display Mode"
    bl_idname = "OBJECTDISPLAY_MT_viewport_object_submenu"
    def draw(self, context):
        _draw_viewport_menu(self.layout, "selected", 'SELECTED')


class OBJECTDISPLAY_MT_outliner_object_submenu(Menu):
    bl_label = "Object Display Mode"
    bl_idname = "OBJECTDISPLAY_MT_outliner_object_submenu"
    def draw(self, context):
        _draw_viewport_menu(self.layout, "selected", 'SELECTED')


class OBJECTDISPLAY_MT_outliner_collection_submenu(Menu):
    bl_label = "Object Display Mode"
    bl_idname = "OBJECTDISPLAY_MT_outliner_collection_submenu"
    def draw(self, context):
        _draw_viewport_menu(self.layout, "collection", 'COLLECTION')


#===================================
# --- Registration ---
#===================================
classes = (
    OBJECTDISPLAY_PT_objectdisplay_panel,
    OBJECTSDISPLAY_OT_objects_viewport_display,
    OBJECTDISPLAY_OT_apply_fallback,
    OBJECTDISPLAY_MT_viewport_object_submenu,
    OBJECTDISPLAY_MT_outliner_object_submenu,
    OBJECTDISPLAY_MT_outliner_collection_submenu,
)


def _menu_outliner_object(self, context):
    self.layout.separator()
    self.layout.menu("OBJECTDISPLAY_MT_outliner_object_submenu")


def _menu_outliner_collection(self, context):
    self.layout.separator()
    self.layout.menu("OBJECTDISPLAY_MT_outliner_collection_submenu")


def _menu_viewport_object(self, context):
    if context.mode != 'OBJECT':
        return
    self.layout.separator()
    self.layout.menu("OBJECTDISPLAY_MT_viewport_object_submenu")


def register():
    for cls in classes:
        bpy.utils.register_class(cls)

    bpy.types.OUTLINER_MT_context_menu.append(_menu_outliner_object)
    bpy.types.OUTLINER_MT_object.append(_menu_outliner_object)
    bpy.types.OUTLINER_MT_collection.append(_menu_outliner_collection)
    bpy.types.VIEW3D_MT_object_context_menu.append(_menu_viewport_object)

    bpy.app.handlers.save_pre.append(_save_pre_handler)
    bpy.app.handlers.save_post.append(_save_post_handler)
    bpy.app.handlers.load_post.append(_load_post_handler)

    # The handlers above only see files opened from now on. Also cover the file that
    # is open right now: Blender's startup scene (load_post may have fired before the
    # add-on existed), enabling the add-on mid-session, Reload Scripts.
    if not bpy.app.timers.is_registered(_apply_working_state_once):
        bpy.app.timers.register(_apply_working_state_once, first_interval=0.3)


def unregister():
    # Drop pending timers first, then put the session back if a save left a snapshot
    for fn in (_restore_snapshot_once, _apply_working_state_once):
        try:
            if bpy.app.timers.is_registered(fn):
                bpy.app.timers.unregister(fn)
        except Exception:
            pass
    _restore_snapshot()

    # With the add-on gone nothing converts Bounds objects at save time any more, so
    # do it now: a plain File > Save after disabling must not write Bounds into the
    # file. (Viewports are left exactly as they are.)
    try:
        _revert_bounds_objects()
    except Exception:
        pass
    _orig_display.clear()

    for handler, collection in (
        (_save_pre_handler,  bpy.app.handlers.save_pre),
        (_save_post_handler, bpy.app.handlers.save_post),
        (_load_post_handler, bpy.app.handlers.load_post),
    ):
        try:
            collection.remove(handler)
        except (ValueError, AttributeError):
            pass

    for hook, owner in (
        (_menu_outliner_object,     bpy.types.OUTLINER_MT_context_menu),
        (_menu_outliner_object,     bpy.types.OUTLINER_MT_object),
        (_menu_outliner_collection, bpy.types.OUTLINER_MT_collection),
        (_menu_viewport_object,     bpy.types.VIEW3D_MT_object_context_menu),
    ):
        try:
            owner.remove(hook)
        except (ValueError, AttributeError):
            pass

    for cls in reversed(classes):
        bpy.utils.unregister_class(cls)


if __name__ == "__main__":
    register()
