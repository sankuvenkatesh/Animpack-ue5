bl_info = {
    "name": "Display Modes — Selected / Unselected / All",
    "author": "ChatGPT + User",
    "version": (5, 0, 0),
    "blender": (4, 2, 0),
    "location": "3D Viewport > Sidebar > View; Outliner & Viewport context menus",
    "description": (
        "Set object display modes for Selected / Unselected / All / Collection. "
        "Files are saved and opened as Wire objects in Wireframe viewports, on any "
        "machine, with or without this add-on."
    ),
    "category": "3D View",
