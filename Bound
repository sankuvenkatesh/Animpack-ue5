import bpy
from bpy.types import Operator, Panel, Menu
from bpy.props import EnumProperty
from bpy.app.handlers import persistent

#===================================
# HOW IT WORKS
#
#  SAVE  Every object -> Wire and every 3D viewport -> Wireframe is written into
#        the file, then your session is put straight back. The file itself holds
#        Wire + Wireframe, so it opens as wireframe on ANY machine, with or without
#        this add-on.
#  OPEN  With the add-on on, every object -> OPEN_AS and every viewport -> Wireframe.
#
#  Bounds is never written to a file: a Bounds object is drawn as a box in every
#  viewport mode, and a machine without the add-on has no code to change it back.
#
#  Files saved by older versions may still hold Bounds objects: open them once with
#  the add-on on and save again. Keep only ONE copy of the add-on enabled — an older
#  copy running as well would still write Bounds on save.
#===================================

# Display type given to every object when a file is opened on a machine that has the
# add-on: 'WIRE' (default, same as the saved file) or 'BOUNDS' (boxes while you work).
# Saved files are always Wire, whatever this is set to.
OPEN_AS = 'WIRE'


#===================================
# --- Tables (one source for the enums, buttons, menus and tooltips) ---
#===================================
_OP = "objectsdisplay.objects_viewport_display"

# (identifier, label, icon)
_MODES = (
    ('BOUNDS',   "Bounds",   'PIVOT_BOUNDBOX'),
    ('WIRE',     "Wire",     'MOD_WIREFRAME'),
    ('SOLID',    "Solid",    'SHADING_SOLID'),
    ('TEXTURED', "Textured", 'TEXTURE'),
)
# (identifier, label, tooltip wording), in panel order.
# All / Unselected / Collection act on the CURRENT SCENE.
_SCOPES = (
    ('COLLECTION', "Collection", "the objects in the active collection"),
    ('ALL',        "All",        "all objects in this scene"),
    ('SELECTED',   "Selected",   "the selected objects"),
    ('UNSELECTED', "Unselected", "the unselected objects in this scene"),
)
_MODE_LABEL = {mode: label for mode, label, _ in _MODES}
_SCOPE_TEXT = {scope: text for scope, _, text in _SCOPES}
# Collection-name tags the buttons add / remove: "_WIRE", " BOUNDS", "-SOLID", ...
_TAGS = tuple(sep + mode for sep in "_ -" for mode, _, _ in _MODES)


#===================================
# --- Core: set everything, and put back what a save changed ---
#===================================
# What the last save changed, so it can be put back: (object, old display type) and
# (3D viewport space, old shading type). Empty whenever no save is in progress.
_prev_objs = []
_prev_views = []


def _viewports():
    """Every 3D viewport space in every screen, visible or not."""
    for screen in bpy.data.screens:
        for area in screen.areas:
            if area.type == 'VIEW_3D':
                for space in area.spaces:
                    if space.type == 'VIEW_3D':
                        yield space


def _set_all(display, shading, remember=False):
    """Every object -> `display`, every 3D viewport -> `shading`: all scenes, all
    collections, hidden or not. With remember=True whatever actually changed is
    recorded so _restore() can put it back."""
    for obj in bpy.data.objects:
        try:
            old = obj.display_type
            if old != display:
                obj.display_type = display
                if remember:
                    _prev_objs.append((obj, old))
        except Exception:               # linked / read-only data
            pass
    for space in _viewports():
        try:
            old = space.shading.type
            if old != shading:
                space.shading.type = shading
                if remember:
                    _prev_views.append((space, old))
        except Exception:
            pass


def _restore():
    """Put back what the last save changed. Called by save_post and, as a safety net
    for a save that fails (save_post never fires then), by a timer — hence the
    explicit `return None` (= run once)."""
    while _prev_objs:
        obj, old = _prev_objs.pop()
        try:
            obj.display_type = old
        except Exception:               # object no longer exists
            pass
    while _prev_views:
        space, old = _prev_views.pop()
        try:
            space.shading.type = old
        except Exception:
            pass
    return None


#===================================
# --- Save / load handlers (@persistent so they survive file loads) ---
#===================================
@persistent
def _on_save_pre(*_):
    # Written into the file: Wire objects, Wireframe viewports. Items already in that
    # state are skipped, so if an earlier restore is still pending, its record (the
    # true session state) is kept untouched.
    _set_all('WIRE', 'WIREFRAME', remember=True)
    if not bpy.app.timers.is_registered(_restore):
        bpy.app.timers.register(_restore, first_interval=0.1)


@persistent
def _on_save_post(*_):
    _restore()
    if bpy.app.timers.is_registered(_restore):
        bpy.app.timers.unregister(_restore)


def _apply_open_state():
    """Timer callback (returns None = run once)."""
    _set_all(OPEN_AS if OPEN_AS in _MODE_LABEL else 'WIRE', 'WIREFRAME')
    return None


@persistent
def _on_load_post(*_):
    _prev_objs.clear()          # records from the previous file are meaningless now
    _prev_views.clear()
    # Viewports aren't ready the instant load_post fires; defer.
    if not bpy.app.timers.is_registered(_apply_open_state):
        bpy.app.timers.register(_apply_open_state, first_interval=0.3)


#===================================
# --- Operators ---
#===================================
class OBJECTDISPLAY_OT_apply_wireframe(Operator):
    """Set every object in the file (all scenes) to Wire and every 3D viewport to Wireframe — the state files are saved in"""
    bl_idname = "objectsdisplay.apply_wireframe"
    bl_label = "Apply Wireframe Now"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        _set_all('WIRE', 'WIREFRAME')
        self.report({'INFO'}, "All objects set to Wire, all viewports to Wireframe")
        return {'FINISHED'}


class OBJECTSDISPLAY_OT_objects_viewport_display(Operator):
    """Set the viewport display mode of the chosen objects"""
    bl_idname = _OP
    bl_label = "Objects Viewport Display"
    bl_options = {'REGISTER', 'UNDO'}

    select_method: EnumProperty(
        name="Select Method",
        items=[(sid, label, label + " objects", i)
               for i, (sid, label, _) in enumerate(_SCOPES)],
        default='SELECTED',
    )
    display_mode: EnumProperty(
        name="Display Mode",
        items=[(mid, label, label + " mode", i)
               for i, (mid, label, _) in enumerate(_MODES)],
        default='TEXTURED',
    )

    def _targets(self, context):
        method = self.select_method
        scene_objs = context.scene.objects

        if method == 'ALL':
            return list(scene_objs)

        if method in ('SELECTED', 'UNSELECTED'):
            selected = list(context.selected_objects or ())
            if not selected:
                self.report({'INFO'}, "No objects are selected" if method == 'SELECTED'
                            else "Nothing selected — operating on all objects")
            if method == 'SELECTED':
                return selected
            chosen = set(selected)
            return [o for o in scene_objs if o not in chosen]

        # COLLECTION
        view_layer = context.view_layer
        active = view_layer.active_layer_collection
        if active == view_layer.layer_collection:
            self.report({'WARNING'}, "Select a specific collection, not the scene root")
            return []
        objs = list(active.collection.all_objects)
        if not objs:
            self.report({'INFO'}, "Collection is empty")
        return objs

    def _tag_collection(self, context, mode):
        """Add / remove the _WIRE / _BOUNDS tag on the active collection's name.
        Only those two "light" modes get a tag; Solid / Textured is the normal
        state, so for them the old tag is simply removed."""
        coll = context.view_layer.active_layer_collection.collection
        if (coll == context.scene.collection or
                coll.library is not None or coll.override_library is not None):
            self.report({'INFO'}, "Collection name is read-only; skipping rename")
            return
        name = coll.name
        for tag in _TAGS:
            if name.endswith(tag):
                name = name[:-len(tag)]
                break
        if mode in ('WIRE', 'BOUNDS'):
            name += "_" + mode
        coll.name = name or coll.name

    def execute(self, context):
        mode = self.display_mode
        changed = 0
        for obj in self._targets(context):
            try:
                if obj.display_type != mode:
                    obj.display_type = mode
                changed += 1
            except Exception:           # linked / read-only data
                pass
        # Only tag the collection name when something was actually processed
        if changed and self.select_method == 'COLLECTION':
            self._tag_collection(context, mode)
        return {'FINISHED'}

    @classmethod
    def description(cls, context, properties):
        scope = _SCOPE_TEXT.get(properties.select_method, "")
        mode = _MODE_LABEL.get(properties.display_mode, "")
        return f"Set {scope} to display as {mode}"


#===================================
# --- Sidebar panel ---
#===================================
class OBJECTDISPLAY_PT_objectdisplay_panel(Panel):
    bl_label = "Display Modes"
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "View"

    def draw(self, context):
        layout = self.layout

        box = layout.box()
        box.label(text="Viewport Visibility:", icon='RESTRICT_VIEW_OFF')
        for scope, scope_label, _ in _SCOPES:
            row = box.row(align=True)
            row.label(text=scope_label + ":")
            for mode, _label, icon in _MODES:
                op = row.operator(_OP, text="", icon=icon)
                op.select_method = scope
                op.display_mode = mode

        box = layout.box()
        box.label(text="Files save as Wire + Wireframe", icon='FILE_TICK')
        box.operator("objectsdisplay.apply_wireframe", icon='SHADING_WIRE')


#===================================
# --- Context menus ---
#===================================
def _draw_modes(layout, noun, scope):
    for mode, label, icon in _MODES:
        op = layout.operator(_OP, text=f"Display {noun} as {label.lower()}", icon=icon)
        op.select_method = scope
        op.display_mode = mode


class OBJECTDISPLAY_MT_object_submenu(Menu):
    bl_label = "Object Display Mode"
    bl_idname = "OBJECTDISPLAY_MT_object_submenu"

    def draw(self, context):
        _draw_modes(self.layout, "selected", 'SELECTED')


class OBJECTDISPLAY_MT_collection_submenu(Menu):
    bl_label = "Object Display Mode"
    bl_idname = "OBJECTDISPLAY_MT_collection_submenu"

    def draw(self, context):
        _draw_modes(self.layout, "collection", 'COLLECTION')


def _menu_object(self, context):
    self.layout.separator()
    self.layout.menu(OBJECTDISPLAY_MT_object_submenu.bl_idname)


def _menu_collection(self, context):
    self.layout.separator()
    self.layout.menu(OBJECTDISPLAY_MT_collection_submenu.bl_idname)


def _menu_viewport_object(self, context):
    if context.mode == 'OBJECT':
        _menu_object(self, context)


#===================================
# --- Registration ---
#===================================
classes = (
    OBJECTDISPLAY_PT_objectdisplay_panel,
    OBJECTSDISPLAY_OT_objects_viewport_display,
    OBJECTDISPLAY_OT_apply_wireframe,
    OBJECTDISPLAY_MT_object_submenu,
    OBJECTDISPLAY_MT_collection_submenu,
)

_HANDLERS = (
    ("save_pre",  _on_save_pre),
    ("save_post", _on_save_post),
    ("load_post", _on_load_post),
)

# (menu class name, draw function)
_MENU_HOOKS = (
    ("OUTLINER_MT_context_menu",      _menu_object),
    ("OUTLINER_MT_object",            _menu_object),
    ("OUTLINER_MT_collection",        _menu_collection),
    ("VIEW3D_MT_object_context_menu", _menu_viewport_object),
)


def _hook_menu(name, fn, add):
    """Add (or just remove) a draw function on a menu, looked up by name so a menu
    that doesn't exist in some Blender version is skipped instead of breaking the
    whole add-on. Removing first keeps register() safe to run twice."""
    menu = getattr(bpy.types, name, None)
    if menu is None:
        return
    try:
        menu.remove(fn)
    except Exception:
        pass
    if add:
        menu.append(fn)


def register():
    # Handlers first: whatever happens to the UI part below, saving still works.
    for name, fn in _HANDLERS:
        handlers = getattr(bpy.app.handlers, name)
        if fn not in handlers:
            handlers.append(fn)

    for cls in classes:
        bpy.utils.register_class(cls)
    for name, fn in _MENU_HOOKS:
        _hook_menu(name, fn, add=True)


def unregister():
    _restore()                                  # a save that never finished
    for fn in (_restore, _apply_open_state):    # pending timers
        if bpy.app.timers.is_registered(fn):
            bpy.app.timers.unregister(fn)

    for name, fn in _HANDLERS:
        handlers = getattr(bpy.app.handlers, name, [])
        if fn in handlers:
            handlers.remove(fn)
    for name, fn in _MENU_HOOKS:
        _hook_menu(name, fn, add=False)
    for cls in reversed(classes):
        try:
            bpy.utils.unregister_class(cls)
        except Exception:
            pass


if __name__ == "__main__":
    register()
