# ---------------------------------------------------------------------------
# General utilities
# ---------------------------------------------------------------------------

def clamp(value, minv, maxv):
    return min(max(value, minv), maxv)


def _unique_fcurves(curves):
    """Return valid F-Curves without duplicates."""
    result = []
    seen = set()
    for fc in curves:
        try:
            pointer = fc.as_pointer()
        except (AttributeError, ReferenceError):
            continue
        if pointer not in seen:
            seen.add(pointer)
            result.append(fc)
    return result


def _action_fcurves(action, anim_data=None):
    """
    Blender 5.x supports layered Actions with slots/channel-bags.
    Older/legacy Actions may still expose action.fcurves, so both layouts
    are handled without assuming one particular Action representation.
    """
    if action is None:
        return []

    curves = []

    # Legacy Action API (where available).
    try:
        legacy_curves = action.fcurves
        curves.extend(list(legacy_curves))
    except (AttributeError, RuntimeError, TypeError):
        pass

    # Blender 5.0+ layered Action API.
    try:
        layers = list(action.layers)
    except (AttributeError, RuntimeError, TypeError):
        layers = []

    if layers:
        slots = []
        active_slot = getattr(anim_data, "action_slot", None) if anim_data else None
        if active_slot is not None:
            slots = [active_slot]
        else:
            try:
                slots = list(action.slots)
            except (AttributeError, RuntimeError, TypeError):
                slots = []

        for layer in layers:
            try:
                strips = list(layer.strips)
            except (AttributeError, RuntimeError, TypeError):
                continue

            for strip in strips:
                for slot in slots:
                    try:
                        channelbag = strip.channelbag(slot)
                    except (AttributeError, RuntimeError, TypeError):
                        channelbag = None
                    if channelbag is None:
                        continue
                    try:
                        curves.extend(list(channelbag.fcurves))
                    except (AttributeError, RuntimeError, TypeError):
                        pass

    return _unique_fcurves(curves)


def get_graph_fcurves(context):
    """Collect Graph Editor curves, including Blender 5.x layered Actions."""
    fcurves = []

    # Preferred source: curves exposed by the current Graph Editor context.
    try:
        selected = getattr(context, "selected_editable_fcurves", None)
        if selected:
            fcurves.extend(list(selected))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    # Include curves from the Graph Editor's edited object.
    try:
        space = context.space_data
        if space and space.type == 'GRAPH_EDITOR':
            edit_obj = getattr(space, "edit_object", None)
            if edit_obj and edit_obj.animation_data:
                adt = edit_obj.animation_data
                fcurves.extend(_action_fcurves(adt.action, adt))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    # Include curves from the active object as a fallback.
    try:
        obj = context.active_object
        if obj and obj.animation_data:
            adt = obj.animation_data
            fcurves.extend(_action_fcurves(adt.action, adt))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    return _unique_fcurves(fcurves)


def auto_fix_bad_keyframes(fcurve):
    """Replace non-finite key values using neighboring finite values."""
    try:
        points = fcurve.keyframe_points
        count = len(points)
        for i in range(count):
            value = float(points[i].co[1])
            if math.isfinite(value):
                continue

            left = next(
                (float(points[j].co[1]) for j in range(i - 1, -1, -1)
                 if math.isfinite(float(points[j].co[1]))),
                None,
            )
            right = next(
                (float(points[j].co[1]) for j in range(i + 1, count)
                 if math.isfinite(float(points[j].co[1]))),
                None,
            )

            if left is not None and right is not None:
                points[i].co[1] = (left + right) * 0.5
            elif left is not None:
                points[i].co[1] = left
            elif right is not None:
                points[i].co[1] = right
            else:
                points[i].co[1] = 0.0
        fcurve.update()
    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        pass


def set_bezier_and_auto_clamp_handles(fcurve):
    """Set smoothed curves to Bezier with auto-clamped handles."""
    try:
        for kp in fcurve.keyframe_points:
            kp.interpolation = 'BEZIER'
            kp.handle_left_type = 'AUTO_CLAMPED'
            kp.handle_right_type = 'AUTO_CLAMPED'
        fcurve.update()
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass


# ---------------------------------------------------------------------------
# F-Curve smoothing
# ---------------------------------------------------------------------------

def smooth_keyframes(
    fcurve,
    iterations,
    strength,
    sensitivity,
    preserve_ends=True,
    all_keyframes=False,
):
    """
    Smooth key values using the original three-neighbor averaging logic.
    Keyframe X positions and handles are not moved by this function.
    """
    try:
        keyframes = fcurve.keyframe_points
        n = len(keyframes)
        if n < 3:
            return {'moved': 0, 'max_delta': 0.0}

        if all_keyframes:
            indices = list(range(n))
        else:
            indices = [
                i for i, kp in enumerate(keyframes)
                if kp.select_control_point
            ]
            if len(indices) < 3:
                return {'moved': 0, 'max_delta': 0.0}

        values = [float(kp.co[1]) for kp in keyframes]
        if not all(math.isfinite(v) for v in values):
            auto_fix_bad_keyframes(fcurve)
            values = [float(kp.co[1]) for kp in keyframes]

        stats = {'moved': 0, 'max_delta': 0.0}
        strength_factor = float(strength) ** 3
        smooth_factor = 1.0 - float(sensitivity)

        for _ in range(int(iterations)):
            new_values = values[:]

            for idx_pos in range(1, len(indices) - 1):
                if preserve_ends and idx_pos in (0, len(indices) - 1):
                    continue

                i = indices[idx_pos]
                left_i = indices[idx_pos - 1]
                right_i = indices[idx_pos + 1]

                left = values[left_i]
                center = values[i]
                right = values[right_i]
                average = (left + center + right) / 3.0

                diff = abs(center - average)
                base = abs(center) if center != 0.0 else 1.0
                weight_unclamped = strength_factor * (
                    1.0 - smooth_factor + smooth_factor * (diff / base)
                )
                weight = clamp(weight_unclamped, 0.0, 1.0)
                new_value = center * (1.0 - weight) + average * weight

                if not math.isfinite(new_value):
                    new_value = center

                delta = new_value - center
                new_values[i] = new_value
                if abs(delta) > 0.0:
                    stats['moved'] += 1
                    stats['max_delta'] = max(
                        stats['max_delta'], abs(delta)
                    )

            values = new_values

        for i in indices:
            keyframes[i].co[1] = values[i]

        auto_fix_bad_keyframes(fcurve)
        fcurve.update()
        return stats

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        return {'moved': 0, 'max_delta': 0.0}


# ---------------------------------------------------------------------------
# Smart Euler / Quaternion continuity filter
# ---------------------------------------------------------------------------

def nearest_equivalent_euler(previous_value, current_value):
    """Return the equivalent angle nearest to the previous angle."""
    twopi = 2.0 * math.pi
    while current_value - previous_value > math.pi:
        current_value -= twopi
    while current_value - previous_value < -math.pi:
        current_value += twopi
    return current_value


def get_selection_info(context):
    obj = context.active_object
    if obj is None:
        return None, None, ""

    if obj.type == 'ARMATURE':
        bone = getattr(context, "active_pose_bone", None)
        if bone is not None:
            try:
                return bone, bone.rotation_mode, bone.path_from_id()
            except (AttributeError, ReferenceError, RuntimeError):
                return bone, bone.rotation_mode, f'pose.bones["{bone.name}"]'

    return obj, getattr(obj, "rotation_mode", "XYZ"), ""


def get_rotation_fcurves(mode_code, all_fcurves, rna_path_prefix):
    try:
        if mode_code == "EULER":
            channel = "rotation_euler"
            num_channels = 3
        else:
            channel = "rotation_quaternion"
            num_channels = 4

        if rna_path_prefix:
            prefix = rna_path_prefix + "."
            found = [
                fc for fc in all_fcurves
                if fc.data_path.startswith(prefix)
                and fc.data_path.endswith(channel)
            ]
        else:
            found = [
                fc for fc in all_fcurves
                if fc.data_path == channel
            ]

        found = sorted(
            found,
            key=lambda fc: getattr(fc, "array_index", 0)
        )
        found = found[:num_channels]

        if not found:
            return None, f"No {channel} F-Curves found."

        return found, None

    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        return None, "Error finding rotation curves."


def _frame_key(value):
    """Use subframe-safe frame keys instead of rounding to whole frames."""
    return round(float(value), 6)


def get_fcurve_keyframe_map(fcurve):
    try:
        return {
            _frame_key(kp.co[0]): kp
            for kp in fcurve.keyframe_points
        }
    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        return {}


def collect_keyframes_with_handles_any(curves):
    try:
        axis_keyframes = [get_fcurve_keyframe_map(fc) for fc in curves]
        frames = sorted({
            frame
            for mapping in axis_keyframes
            for frame in mapping.keys()
        })
        if not frames:
            return []

        keyframe_info = []
        for frame in frames:
            key_points = [mapping.get(frame) for mapping in axis_keyframes]
            values = [
                float(kp.co[1]) if kp is not None else None
                for kp in key_points
            ]
            handles = []

            for kp in key_points:
                if kp is None:
                    handles.append({
                        'handle_left_type': None,
                        'handle_right_type': None,
                        'handle_left': None,
                        'handle_right': None,
                    })
                else:
                    handles.append({
                        'handle_left_type': kp.handle_left_type,
                        'handle_right_type': kp.handle_right_type,
                        'handle_left': kp.handle_left.copy(),
                        'handle_right': kp.handle_right.copy(),
                    })

            keyframe_info.append({
                'frame': frame,
                'value': values,
                'handles': handles,
            })

        return keyframe_info

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        return []


def unwrap_keyframe_values_euler_any(keyframes):
    result = []
    previous = None

    for info in keyframes:
        values = info['value']
        if previous is None:
            fixed = list(values)
        else:
            fixed = [
                nearest_equivalent_euler(previous[i], values[i])
                if values[i] is not None and previous[i] is not None
                else values[i]
                for i in range(len(values))
            ]

        result.append({
            'frame': info['frame'],
            'value': fixed,
            'handles': info['handles'],
        })
        previous = [
            fixed[i] if fixed[i] is not None
            else (previous[i] if previous else None)
            for i in range(len(fixed))
        ]

    return result


def unwrap_keyframe_values_quaternion_any(keyframes):
    """
    Quaternion q and -q represent the same orientation. Flip a complete
    quaternion when its dot product with the previous quaternion is negative.
    """
    result = []
    previous = None

    for info in keyframes:
        values = info['value']

        # Quaternion filtering requires all four channels at each sample.
        # Missing channels are filled from the preceding sample (or identity).
        complete = [
            values[i] if values[i] is not None
            else (previous[i] if previous is not None else
                  (1.0 if i == 0 else 0.0))
            for i in range(4)
        ]

        quat = Quaternion(complete)
        if quat.length > 1e-12:
            quat.normalize()
        else:
            quat = Quaternion((1.0, 0.0, 0.0, 0.0))

        if previous is not None:
            prev_quat = Quaternion(previous)
            if prev_quat.dot(quat) < 0.0:
                quat.negate()

        fixed = [quat.w, quat.x, quat.y, quat.z]
        result.append({
            'frame': info['frame'],
            'value': fixed,
            'handles': info['handles'],
        })
        previous = fixed[:]

    return result


def preserve_and_update_fcurve_points_any(curves, keyframe_infos):
    """Write filtered values and restore each point's original handles."""
    try:
        for axis, fcurve in enumerate(curves):
            frame_map = get_fcurve_keyframe_map(fcurve)

            for info in keyframe_infos:
                frame = info['frame']
                value = info['value'][axis]
                handle_info = info['handles'][axis]
                kp = frame_map.get(frame)

                if kp is None or value is None:
                    continue

                kp.co[1] = value

                if handle_info['handle_left_type'] is not None:
                    kp.handle_left_type = handle_info['handle_left_type']
                if handle_info['handle_right_type'] is not None:
                    kp.handle_right_type = handle_info['handle_right_type']

                # Restore coordinates after restoring handle types because
                # changing handle types may recalculate handle positions.
                if handle_info['handle_left'] is not None:
                    kp.handle_left = handle_info['handle_left']
                if handle_info['handle_right'] is not None:
                    kp.handle_right = handle_info['handle_right']

            fcurve.update()

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        pass


