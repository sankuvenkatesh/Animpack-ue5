# ---------------------------------------------------------------------------
# General utilities
# ---------------------------------------------------------------------------

def clamp(value, minv, maxv):
    return min(max(value, minv), maxv)


def _unique_fcurves(curves):
    """Return valid F-Curves without duplicates."""
    result = []
    seen = set()

    for fc in curves:
        try:
            pointer = fc.as_pointer()
        except (AttributeError, ReferenceError, RuntimeError):
            continue

        if pointer not in seen:
            seen.add(pointer)
            result.append(fc)

    return result


def _action_fcurves(action, anim_data=None):
    """
    Collect F-Curves from legacy Actions and Blender 5.x layered Actions.

    In Blender 5.x, layered Action curves live in channel-bags inside
    Action layers and strips. The assigned Action Slot is preferred so that
    curves belonging to another slot are not accidentally mixed in.
    """
    if action is None:
        return []

    curves = []

    # Legacy Action API (kept for compatibility with older Blender files).
    try:
        legacy_curves = action.fcurves
        curves.extend(list(legacy_curves))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    # Blender 5.x layered Action API.
    try:
        layers = list(action.layers)
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        layers = []

    if layers:
        active_slot = None
        if anim_data is not None:
            try:
                active_slot = anim_data.action_slot
            except (AttributeError, ReferenceError, RuntimeError, TypeError):
                active_slot = None

        if active_slot is not None:
            slots = [active_slot]
        else:
            try:
                slots = list(action.slots)
            except (AttributeError, ReferenceError, RuntimeError, TypeError):
                slots = []

        for layer in layers:
            try:
                strips = list(layer.strips)
            except (AttributeError, ReferenceError, RuntimeError, TypeError):
                continue

            for strip in strips:
                for slot in slots:
                    try:
                        channelbag = strip.channelbag(slot)
                    except (AttributeError, ReferenceError, RuntimeError, TypeError):
                        channelbag = None

                    if channelbag is None:
                        continue

                    try:
                        curves.extend(list(channelbag.fcurves))
                    except (AttributeError, ReferenceError, RuntimeError, TypeError):
                        pass

    return _unique_fcurves(curves)


def get_graph_fcurves(context):
    """Collect Graph Editor curves, including Blender 5.x layered Actions."""
    fcurves = []

    # Preferred source: curves exposed by the current Graph Editor context.
    try:
        selected = getattr(context, "selected_editable_fcurves", None)
        if selected:
            fcurves.extend(list(selected))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    # Include curves from the Graph Editor's edited object when available.
    try:
        space = context.space_data
        if space and space.type == 'GRAPH_EDITOR':
            edit_obj = getattr(space, "edit_object", None)
            if edit_obj and edit_obj.animation_data:
                anim_data = edit_obj.animation_data
                fcurves.extend(_action_fcurves(anim_data.action, anim_data))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    # Include curves from the active object as a fallback.
    try:
        obj = context.active_object
        if obj and obj.animation_data:
            anim_data = obj.animation_data
            fcurves.extend(_action_fcurves(anim_data.action, anim_data))
    except (AttributeError, ReferenceError, RuntimeError, TypeError):
        pass

    return _unique_fcurves(fcurves)


def auto_fix_bad_keyframes(fcurve):
    """Replace non-finite key values using neighboring finite values."""
    try:
        points = fcurve.keyframe_points
        count = len(points)

        for i in range(count):
            value = float(points[i].co[1])
            if math.isfinite(value):
                continue

            left = next(
                (
                    float(points[j].co[1])
                    for j in range(i - 1, -1, -1)
                    if math.isfinite(float(points[j].co[1]))
                ),
                None,
            )
            right = next(
                (
                    float(points[j].co[1])
                    for j in range(i + 1, count)
                    if math.isfinite(float(points[j].co[1]))
                ),
                None,
            )

            if left is not None and right is not None:
                points[i].co[1] = (left + right) * 0.5
            elif left is not None:
                points[i].co[1] = left
            elif right is not None:
                points[i].co[1] = right
            else:
                points[i].co[1] = 0.0

        fcurve.update()

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
        print(f"[Smart Curve Tools] Warning: Failed to fix bad keyframes - {exc}")


def set_bezier_and_auto_clamp_handles(fcurve):
    """Set smoothed curves to Bezier with auto-clamped handles."""
    try:
        for kp in fcurve.keyframe_points:
            kp.interpolation = 'BEZIER'
            kp.handle_left_type = 'AUTO_CLAMPED'
            kp.handle_right_type = 'AUTO_CLAMPED'

        fcurve.update()

    except (AttributeError, ReferenceError, RuntimeError, TypeError) as exc:
        print(f"[Smart Curve Tools] Warning: Failed to set handle types - {exc}")


# ---------------------------------------------------------------------------
# F-Curve smoothing
# ---------------------------------------------------------------------------

def smooth_keyframes(
    fcurve,
    iterations,
    strength,
    sensitivity,
    preserve_ends=True,
    all_keyframes=False,
):
    """Smooth key values using three-neighbor averaging."""
    try:
        keyframes = fcurve.keyframe_points
        n = len(keyframes)

        if n < 3:
            return {'moved': 0, 'max_delta': 0.0}

        if all_keyframes:
            indices = list(range(n))
        else:
            indices = [
                i for i, kp in enumerate(keyframes)
                if kp.select_control_point
            ]
            if len(indices) < 3:
                return {'moved': 0, 'max_delta': 0.0}

        values = [float(kp.co[1]) for kp in keyframes]

        if not all(math.isfinite(v) for v in values):
            auto_fix_bad_keyframes(fcurve)
            values = [float(kp.co[1]) for kp in keyframes]

        stats = {'moved': 0, 'max_delta': 0.0}
        strength_factor = float(strength) ** 3
        smooth_factor = 1.0 - float(sensitivity)

        for _ in range(int(iterations)):
            new_values = values[:]

            for idx_pos in range(1, len(indices) - 1):
                if preserve_ends and idx_pos in (0, len(indices) - 1):
                    continue

                i = indices[idx_pos]
                left_i = indices[idx_pos - 1]
                right_i = indices[idx_pos + 1]

                left = values[left_i]
                center = values[i]
                right = values[right_i]
                average = (left + center + right) / 3.0

                diff = abs(center - average)
                base = abs(center) if center != 0.0 else 1.0
                weight_unclamped = strength_factor * (
                    1.0 - smooth_factor + smooth_factor * (diff / base)
                )
                weight = clamp(weight_unclamped, 0.0, 1.0)
                new_value = center * (1.0 - weight) + average * weight

                if not math.isfinite(new_value):
                    new_value = center

                delta = new_value - center
                new_values[i] = new_value

                if abs(delta) > 0.0:
                    stats['moved'] += 1
                    stats['max_delta'] = max(
                        stats['max_delta'], abs(delta)
                    )

            values = new_values

        for i in indices:
            keyframes[i].co[1] = values[i]

        auto_fix_bad_keyframes(fcurve)
        fcurve.update()
        return stats

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
        print(f"[Smart Curve Tools] Warning: Smoothing failed - {exc}")
        return {'moved': 0, 'max_delta': 0.0}


# ---------------------------------------------------------------------------
# Smart Euler / Quaternion continuity filter
# ---------------------------------------------------------------------------

def nearest_equivalent_euler(previous_value, current_value):
    """Return the equivalent angle nearest to the previous angle."""
    twopi = 2.0 * math.pi

    while current_value - previous_value > math.pi:
        current_value -= twopi

    while current_value - previous_value < -math.pi:
        current_value += twopi

    return current_value


def get_selection_info(context):
    """Get the active object or active pose bone and its rotation mode."""
    obj = context.active_object
    if obj is None:
        return None, None, ""

    if obj.type == 'ARMATURE':
        bone = getattr(context, "active_pose_bone", None)

        # Graph Editor contexts do not always expose active_pose_bone.
        if bone is None:
            try:
                bone = obj.pose.bones.active
            except (AttributeError, ReferenceError, RuntimeError):
                bone = None

        if bone is not None:
            try:
                return bone, bone.rotation_mode, bone.path_from_id()
            except (AttributeError, ReferenceError, RuntimeError):
                escaped_name = bone.name.replace("\\", "\\\\").replace('"', '\\"')
                return (
                    bone,
                    bone.rotation_mode,
                    f'pose.bones["{escaped_name}"]',
                )

    return obj, getattr(obj, "rotation_mode", "XYZ"), ""


def get_rotation_fcurves(mode_code, all_fcurves, rna_path_prefix):
    """
    Find the complete rotation channel set in array-index order.

    Quaternion continuity must always operate on W, X, Y and Z together.
    Returning a partial quaternion channel set would cause invalid indexing
    or produce an incorrect orientation, so missing channels are reported.
    """
    try:
        if mode_code == "EULER":
            channel = "rotation_euler"
            expected_indices = (0, 1, 2)
        else:
            channel = "rotation_quaternion"
            expected_indices = (0, 1, 2, 3)

        expected_path = (
            f"{rna_path_prefix}.{channel}"
            if rna_path_prefix else channel
        )

        indexed_curves = {}

        for fc in all_fcurves:
            try:
                if fc.data_path != expected_path:
                    continue

                index = int(fc.array_index)
                if index in expected_indices and index not in indexed_curves:
                    indexed_curves[index] = fc
            except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
                print(f"[Smart Curve Tools] Skipped a curve during rotation check - {exc}")
                continue

        missing = [
            index for index in expected_indices
            if index not in indexed_curves
        ]

        if missing:
            channel_names = (
                "W, X, Y, Z" if mode_code == "QUATERNION" else "X, Y, Z"
            )
            return None, (
                f"Incomplete {channel} F-Curves. Missing array index: "
                f"{missing}. Expected channels: {channel_names}. "
                "Check the active Action and Action Slot in the Graph Editor."
            )

        return [indexed_curves[i] for i in expected_indices], None

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
        print(f"[Smart Curve Tools] Error finding rotation curves - {exc}")
        return None, "Error finding rotation curves."


def _frame_key(value):
    """Use subframe-safe frame keys instead of rounding to whole frames."""
    return round(float(value), 6)


def get_fcurve_keyframe_map(fcurve):
    try:
        return {
            _frame_key(kp.co[0]): kp
            for kp in fcurve.keyframe_points
        }
    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError):
        return {}


def collect_keyframes_with_handles_any(curves):
    """Collect the union of keyframe times and each channel's key data."""
    try:
        axis_keyframes = [get_fcurve_keyframe_map(fc) for fc in curves]
        frames = sorted({
            frame
            for mapping in axis_keyframes
            for frame in mapping.keys()
        })

        if not frames:
            return []

        keyframe_info = []

        for frame in frames:
            key_points = [mapping.get(frame) for mapping in axis_keyframes]
            values = [
                float(kp.co[1]) if kp is not None else None
                for kp in key_points
            ]
            handles = []

            for kp in key_points:
                if kp is None:
                    handles.append({
                        'handle_left_type': None,
                        'handle_right_type': None,
                        'handle_left': None,
                        'handle_right': None,
                    })
                else:
                    handles.append({
                        'handle_left_type': kp.handle_left_type,
                        'handle_right_type': kp.handle_right_type,
                        'handle_left': kp.handle_left.copy(),
                        'handle_right': kp.handle_right.copy(),
                    })

            keyframe_info.append({
                'frame': frame,
                'value': values,
                'handles': handles,
            })

        return keyframe_info

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
        print(f"[Smart Curve Tools] Error collecting keyframes - {exc}")
        return []


def unwrap_keyframe_values_euler_any(keyframes):
    """Unwrap Euler channels independently, avoiding +/- 2-pi jumps."""
    result = []
    previous = None

    for info in keyframes:
        values = info['value']

        if previous is None:
            fixed = list(values)
        else:
            fixed = [
                nearest_equivalent_euler(previous[i], values[i])
                if values[i] is not None and previous[i] is not None
                else values[i]
                for i in range(len(values))
            ]

        result.append({
            'frame': info['frame'],
            'value': fixed,
            'handles': info['handles'],
        })

        if previous is None:
            previous = list(fixed)
        else:
            previous = [
                fixed[i] if fixed[i] is not None else previous[i]
                for i in range(len(fixed))
            ]

    return result


def unwrap_keyframe_values_quaternion_any(keyframes):
    """
    Apply quaternion sign continuity to complete W, X, Y, Z samples.
    """
    result = []
    previous = None

    for info in keyframes:
        values = info['value']

        if len(values) != 4:
            raise ValueError(
                "Quaternion continuity requires exactly four channels: W, X, Y and Z."
            )

        if any(value is None for value in values):
            raise ValueError(
                "Quaternion keyframes are not aligned. All four channels "
                "(W, X, Y, Z) must have keyframes at the same frames."
            )

        if not all(math.isfinite(float(value)) for value in values):
            raise ValueError(
                "Quaternion contains a non-finite keyframe value. "
                "Clean the invalid keys and try again."
            )

        components = [float(value) for value in values]
        magnitude = math.sqrt(sum(component * component for component in components))

        if magnitude > 1e-12:
            normalized = [component / magnitude for component in components]
            quat = Quaternion(normalized)
        else:
            quat = Quaternion((1.0, 0.0, 0.0, 0.0))

        if previous is not None:
            previous_quat = Quaternion(previous)
            if previous_quat.dot(quat) < 0.0:
                quat.negate()

        fixed = [quat.w, quat.x, quat.y, quat.z]

        result.append({
            'frame': info['frame'],
            'value': fixed,
            'handles': info['handles'],
        })

        previous = fixed[:]

    return result


def preserve_and_update_fcurve_points_any(curves, keyframe_infos):
    """
    Write filtered values and preserve handle shape relative to each key.
    """
    try:
        for axis, fcurve in enumerate(curves):
            frame_map = get_fcurve_keyframe_map(fcurve)

            for info in keyframe_infos:
                frame = info['frame']
                value = info['value'][axis]
                handle_info = info['handles'][axis]
                kp = frame_map.get(frame)

                if kp is None or value is None:
                    continue

                old_value = float(kp.co[1])
                new_value = float(value)
                delta = new_value - old_value

                if not math.isfinite(new_value):
                    continue

                kp.co[1] = new_value

                if handle_info['handle_left_type'] is not None:
                    kp.handle_left_type = handle_info['handle_left_type']
                if handle_info['handle_right_type'] is not None:
                    kp.handle_right_type = handle_info['handle_right_type']

                left_handle = handle_info['handle_left']
                right_handle = handle_info['handle_right']

                if left_handle is not None:
                    new_left = left_handle.copy()
                    new_left.y += delta
                    kp.handle_left = new_left

                if right_handle is not None:
                    new_right = right_handle.copy()
                    new_right.y += delta
                    kp.handle_right = new_right

            fcurve.update()

    except (AttributeError, ReferenceError, RuntimeError, TypeError, ValueError) as exc:
        print(f"[Smart Curve Tools] Failed to preserve/update handles - {exc}")
        raise


