class ROTATION_OT_smart_euler_filter(bpy.types.Operator):
    """Apply Euler angle or Quaternion sign continuity to rotation curves."""
    bl_idname = "graph.smart_euler_filter"
    bl_label = "Smart Euler Filter"
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return context.area is not None and context.area.type == 'GRAPH_EDITOR'

    def execute(self, context):
        fcurves = get_graph_fcurves(context)
        if not fcurves:
            self.report({'ERROR'}, "No F-Curves found.")
            return {'CANCELLED'}

        entity, rotation_mode, path_prefix = get_selection_info(context)
        if entity is None:
            self.report({'ERROR'}, "No active object or active pose bone.")
            return {'CANCELLED'}

        mode_code = (
            "QUATERNION"
            if rotation_mode == "QUATERNION"
            else "EULER"
        )

        rotation_curves, error = get_rotation_fcurves(
            mode_code, fcurves, path_prefix
        )
        if rotation_curves is None:
            self.report({'ERROR'}, error)
            return {'CANCELLED'}

        selected_curves = [
            fc for fc in rotation_curves
            if getattr(fc, "select", False)
        ]

        if mode_code == "QUATERNION":
            # A quaternion is a four-component value. Filtering only one
            # selected component would produce an invalid sign-continuity
            # calculation, so process all four channels together.
            curves_to_process = rotation_curves
            selection_note = "all quaternion channels"
        else:
            curves_to_process = (
                selected_curves if selected_curves else rotation_curves
            )
            selection_note = (
                "selected Euler channels"
                if selected_curves else "all Euler channels"
            )

        keyframes = collect_keyframes_with_handles_any(curves_to_process)
        if not keyframes:
            self.report({'ERROR'}, "No rotation keyframes found.")
            return {'CANCELLED'}

        if mode_code == "EULER":
            processed = unwrap_keyframe_values_euler_any(keyframes)
        else:
            processed = unwrap_keyframe_values_quaternion_any(keyframes)

        preserve_and_update_fcurve_points_any(curves_to_process, processed)

        if context.area:
            context.area.tag_redraw()

        self.report(
            {'INFO'},
            f"{mode_code} continuity applied to "
            f"{len(curves_to_process)} channel(s) ({selection_note})."
        )
        return {'FINISHED'}


class CurveSmoothProperties(bpy.types.PropertyGroup):
    iterations: bpy.props.IntProperty(
        name="Iterations",
        description="Number of smoothing iterations",
        default=5,
        min=1,
        max=50,
    )
    strength: bpy.props.FloatProperty(
        name="Strength",
        description="Smoothing intensity (0-1)",
        default=0.5,
        min=0.0,
        max=1.0,
    )
    sensitivity: bpy.props.FloatProperty(
        name="Sensitivity",
        description="Sensitivity falloff (0-1)",
        default=0.5,
        min=0.0,
        max=1.0,
    )
    preserve_ends: bpy.props.BoolProperty(
        name="Preserve Ends",
        description="Do not smooth the first and last selected keyframes",
        default=True,
    )


class CurveSmoothOperator(bpy.types.Operator):
    """Smooth selected keyframes on selected editable F-Curves."""
    bl_idname = "graph.smooth_selected_keyframes"
    bl_label = "Smooth Selected Keyframes (Advanced)"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    @classmethod
    def poll(cls, context):
        return context.area is not None and context.area.type == 'GRAPH_EDITOR'

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        curves = list(
            getattr(context, "selected_editable_fcurves", []) or []
        )

        if not curves:
            self.report({'WARNING'}, "No editable F-Curves selected.")
            return {'CANCELLED'}

        smoothed_count = 0
        total_keys = 0
        biggest_move = 0.0

        for fcurve in _unique_fcurves(curves):
            selected_keys = [
                kp for kp in fcurve.keyframe_points
                if kp.select_control_point
            ]
            if len(selected_keys) < 3:
                continue

            stats = smooth_keyframes(
                fcurve,
                settings.iterations,
                settings.strength,
                settings.sensitivity,
                settings.preserve_ends,
                all_keyframes=False,
            )
            if stats['moved'] > 0:
                set_bezier_and_auto_clamp_handles(fcurve)
            smoothed_count += 1
            total_keys += stats['moved']
            biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report(
                {'WARNING'},
                "Not enough selected keyframes to smooth (need at least 3)."
            )
            return {'CANCELLED'}

        if context.area:
            context.area.tag_redraw()

        self.report(
            {'INFO'},
            f"Smoothed {total_keys} keyframe updates in "
            f"{smoothed_count} F-Curve(s). Largest change: {biggest_move:.4f}."
        )
        return {'FINISHED'}


class CurveSmoothAllOperator(bpy.types.Operator):
    """Smooth every keyframe on all curves available to this Graph Editor."""
    bl_idname = "graph.smooth_all_keyframes"
    bl_label = "Batch Smooth All F-Curves"
    bl_options = {'REGISTER', 'UNDO', 'PRESET'}

    @classmethod
    def poll(cls, context):
        return context.area is not None and context.area.type == 'GRAPH_EDITOR'

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        fcurves = get_graph_fcurves(context)

        if not fcurves:
            self.report({'WARNING'}, "No F-Curves found.")
            return {'CANCELLED'}

        smoothed_count = 0
        total_keys = 0
        biggest_move = 0.0

        for fcurve in fcurves:
            if len(fcurve.keyframe_points) < 3:
                continue

            stats = smooth_keyframes(
                fcurve,
                settings.iterations,
                settings.strength,
                settings.sensitivity,
                settings.preserve_ends,
                all_keyframes=True,
            )
            if stats['moved'] > 0:
                set_bezier_and_auto_clamp_handles(fcurve)

            smoothed_count += 1
            total_keys += stats['moved']
            biggest_move = max(biggest_move, stats['max_delta'])

        if smoothed_count == 0:
            self.report({'WARNING'}, "No F-Curves with at least 3 keyframes.")
            return {'CANCELLED'}

        if context.area:
            context.area.tag_redraw()

        self.report(
            {'INFO'},
            f"Batch smoothed {total_keys} keyframe updates in "
            f"{smoothed_count} F-Curve(s). Largest change: {biggest_move:.4f}."
        )
        return {'FINISHED'}


class ResetCurveSmoothValuesOperator(bpy.types.Operator):
    """Restore the default curve smoothing settings."""
    bl_idname = "graph.reset_curve_smooth_values"
    bl_label = "Reset Curve Smooth Values"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        settings = context.scene.curve_smooth_settings
        settings.iterations = 5
        settings.strength = 0.5
        settings.sensitivity = 0.5
        settings.preserve_ends = True

        self.report({'INFO'}, "Smoothing settings restored to defaults.")
        return {'FINISHED'}


