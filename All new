def change_gizmo_size(context, step):

    """
    Change global viewport gizmo size.

    Returns False if unavailable.
    """

    view = context.preferences.view

    if not hasattr(view, "gizmo_size"):
        return False

    try:

        view.gizmo_size = max(
            10,
            min(
                200,
                view.gizmo_size + step
            )
        )

        return True

    except Exception as exc:

        print(
            f"[Combined Tools] Gizmo size error: {exc}"
        )

        return False


class VIEW3D_OT_gizmo_bigger(bpy.types.Operator):

    """Increase transform gizmo size"""

    bl_idname = "view3d.gizmo_bigger"
    bl_label = "Increase Gizmo Size"

    bl_options = {'REGISTER'}

    def execute(self, context):

        if not change_gizmo_size(context, +10):

            self.report(
                {'WARNING'},
                "Gizmo size is unavailable"
            )

            return {'CANCELLED'}

        return {'FINISHED'}


class VIEW3D_OT_gizmo_smaller(bpy.types.Operator):

    """Decrease transform gizmo size"""

    bl_idname = "view3d.gizmo_smaller"
    bl_label = "Decrease Gizmo Size"

    bl_options = {'REGISTER'}

    def execute(self, context):

        if not change_gizmo_size(context, -10):

            self.report(
                {'WARNING'},
                "Gizmo size is unavailable"
            )

            return {'CANCELLED'}

        return {'FINISHED'}


class VIEW3D_OT_open_gizmo_prefs(bpy.types.Operator):

    """Open Preferences > Viewport"""

    bl_idname = "view3d.open_gizmo_prefs"
    bl_label = "Open Gizmo Preferences"

    def execute(self, context):

        try:

            context.preferences.active_section = 'VIEWPORT'

        except Exception:
            pass

        try:

            bpy.ops.screen.userpref_show(
                'INVOKE_DEFAULT'
            )

        except Exception as exc:

            self.report(
                {'WARNING'},
                f"Could not open Preferences: {exc}"
            )

            return {'CANCELLED'}

        return {'FINISHED'}


