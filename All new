    "name": "Combined Animation & Gizmo Tools",
    "author": "Venkatesh Sanku",
    "version": (1, 9, 1),
    "blender": (5, 1, 0),
    "location": "Timeline / Dope Sheet / Graph Editor header, Graph Editor right-click, 3D View > Sidebar > Tool",
    "description": "Action + slot selector, Paste Connect, action to scene range, gizmo size controls",
    "category": "Animation",
