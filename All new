# ACTION: NEW / DUPLICATE
# ============================================================

class ANIM_OT_new_action(bpy.types.Operator):

    """Create a new Action or duplicate the current Action"""

    bl_idname = "anim.new_action"
    bl_label = "New Action"
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return get_active_object(context) is not None

    def execute(self, context):

        obj = get_active_object(context)

        anim = obj.animation_data

        if anim is None:
            anim = obj.animation_data_create()

        # Prevent editing actions during NLA tweak mode.
        if getattr(anim, "use_tweak_mode", False):
            self.report(
                {'WARNING'},
                "Exit NLA tweak mode first"
            )
            return {'CANCELLED'}

        source = anim.action

        preferred_slot = None

        if source is not None:

            old_slot = getattr(anim, "action_slot", None)

            if old_slot is not None:
                preferred_slot = old_slot.identifier

            # Preserve the original Action when it is about
            # to lose its only user.
            if (
                source.users <= 1
                and not source.use_fake_user
            ):
                source.use_fake_user = True

            try:
                new_action = source.copy()
            except Exception as exc:
                self.report(
                    {'ERROR'},
                    f"Action duplication failed: {exc}"
                )
                return {'CANCELLED'}

        else:

            new_action = bpy.data.actions.new(
                name="Action"
            )

        try:
            anim.action = new_action

            ensure_action_slot(
                anim,
                obj,
                preferred_slot
            )

        except Exception as exc:

            self.report(
                {'ERROR'},
                f"Could not assign new Action: {exc}"
            )

            return {'CANCELLED'}

        self.report(
            {'INFO'},
            f"Created Action: {new_action.name}"
        )

        return {'FINISHED'}


# ============================================================
# ACTION RANGE TO SCENE
# ============================================================

class ANIM_OT_action_to_scene_range(bpy.types.Operator):

    """Set scene range using the active Action range"""

    bl_idname = "anim.action_to_scene_range"
    bl_label = "Action to Scene Range"

    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return get_active_action(context) is not None

    def execute(self, context):

        action = get_active_action(context)

        if action is None:
            return {'CANCELLED'}

        start, end = action.frame_range

        scene = context.scene

        scene.frame_start = math.floor(start)
        scene.frame_end = math.ceil(end)

        self.report(
            {'INFO'},
            f"Scene Range: {scene.frame_start} - {scene.frame_end}"
        )

        return {'FINISHED'}


