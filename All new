_attached = []


def _attach(type_name, fn):

    target = getattr(
        bpy.types,
        type_name,
        None
    )

    if target is None:

        print(
            f"[Combined Tools] "
            f"{type_name} unavailable"
        )

        return

    try:

        # Avoid duplicate callbacks.
        old_funcs = (
            getattr(
                getattr(target, "draw", None),
                "_draw_funcs",
                None
            )
            or ()
        )

        for old in list(old_funcs):

            if getattr(old, "__name__", "") == fn.__name__:
                target.remove(old)

        target.append(fn)

        _attached.append(
            (target, fn)
        )

    except Exception as exc:

        print(
            f"[Combined Tools] "
            f"Could not attach {type_name}: {exc}"
        )


def register():

    for cls in classes:

        try:
            bpy.utils.register_class(cls)

        except ValueError:

            # Already registered.
            print(
                f"[Combined Tools] "
                f"{cls.__name__} already registered"
            )

    for type_name, fn in _UI_HOOKS:

        _attach(
            type_name,
            fn
        )

    print(
        "Combined Animation & Gizmo Tools "
        "v2.0.0 loaded - Blender 5.2+"
    )


def unregister():

    for target, fn in reversed(_attached):

        try:
            target.remove(fn)

        except Exception:
            pass

    _attached.clear()

    for cls in reversed(classes):

        try:
            bpy.utils.unregister_class(cls)

        except Exception:
            pass

    print(
        "Combined Animation & Gizmo Tools unloaded"
    )


if __name__ == "__main__":

    register()
