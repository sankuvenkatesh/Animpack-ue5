# ============================================================
# UTILITY
# ============================================================

def get_active_object(context):
    view_layer = context.view_layer
    return view_layer.objects.active if view_layer else None


def get_active_action(context):
    obj = get_active_object(context)
    anim = obj.animation_data if obj else None
    return anim.action if anim else None


def ensure_action_slot(anim, obj, preferred_identifier=None):
    """
    Ensure the assigned action has a suitable slot.

    Compatible with Blender 4.4+ slotted Actions.
    """

    action = anim.action

    if action is None:
        return

    if not hasattr(anim, "action_slot"):
        return

    if anim.action_slot is not None:
        return

    slots = getattr(action, "slots", None)

    if slots is None:
        return

    slot = None

    # Try to restore the previous slot.
    if preferred_identifier:
        slot = next(
            (
                s for s in slots
                if s.identifier == preferred_identifier
            ),
            None
        )

    # Find an existing suitable slot.
    if slot is None:
        suitable = getattr(anim, "action_suitable_slots", None)

        if suitable is not None:
            try:
                slot = next(iter(suitable), None)
            except Exception:
                slot = None

    # Create a slot if necessary.
    if slot is None:
        try:
            slot = slots.new(
                id_type='OBJECT',
                name=obj.name
            )
        except Exception as exc:
            print(
                f"[Combined Tools] "
                f"Could not create Action Slot: {exc}"
            )
            return

    try:
        anim.action_slot = slot
    except Exception as exc:
        print(
            f"[Combined Tools] "
            f"Could not assign Action Slot: {exc}"
        )


