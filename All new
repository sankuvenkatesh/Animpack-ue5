class VIEW3D_PT_gizmo_panel(bpy.types.Panel):

    """Gizmo size controls"""

    bl_label = "Gizmo Tools"
    bl_idname = "VIEW3D_PT_gizmo_panel"

    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Tool"

    def draw(self, context):

        layout = self.layout

        view = context.preferences.view

        if not hasattr(view, "gizmo_size"):

            layout.label(
                text="Gizmo size unavailable",
                icon='ERROR'
            )

            return

        layout.label(
            text="Gizmo Size"
        )

        row = layout.row(align=True)

        row.operator(
            "view3d.gizmo_smaller",
            text="-"
        )

        row.prop(
            view,
            "gizmo_size",
            text=""
        )

        row.operator(
            "view3d.gizmo_bigger",
            text="+"
        )

        layout.operator(
            "view3d.open_gizmo_prefs",
            icon='PREFERENCES'
        )


