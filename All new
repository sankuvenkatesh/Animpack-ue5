def _draw_undo_redo(layout):

    row = layout.row(align=True)

    row.operator(
        "ed.undo",
        text="",
        icon='LOOP_BACK'
    )

    row.operator(
        "ed.redo",
        text="",
        icon='LOOP_FORWARDS'
    )


def _draw_range_button(layout, context):

    if get_active_action(context) is not None:

        layout.operator(
            "anim.action_to_scene_range",
            text="",
            icon='TIME'
        )


def _draw_action_selector(layout, context):

    obj = get_active_object(context)

    if obj is None:
        return

    anim = obj.animation_data

    if anim is None:

        layout.operator(
            "anim.new_action",
            text="New Action",
            icon='ADD'
        )

        return

    layout.template_ID(
        anim,
        "action",
        new="anim.new_action"
    )

    # Blender 4.4+ Action Slot selector.
    if (
        anim.action is not None
        and hasattr(anim, "action_slot")
        and hasattr(anim, "action_suitable_slots")
    ):

        layout.prop_search(
            anim,
            "action_slot",
            anim,
            "action_suitable_slots",
            text=""
        )


def cagt_draw_dopesheet_header(self, context):

    mode = context.space_data.mode

    if mode not in {
        'TIMELINE',
        'DOPESHEET',
        'ACTION',
        'SHAPEKEY'
    }:
        return

    layout = self.layout

    layout.separator()

    if mode == 'DOPESHEET':

        _draw_action_selector(
            layout,
            context
        )

    _draw_undo_redo(layout)

    _draw_range_button(
        layout,
        context
    )


def cagt_draw_graph_header(self, context):

    layout = self.layout

    layout.separator()

    _draw_action_selector(
        layout,
        context
    )

    _draw_undo_redo(layout)

    _draw_range_button(
        layout,
        context
    )


def cagt_draw_paste_connect(self, context):

    layout = self.layout

    layout.separator()

    layout.operator(
        PASTE_CONNECT.bl_idname,
        icon='PASTEDOWN'
    )


