# PASTE CONNECT
# ============================================================

_value_offset_name = None


def paste_value_offset_item():

    """
    Detect the current-frame-value option from
    Graph Editor Paste RNA properties.

    Only successful lookups are cached.
    """

    global _value_offset_name

    if _value_offset_name is not None:
        return _value_offset_name

    try:

        prop = (
            bpy.ops.graph.paste
            .get_rna_type()
            .properties["value_offset"]
        )

        names = [
            item.identifier
            for item in prop.enum_items
        ]

    except Exception:

        return None

    candidates = (
        "CURRENT_FRAME_VALUE",
        "CURRENT_FRAME",
        "CFRA",
    )

    found = next(
        (
            name for name in candidates
            if name in names
        ),
        None
    )

    if found is None:

        found = next(
            (
                name for name in names
                if "FRAME" in name
            ),
            None
        )

    if found is not None:
        _value_offset_name = found

    return found


class PASTE_CONNECT(bpy.types.Operator):

    """
    Paste copied keyframes while connecting the
    first pasted key to the current curve value.
    """

    bl_idname = "pasteconnect.pasteconnect"
    bl_label = "Paste Connect"

    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):

        return (
            context.area is not None
            and context.area.type == 'GRAPH_EDITOR'
        )

    def execute(self, context):

        value_offset = paste_value_offset_item()

        if value_offset is None:

            self.report(
                {'WARNING'},
                "Current Frame Value option is unavailable"
            )

            return {'CANCELLED'}

        try:

            result = bpy.ops.graph.paste(
                offset='START',
                value_offset=value_offset,
                merge='OVER_RANGE',
                flipped=False,
            )

        except (RuntimeError, TypeError) as exc:

            self.report(
                {'WARNING'},
                f"Paste Connect failed: {exc}"
            )

            return {'CANCELLED'}

        if 'FINISHED' not in result:
            return {'CANCELLED'}

        return {'FINISHED'}


