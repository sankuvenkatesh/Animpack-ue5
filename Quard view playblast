def register_temp_folder(folder):
    """Register temporary folders for auto-cleanup on exit."""
    if folder not in _TEMP_FOLDERS:
        _TEMP_FOLDERS.add(folder)

def cleanup_all_temp_folders():
    """Automatically clean up all registered temp folders when Blender closes."""
    for folder in _TEMP_FOLDERS:
        clean_folder(folder)

atexit.register(cleanup_all_temp_folders)


def get_view3d_area(context):
    area = getattr(context, "area", None)
    if area and area.type == 'VIEW_3D':
        return area
    screen = getattr(context, "screen", None)
    if screen:
        for candidate in screen.areas:
            if candidate.type == 'VIEW_3D':
                return candidate
    return None


def get_window_region(area):
    if area:
        for region in area.regions:
            if region.type == 'WINDOW' and region.width > 0 and region.height > 0:
                return region
    return None


def get_viewport_capture_rect(area, window):
    if area is None or window is None:
        return None
    win_regions = [
        r for r in area.regions
        if r.type == 'WINDOW' and r.width > 0 and r.height > 0
    ]
    if not win_regions:
        return None

    min_x = max(0, min(int(r.x) for r in win_regions))
    min_y = max(0, min(int(r.y) for r in win_regions))
    max_x = min(int(window.width), max(int(r.x + r.width) for r in win_regions))
    max_y = min(int(window.height), max(int(r.y + r.height) for r in win_regions))

    if max_x <= min_x or max_y <= min_y:
        return None
    return ((min_x, min_y), (max_x, max_y))


def hide_viewport_ui(space, shading_mode=None, hide_overlays=True):
    old_settings = {}
    if space is None:
        return old_settings

    if shading_mode is not None and hasattr(space, "shading"):
        old_settings["shading"] = space.shading.type
        space.shading.type = shading_mode

    if hide_overlays and hasattr(space, "overlay"):
        old_settings["overlays"] = space.overlay.show_overlays
        space.overlay.show_overlays = False

    for name in (
        "show_region_ui",
        "show_region_toolbar",
        "show_gizmo",
        "show_region_header",
    ):
        if hasattr(space, name):
            old_settings[name] = getattr(space, name)
            setattr(space, name, False)

    return old_settings


def restore_viewport_ui(space, old_settings):
    if space is None or not old_settings:
        return
    for name, value in old_settings.items():
        try:
            if name == "shading":
                space.shading.type = value
            elif name == "overlays":
                space.overlay.show_overlays = value
            else:
                setattr(space, name, value)
        except Exception:
            pass


def ensure_folder(path):
    if path:
        os.makedirs(path, exist_ok=True)


def safe_remove_timer(wm, timer):
    if wm and timer:
        try:
            wm.event_timer_remove(timer)
        except Exception:
            pass


def resolve_user_path(filepath, default_name="quadview_render.mp4", is_image=False):
    # Image ayithe "_screenshot", lekapothe "_playblast" ani fix chestundi
    suffix = "_screenshot" if is_image else "_playblast"
    
    # Automatic ga .blend file name extract cheyadam
    if bpy.data.filepath:
        blend_name = os.path.splitext(bpy.path.basename(bpy.data.filepath))[0]
        auto_name = blend_name + suffix
    else:
        auto_name = "quadview" + suffix

    raw = (filepath or "").strip()
    
    # User path change cheyakapothe (default unte), auto_name apply cheyadam
    if raw in ("", "//", "//quadview_render.mp4", "//quadview_render"):
        raw = "//" + auto_name

    # File inka save cheyakapothe temp folder ki route cheyadam
    if raw.startswith("//") and not bpy.data.filepath:
        rel = raw[2:].lstrip("/\\") or auto_name
        return os.path.join(tempfile.gettempdir(), rel)

    resolved = bpy.path.abspath(raw)
    if not os.path.isabs(resolved):
        resolved = os.path.join(tempfile.gettempdir(), resolved)
    return resolved


def get_output_path(filepath):
    resolved = resolve_user_path(filepath, "quadview_render.mp4", is_image=False)
    root, _ext = os.path.splitext(resolved)
    return (root or resolved) + ".mp4"


def get_temp_folder(output_path):
    folder = os.path.splitext(output_path)[0] + "_temp"
    register_temp_folder(folder)
    return folder


def clean_folder(path):
    if path and os.path.isdir(path):
        try:
            shutil.rmtree(path)
        except Exception:
            pass


def get_frame_files(folder):
    if not os.path.isdir(folder):
        return []
    pattern = re.compile(r"^quadview_frame_(\d+)\.png$", re.IGNORECASE)
    found = []
    for filename in os.listdir(folder):
        match = pattern.match(filename)
        if match:
            found.append((int(match.group(1)), filename))
    found.sort(key=lambda item: item[0])
    return [filename for _number, filename in found]


def wait_for_file(filepath, timeout=4.0):
    start = time.monotonic()
    previous_size = -1
    stable = 0
    while time.monotonic() - start < timeout:
        try:
            if os.path.isfile(filepath):
                size = os.path.getsize(filepath)
                if size > 0 and size == previous_size:
                    stable += 1
                    if stable >= 2:
                        return True
                else:
                    stable = 0
                    previous_size = size
        except Exception:
            pass
        time.sleep(0.05)
    return False


def capture_viewport_png(context, area, filepath):
    window = context.window
    region = get_window_region(area)
    if window is None or region is None:
        raise RuntimeError("No active window or VIEW_3D WINDOW region")

    try:
        area.tag_redraw()
        with context.temp_override(
            window=window, screen=context.screen, area=area, region=region
        ):
            bpy.ops.wm.redraw_timer(type='DRAW_WIN_SWAP', iterations=1)
    except Exception:
        pass

    primary_error = None

    try:
        import imbuf
        rect = get_viewport_capture_rect(area, window)
        if rect is None:
            raise RuntimeError("Could not compute VIEW_3D capture rectangle")

        pixels = window.screenshot(region=rect, use_alpha=False)
        height = int(pixels.shape[0])
        width = int(pixels.shape[1])
        if width <= 0 or height <= 0:
            raise RuntimeError("Window screenshot returned an empty image")

        ibuf = imbuf.new((width, height))
        try:
            ibuf.file_type = 'PNG'
            with ibuf.with_buffer(write=True) as buffer:
                buffer.cast('B')[:] = pixels.cast('B')
            imbuf.write(ibuf, filepath=filepath)
        finally:
            try:
                ibuf.free()
            except Exception:
                pass

        if os.path.isfile(filepath) and os.path.getsize(filepath) > 0:
            return
        raise RuntimeError("Window.screenshot did not write a valid PNG")
    except Exception as exc:
        primary_error = exc

    try:
        with context.temp_override(
            window=window,
            screen=context.screen,
            area=area,
            region=region,
        ):
            result = bpy.ops.screen.screenshot_area(
                filepath=filepath,
                check_existing=False,
            )
        if result and 'FINISHED' in result and wait_for_file(filepath):
            return
        raise RuntimeError("screenshot_area returned {}".format(result))
    except Exception as fallback_error:
        raise RuntimeError(
            "Both screenshot methods failed. Window.screenshot: {}; "
            "screenshot_area: {}".format(primary_error, fallback_error)
        )


def image_dimensions(filepath):
    try:
        import imbuf
        ibuf = imbuf.load(filepath)
        try:
            return int(ibuf.size[0]), int(ibuf.size[1])
        finally:
            try:
                ibuf.free()
            except Exception:
                pass
    except Exception:
        pass

    image = None
    try:
        image = bpy.data.images.load(filepath, check_existing=False)
        return int(image.size[0]), int(image.size[1])
    finally:
        if image:
            try:
                bpy.data.images.remove(image)
            except Exception:
                pass


def resolve_imbuf_file_type(imbuf_mod, image_format, target_ext):
    file_types = getattr(imbuf_mod, "file_types", None)
    if not file_types:
        return image_format

    ft = file_types.get(image_format)
    if ft is not None and getattr(ft, "has_write_file", True):
        return image_format

    ext_lower = (target_ext or "").lower()
    for type_id, info in file_types.items():
        if not getattr(info, "has_write_file", False):
            continue
        exts = tuple(e.lower() for e in getattr(info, "file_extensions", ()))
        if ext_lower and ext_lower in exts:
            return type_id

    return image_format


def convert_png(context, source_png, target_path, image_format, quality):
    quality = max(0, min(100, int(quality)))
    if image_format == 'PNG':
        shutil.copy2(source_png, target_path)
        return os.path.isfile(target_path) and os.path.getsize(target_path) > 0

    try:
        import imbuf
        ibuf = imbuf.load(source_png)
        try:
            ext = os.path.splitext(target_path)[1]
            ibuf.file_type = resolve_imbuf_file_type(imbuf, image_format, ext)
            if image_format in {'JPEG', 'BMP'}:
                ibuf.planes = 24
            if image_format == 'JPEG':
                ibuf.quality = quality
            imbuf.write(ibuf, filepath=target_path)
        finally:
            try:
                ibuf.free()
            except Exception:
                pass
        if os.path.isfile(target_path) and os.path.getsize(target_path) > 0:
            return True
    except Exception:
        pass

    image = None
    try:
        image = bpy.data.images.load(source_png, check_existing=False)
        image.filepath_raw = target_path
        image.file_format = image_format
        image.save()
        return os.path.isfile(target_path) and os.path.getsize(target_path) > 0
    finally:
        if image:
            try:
                bpy.data.images.remove(image)
            except Exception:
                pass


def quality_to_crf_enum(quality):
    quality = max(0, min(100, int(quality)))
    if quality >= 95:
        return 'PERC_LOSSLESS'
    if quality >= 80:
        return 'HIGH'
    if quality >= 55:
        return 'MEDIUM'
    if quality >= 35:
        return 'LOW'
    if quality >= 15:
        return 'VERY_LOW'
    return 'LOWEST'


def build_vse_image_sequence(strips, folder, images):
    frame_count = len(images)
    first_path = os.path.join(folder, images[0])

    strip = strips.new_image(
        name="Playblast_Sequence",
        filepath=first_path,
        channel=1,
        frame_start=1,
        fit_method='STRETCH',
    )
    if strip is None:
        raise RuntimeError("Could not create VSE image strip")

    try:
        strip.directory = os.path.join(folder, "")
    except Exception:
        pass

    for filename in images[1:]:
        strip.elements.append(filename)

    strip.frame_final_duration = frame_count
    if hasattr(strip, "update"):
        try:
            strip.update()
        except Exception:
            pass

    seq_ok = (len(strip.elements) == frame_count)
    if seq_ok and frame_count >= 2 and hasattr(strip, "strip_elem_from_frame"):
        try:
            e1 = strip.strip_elem_from_frame(1)
            e2 = strip.strip_elem_from_frame(2)
            if (
                e1 is None or e2 is None
                or e1.filename != images[0]
                or e2.filename != images[1]
            ):
                seq_ok = False
        except Exception:
            pass

    if seq_ok:
        return "sequence"

    strips.remove(strip)
    for index, filename in enumerate(images):
        image_path = os.path.join(folder, filename)
        if not os.path.isfile(image_path):
            raise RuntimeError("Missing captured frame: " + image_path)
        s = strips.new_image(
            name="Playblast_{:04d}".format(index + 1),
            filepath=image_path,
            channel=1,
            frame_start=index + 1,
            fit_method='STRETCH',
        )
        if s is None:
            raise RuntimeError("Could not create fallback VSE strip for " + filename)
        s.frame_final_duration = 1
    return "per_frame"


def find_encoded_video(encode_dir, preferred_path=None):
    if preferred_path:
        try:
            abs_pref = bpy.path.abspath(preferred_path)
            if os.path.isfile(abs_pref) and os.path.getsize(abs_pref) > 0:
                return abs_pref
        except Exception:
            pass

    if not os.path.isdir(encode_dir):
        return None

    found = []
    for entry in os.listdir(encode_dir):
        full = os.path.join(encode_dir, entry)
        if not os.path.isfile(full):
            continue
        size = os.path.getsize(full)
        if size <= 0:
            continue
        ext = os.path.splitext(entry)[1].lower()
        is_video = 1 if ext in _VIDEO_EXTENSIONS else 0
        found.append((is_video, size, full))

    if not found:
        return None
    found.sort(key=lambda item: (item[0], item[1]), reverse=True)
    return found[0][2]


