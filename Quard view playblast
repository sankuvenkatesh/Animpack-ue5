class QP_PT_panel(bpy.types.Panel):
    bl_label = "Playblast Panel"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Playblast"

    def draw(self, context):
        layout = self.layout
        props = context.scene.qp_props

        layout.operator("qp.switch_layout", icon='WINDOW')
        layout.prop(props, "render_filepath")

        row = layout.row(align=True)
        row.operator("qp.screenshot_quadview", icon='IMAGE_DATA')
        row.operator("qp.screenshot_quadview_anim", icon='RENDER_ANIMATION')

        layout.separator()
        layout.label(text="Capture Settings", icon='PREFERENCES')
        layout.prop(props, "image_format")
        layout.prop(props, "video_quality")
        layout.prop(props, "use_ffmpeg")
        layout.prop(props, "frame_step")
        layout.prop(props, "resolution_scale")
        layout.prop(props, "shading_mode")

        if props.is_playblasting:
            box = layout.box()
            box.label(text="PLAYBLAST IN PROGRESS", icon='TIME')
            box.label(text="Press Esc to cancel", icon='INFO')


# ---------------------------------------------------------------------------
# REGISTRATION
# ---------------------------------------------------------------------------

classes = (
    QP_Props,
    QP_OT_switch_layout,
    QP_OT_screenshot_quadview,
    QP_OT_screenshot_quadview_anim,
    QP_OT_combine_images_to_video,
    QP_PT_panel,
)


def register():
    for cls in reversed(classes):
        existing = getattr(bpy.types, cls.__name__, None)
        if existing is not None:
            try:
                bpy.utils.unregister_class(existing)
            except Exception:
                pass

    if hasattr(bpy.types.Scene, "qp_props"):
        try:
            del bpy.types.Scene.qp_props
        except Exception:
            pass

    for cls in classes:
        bpy.utils.register_class(cls)

    bpy.types.Scene.qp_props = PointerProperty(type=QP_Props)
    print("Playblast Quad View 1.9.1 registered for Blender 5.2+")


def unregister():
    global _PLAYBLAST_RUNNING, _ACTIVE_PLAYBLAST_OPERATOR

    operator = _ACTIVE_PLAYBLAST_OPERATOR
    if operator is not None:
        try:
            safe_remove_timer(operator._window_manager, operator._timer)
            operator._timer = None
            operator.restore_state()
            operator.scene.frame_set(operator.original_frame)
            operator.scene.qp_props.is_playblasting = False
        except Exception:
            pass

    _PLAYBLAST_RUNNING = False
    _ACTIVE_PLAYBLAST_OPERATOR = None

    if hasattr(bpy.types.Scene, "qp_props"):
        try:
            del bpy.types.Scene.qp_props
        except Exception:
            pass

    for cls in reversed(classes):
        existing = getattr(bpy.types, cls.__name__, None)
        if existing is not None:
            try:
                bpy.utils.unregister_class(existing)
            except Exception:
                pass

    print("Playblast Quad View unregistered")


if __name__ == "__main__":
    register()
