class QP_OT_screenshot_quadview_anim(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview_anim"
    bl_label = "Playblast Animation"
    bl_description = "Capture the VIEW_3D / Quad View animation"

    _timer = None

    def execute(self, context):

        global _PLAYBLAST_RUNNING

        if _PLAYBLAST_RUNNING:
            self.report({'WARNING'}, "A Playblast is already running")
            return {'CANCELLED'}

        scene = context.scene
        props = scene.qp_props

        area = get_view3d_area(context)

        if area is None:
            self.report({'ERROR'}, "No VIEW_3D area found")
            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:
            self.report({'ERROR'}, "No VIEW_3D window region found")
            return {'CANCELLED'}

        space = area.spaces.active

        self.scene = scene
        self.area = area
        self.region = region
        self.space = space

        self.original_frame = scene.frame_current

        self.start = scene.frame_start
        self.end = scene.frame_end
        self.step = max(1, int(props.frame_step))
        self.frame = self.start
        self.capture_index = 1

        self.output_path = get_output_path(props.render_filepath)
        self.folder = get_temp_folder(self.output_path)

        self._old_shading = None
        self._old_overlays = None
        self._old_ui = None
        self._old_toolbar = None
        self._old_gizmo = None
        self._old_header = None

        try:

            if hasattr(space, "shading"):
                self._old_shading = space.shading.type

            if hasattr(space, "overlay"):
                self._old_overlays = space.overlay.show_overlays

            if hasattr(space, "show_region_ui"):
                self._old_ui = space.show_region_ui

            if hasattr(space, "show_region_toolbar"):
                self._old_toolbar = space.show_region_toolbar

            if hasattr(space, "show_gizmo"):
                self._old_gizmo = space.show_gizmo

            if hasattr(space, "show_region_header"):
                self._old_header = space.show_region_header

        except Exception as exc:
            print("Playblast Quad View: State save warning:", exc)

        try:

            if hasattr(space, "shading"):
                space.shading.type = props.shading_mode

            if hasattr(space, "overlay"):
                space.overlay.show_overlays = False

            if hasattr(space, "show_region_ui"):
                space.show_region_ui = False

            if hasattr(space, "show_region_toolbar"):
                space.show_region_toolbar = False

            if hasattr(space, "show_gizmo"):
                space.show_gizmo = False

            if hasattr(space, "show_region_header"):
                space.show_region_header = False

        except Exception as exc:
            self.report(
                {'WARNING'},
                "Viewport settings warning: {}".format(exc)
            )

        try:

            if os.path.isdir(self.folder):
                shutil.rmtree(self.folder)

            ensure_folder(self.folder)

        except Exception as exc:

            self.restore_state()
            self.report(
                {'ERROR'},
                "Could not create temp folder: {}".format(exc)
            )
            return {'CANCELLED'}

        _PLAYBLAST_RUNNING = True
        props.is_playblasting = True

        try:

            scene.frame_set(self.frame)
            context.view_layer.update()

        except Exception as exc:

            self.finish_capture(context, cancelled=True)
            self.report(
                {'ERROR'},
                "Could not set initial frame: {}".format(exc)
            )
            return {'CANCELLED'}

        try:

            self._timer = context.window_manager.event_timer_add(
                0.10,
                window=context.window
            )

            context.window_manager.modal_handler_add(self)

        except Exception as exc:

            self.finish_capture(context, cancelled=True)
            self.report(
                {'ERROR'},
                "Could not start Playblast timer: {}".format(exc)
            )
            return {'CANCELLED'}

        self.report(
            {'INFO'},
            "Playblast started: {} to {}".format(self.start, self.end)
        )
        return {'RUNNING_MODAL'}

    def modal(self, context, event):

        if event.type == 'ESC':

            self.finish_capture(context, cancelled=True)
            self.report({'WARNING'}, "Playblast cancelled")
            return {'CANCELLED'}

        if event.type != 'TIMER':
            return {'RUNNING_MODAL'}

        if self.frame > self.end:

            self.finish_capture(context, cancelled=False)

            result = bpy.ops.qp.combine_images_to_video()

            if 'FINISHED' in result:
                return {'FINISHED'}

            return {'CANCELLED'}

        try:

            self.scene.frame_set(self.frame)
            context.view_layer.update()

            try:
                self.area.tag_redraw()
            except Exception:
                pass

            try:
                bpy.ops.wm.redraw_timer(
                    type='DRAW_WIN_SWAP',
                    iterations=1
                )
            except Exception:
                pass

        except Exception as exc:

            self.finish_capture(context, cancelled=True)
            self.report(
                {'ERROR'},
                "Frame {} update failed: {}".format(self.frame, exc)
            )
            return {'CANCELLED'}

        filepath = os.path.join(
            self.folder,
            "quadview_frame_{:04d}.png".format(self.capture_index)
        )

        # Remove any stale file.
        try:
            if os.path.isfile(filepath):
                os.remove(filepath)
        except Exception:
            pass

        try:

            with context.temp_override(
                area=self.area,
                region=self.region,
                space_data=self.space
            ):
                result = bpy.ops.screen.screenshot_area(
                    filepath=filepath,
                    check_existing=False
                )

            if 'FINISHED' not in result:
                raise RuntimeError(
                    "screenshot_area returned {}".format(result)
                )

        except Exception as exc:

            print(
                "Playblast Quad View:",
                "Frame {} failed: {}".format(self.frame, exc)
            )

            self.finish_capture(context, cancelled=True)
            self.report(
                {'ERROR'},
                "Could not capture frame {}: {}".format(self.frame, exc)
            )
            return {'CANCELLED'}

        # Ensure the file is actually flushed and readable.
        if not wait_for_file(filepath, timeout=2.0):

            self.finish_capture(context, cancelled=True)
            self.report(
                {'ERROR'},
                "Frame {} file not written".format(self.frame)
            )
            return {'CANCELLED'}

        print(
            "Playblast Quad View: Captured scene frame {} -> {}".format(
                self.frame,
                os.path.basename(filepath)
            )
        )

        self.frame += self.step
        self.capture_index += 1

        return {'RUNNING_MODAL'}

    def restore_state(self):

        space = getattr(self, "space", None)

        if space is None:
            return

        try:

            if (self._old_shading is not None
                    and hasattr(space, "shading")):
                space.shading.type = self._old_shading

            if (self._old_overlays is not None
                    and hasattr(space, "overlay")):
                space.overlay.show_overlays = self._old_overlays

            if (self._old_ui is not None
                    and hasattr(space, "show_region_ui")):
                space.show_region_ui = self._old_ui

            if (self._old_toolbar is not None
                    and hasattr(space, "show_region_toolbar")):
                space.show_region_toolbar = self._old_toolbar

            if (self._old_gizmo is not None
                    and hasattr(space, "show_gizmo")):
                space.show_gizmo = self._old_gizmo

            if (self._old_header is not None
                    and hasattr(space, "show_region_header")):
                space.show_region_header = self._old_header

        except Exception as exc:
            print("Playblast Quad View: Restore warning:", exc)

    def finish_capture(self, context, cancelled=False):

        global _PLAYBLAST_RUNNING

        safe_remove_timer(context.window_manager, self._timer)
        self._timer = None

        self.restore_state()

        try:
            self.scene.frame_set(self.original_frame)
            context.view_layer.update()
        except Exception:
            pass

        try:
            self.scene.qp_props.is_playblasting = False
        except Exception:
            pass

        _PLAYBLAST_RUNNING = False

