def get_view3d_area(context):
    """Find a VIEW_3D area on the current screen."""
    if context.area and context.area.type == 'VIEW_3D':
        return context.area

    if context.screen:
        for area in context.screen.areas:
            if area.type == 'VIEW_3D':
                return area

    return None


def get_window_region(area):
    """Find the WINDOW region of a VIEW_3D area."""
    if area is None:
        return None

    for region in area.regions:
        if region.type == 'WINDOW':
            return region

    return None


def safe_remove_timer(window_manager, timer):
    """Safely remove a Blender event timer."""
    if timer is None:
        return

    try:
        window_manager.event_timer_remove(timer)
    except Exception:
        pass


def ensure_folder(path):
    """Create a folder if it does not exist."""
    if path:
        os.makedirs(path, exist_ok=True)


def clean_folder(path):
    """Delete a temporary folder safely."""
    if not path:
        return

    try:
        if os.path.isdir(path):
            shutil.rmtree(path)
    except Exception as exc:
        print(
            "Playblast Quad View: Failed to remove temp folder:",
            exc
        )


def get_output_path(filepath):
    """
    Resolve and normalize the output path.
    Default is MP4.
    """

    filepath = bpy.path.abspath(filepath)

    if not filepath:
        filepath = bpy.path.abspath(
            "//quadview_render.mp4"
        )

    root, ext = os.path.splitext(filepath)

    if not ext:
        filepath = filepath + ".mp4"

    return filepath


def get_temp_folder(output_path):
    """
    Temporary PNG directory.
    Example:
        //quadview_render.mp4
    becomes:
        //quadview_render_temp/
    """

    root, _ext = os.path.splitext(output_path)

    return root + "_temp"


def get_frame_files(folder):
    """
    Return Playblast PNG files in numerical order.
    """

    if not os.path.isdir(folder):
        return []

    files = []

    for filename in os.listdir(folder):

        if not filename.lower().endswith(".png"):
            continue

        if not filename.startswith("quadview_frame_"):
            continue

        files.append(filename)

    def sort_number(filename):
        try:
            number_text = filename.rsplit("_", 1)[1]
            number_text = os.path.splitext(number_text)[0]
            return int(number_text)
        except Exception:
            return 0

    files.sort(key=sort_number)

    return files


def get_image_resolution(filepath):
    """
    Load one PNG temporarily and return its dimensions.
    """

    image = None

    try:

        image = bpy.data.images.load(
            filepath,
            check_existing=False
        )

        width = int(image.size[0])
        height = int(image.size[1])

        return width, height

    except Exception as exc:

        print(
            "Playblast Quad View: Could not read image size:",
            exc
        )

        return None, None

    finally:

        if image is not None:

            try:
                bpy.data.images.remove(image)
            except Exception:
                pass


# ============================================================================
# PROPERTY GROUP
# ============================================================================

class QP_Props(bpy.types.PropertyGroup):

    render_filepath: StringProperty(
        name="Save Path",
        subtype='FILE_PATH',
        default="//quadview_render.mp4"
    )

    is_quad_active: BoolProperty(
        name="Quad View Active",
        default=False
    )

    is_playblasting: BoolProperty(
        name="Playblast Running",
        default=False
    )

    use_ffmpeg: BoolProperty(
        name="Use FFMPEG Encode",
        default=False
    )

    frame_step: IntProperty(
        name="Frame Step",
        default=1,
        min=1,
        max=10
    )

    resolution_scale: FloatProperty(
        name="Resolution Scale",
        default=1.0,
        min=0.25,
        max=1.0
    )

    shading_mode: EnumProperty(
        name="Viewport Shading",
        items=[
            ('SOLID', "Solid", ""),
            ('MATERIAL', "Material", ""),
            ('RENDERED', "Rendered", ""),
            ('WIREFRAME', "Wireframe", "")
        ],
        default='SOLID'
    )


# ============================================================================
# QUAD VIEW TOGGLE
# ============================================================================

class QP_OT_switch_layout(bpy.types.Operator):

    bl_idname = "qp.switch_layout"
    bl_label = "Toggle Quad View"
    bl_description = "Toggle Quad View in the active 3D Viewport"

    def execute(self, context):

        area = get_view3d_area(context)

        if area is None:

            self.report(
                {'ERROR'},
                "No 3D Viewport found"
            )

            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:

            self.report(
                {'ERROR'},
                "No VIEW_3D window region found"
            )

            return {'CANCELLED'}

        space = area.spaces.active

        try:

            with context.temp_override(
                area=area,
                region=region,
                space_data=space
            ):

                result = bpy.ops.screen.region_quadview()

            if 'FINISHED' in result:

                context.scene.qp_props.is_quad_active = (
                    not context.scene.qp_props.is_quad_active
                )

                self.report(
                    {'INFO'},
                    "Quad View toggled"
                )

                return {'FINISHED'}

            self.report(
                {'ERROR'},
                "Quad View operation failed"
            )

            return {'CANCELLED'}

        except Exception as exc:

            self.report(
                {'ERROR'},
                "Could not toggle Quad View: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}


# ============================================================================
# SINGLE SCREENSHOT
# ============================================================================

class QP_OT_screenshot_quadview(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview"
    bl_label = "Playblast Screenshot"
    bl_description = "Save the current VIEW_3D editor as a PNG"

    def execute(self, context):

        props = context.scene.qp_props

        filepath = bpy.path.abspath(
            props.render_filepath
        )

        # --------------------------------------------------------------
        # Always save screenshot as image.
        # --------------------------------------------------------------

        root, ext = os.path.splitext(filepath)

        if ext.lower() not in {
            ".png",
            ".jpg",
            ".jpeg",
            ".bmp",
            ".tga",
            ".tif",
            ".tiff"
        }:

            filepath = root + ".png"

        directory = os.path.dirname(filepath)

        if directory:
            ensure_folder(directory)

        area = get_view3d_area(context)

        if area is None:

            self.report(
                {'ERROR'},
                "No VIEW_3D area found"
            )

            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:

            self.report(
                {'ERROR'},
                "No VIEW_3D window region found"
            )

            return {'CANCELLED'}

        try:

            with context.temp_override(
                area=area,
                region=region,
                space_data=area.spaces.active
            ):

                result = bpy.ops.screen.screenshot_area(
                    filepath=filepath,
                    check_existing=False
                )

            if 'FINISHED' not in result:

                self.report(
                    {'ERROR'},
                    "Screenshot operation failed"
                )

                return {'CANCELLED'}

            if not os.path.isfile(filepath):

                self.report(
                    {'ERROR'},
                    "Screenshot file was not created"
                )

                return {'CANCELLED'}

        except Exception as exc:

            self.report(
                {'ERROR'},
                "Screenshot failed: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}

        self.report(
            {'INFO'},
            "Screenshot saved: {}".format(
                filepath
            )
        )

        return {'FINISHED'}


# ============================================================================
# PLAYBLAST ANIMATION CAPTURE
# ============================================================================

class QP_OT_screenshot_quadview_anim(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview_anim"
    bl_label = "Playblast Animation"
    bl_description = "Capture the VIEW_3D / Quad View animation"

    _timer = None

    def execute(self, context):

        global _PLAYBLAST_RUNNING

        if _PLAYBLAST_RUNNING:

            self.report(
                {'WARNING'},
                "A Playblast is already running"
            )

            return {'CANCELLED'}

        scene = context.scene
        props = scene.qp_props

        area = get_view3d_area(context)

        if area is None:

            self.report(
                {'ERROR'},
                "No VIEW_3D area found"
            )

            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:

            self.report(
                {'ERROR'},
                "No VIEW_3D window region found"
            )

            return {'CANCELLED'}

        space = area.spaces.active

        # --------------------------------------------------------------
        # Store references.
        # --------------------------------------------------------------

        self.scene = scene
        self.area = area
        self.region = region
        self.space = space

        # --------------------------------------------------------------
        # Store frame state.
        # --------------------------------------------------------------

        self.original_frame = scene.frame_current

        self.start = scene.frame_start
        self.end = scene.frame_end
        self.step = max(
            1,
            int(props.frame_step)
        )

        self.frame = self.start

        # Sequential output index.
        #
        # IMPORTANT:
        # This must NOT use the original scene frame number because
        # frame_step can skip frames. Sequential numbering guarantees
        # FFMPEG and VSE can read the image sequence correctly.
        # --------------------------------------------------------------

        self.capture_index = 1

        # --------------------------------------------------------------
        # Output paths.
        # --------------------------------------------------------------

        self.output_path = get_output_path(
            props.render_filepath
        )

        self.folder = get_temp_folder(
            self.output_path
        )

        # --------------------------------------------------------------
        # Save viewport state.
        # --------------------------------------------------------------

        self._old_shading = None
        self._old_overlays = None
        self._old_ui = None
        self._old_toolbar = None
        self._old_gizmo = None

        try:

            if hasattr(space, "shading"):
                self._old_shading = (
                    space.shading.type
                )

            if hasattr(space, "overlay"):
                self._old_overlays = (
                    space.overlay.show_overlays
                )

            if hasattr(space, "show_region_ui"):
                self._old_ui = (
                    space.show_region_ui
                )

            if hasattr(space, "show_region_toolbar"):
                self._old_toolbar = (
                    space.show_region_toolbar
                )

            if hasattr(space, "show_gizmo"):
                self._old_gizmo = (
                    space.show_gizmo
                )

        except Exception as exc:

            print(
                "Playblast Quad View: State save warning:",
                exc
            )

        # --------------------------------------------------------------
        # Configure viewport.
        # --------------------------------------------------------------

        try:

            if hasattr(space, "shading"):

                space.shading.type = (
                    props.shading_mode
                )

            if hasattr(space, "overlay"):

                space.overlay.show_overlays = False

            if hasattr(space, "show_region_ui"):

                space.show_region_ui = False

            if hasattr(space, "show_region_toolbar"):

                space.show_region_toolbar = False

            if hasattr(space, "show_gizmo"):

                space.show_gizmo = False

        except Exception as exc:

            self.report(
                {'WARNING'},
                "Viewport settings warning: {}".format(
                    exc
                )
            )

        # --------------------------------------------------------------
        # Prepare temporary folder.
        # --------------------------------------------------------------

        try:

            if os.path.isdir(self.folder):

                shutil.rmtree(
                    self.folder
                )

            ensure_folder(
                self.folder
            )

        except Exception as exc:

            self.restore_state()

            self.report(
                {'ERROR'},
                "Could not create temp folder: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}

        # --------------------------------------------------------------
        # Mark running.
        # --------------------------------------------------------------

        _PLAYBLAST_RUNNING = True

        props.is_playblasting = True

        # --------------------------------------------------------------
        # Initial frame.
        # --------------------------------------------------------------

        try:

            scene.frame_set(
                self.frame
            )

            context.view_layer.update()

        except Exception as exc:

            self.finish_capture(
                context,
                cancelled=True
            )

            self.report(
                {'ERROR'},
                "Could not set initial frame: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}

        # --------------------------------------------------------------
        # Start timer.
        # --------------------------------------------------------------

        try:

            self._timer = (
                context.window_manager.event_timer_add(
                    0.10,
                    window=context.window
                )
            )

            context.window_manager.modal_handler_add(
                self
            )

        except Exception as exc:

            self.finish_capture(
                context,
                cancelled=True
            )

            self.report(
                {'ERROR'},
                "Could not start Playblast timer: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}

        self.report(
            {'INFO'},
            "Playblast started: {} to {}".format(
                self.start,
                self.end
            )
        )

        return {'RUNNING_MODAL'}

    # ----------------------------------------------------------------------
    # MODAL
    # ----------------------------------------------------------------------

    def modal(self, context, event):

        if event.type == 'ESC':

            self.finish_capture(
                context,
                cancelled=True
            )

            self.report(
                {'WARNING'},
                "Playblast cancelled"
            )

            return {'CANCELLED'}

        if event.type != 'TIMER':

            return {'RUNNING_MODAL'}

        # --------------------------------------------------------------
        # Finished capture.
        # --------------------------------------------------------------

        if self.frame > self.end:

            self.finish_capture(
                context,
                cancelled=False
            )

            # Encode captured images.
            result = bpy.ops.qp.combine_images_to_video()

            if 'FINISHED' in result:

                return {'FINISHED'}

            return {'CANCELLED'}

        # --------------------------------------------------------------
        # Change animation frame.
        # --------------------------------------------------------------

        try:

            self.scene.frame_set(
                self.frame
            )

            context.view_layer.update()

            # Force the viewport to redraw.
            try:

                self.area.tag_redraw()

            except Exception:
                pass

            # Blender redraw helper.
            try:

                bpy.ops.wm.redraw_timer(
                    type='DRAW_WIN_SWAP',
                    iterations=1
                )

            except Exception:
                pass

        except Exception as exc:

            self.finish_capture(
                context,
                cancelled=True
            )

            self.report(
                {'ERROR'},
                "Frame {} update failed: {}".format(
                    self.frame,
                    exc
                )
            )

            return {'CANCELLED'}

        # --------------------------------------------------------------
        # Sequential image filename.
        # --------------------------------------------------------------

        filepath = os.path.join(
            self.folder,
            "quadview_frame_{:04d}.png".format(
                self.capture_index
            )
        )

        # --------------------------------------------------------------
        # Screenshot current VIEW_3D editor.
        # --------------------------------------------------------------

        try:

            with context.temp_override(
                area=self.area,
                region=self.region,
                space_data=self.space
            ):

                result = bpy.ops.screen.screenshot_area(
                    filepath=filepath,
                    check_existing=False
                )

            if 'FINISHED' not in result:

                raise RuntimeError(
                    "screenshot_area returned {}".format(
                        result
                    )
                )

            if not os.path.isfile(filepath):

                raise RuntimeError(
                    "Screenshot file was not created"
                )

        except Exception as exc:

            print(
                "Playblast Quad View:",
                "Frame {} failed: {}".format(
                    self.frame,
                    exc
                )
            )

            self.finish_capture(
                context,
                cancelled=True
            )

            self.report(
                {'ERROR'},
                "Could not capture frame {}: {}".format(
                    self.frame,
                    exc
                )
            )

            return {'CANCELLED'}

        print(
            "Playblast Quad View: Captured scene frame {} -> {}".format(
                self.frame,
                os.path.basename(filepath)
            )
        )

        # --------------------------------------------------------------
        # Advance.
        # --------------------------------------------------------------

        self.frame += self.step
        self.capture_index += 1

        return {'RUNNING_MODAL'}

    # ----------------------------------------------------------------------
    # RESTORE VIEWPORT
    # ----------------------------------------------------------------------

    def restore_state(self):

        space = getattr(
            self,
            "space",
            None
        )

        if space is None:
            return

        try:

            if (
                self._old_shading is not None
                and hasattr(space, "shading")
            ):

                space.shading.type = (
                    self._old_shading
                )

            if (
                self._old_overlays is not None
                and hasattr(space, "overlay")
            ):

                space.overlay.show_overlays = (
                    self._old_overlays
                )

            if (
                self._old_ui is not None
                and hasattr(space, "show_region_ui")
            ):

                space.show_region_ui = (
                    self._old_ui
                )

            if (
                self._old_toolbar is not None
                and hasattr(space, "show_region_toolbar")
            ):

                space.show_region_toolbar = (
                    self._old_toolbar
                )

            if (
                self._old_gizmo is not None
                and hasattr(space, "show_gizmo")
            ):

                space.show_gizmo = (
                    self._old_gizmo
                )

        except Exception as exc:

            print(
                "Playblast Quad View: Restore warning:",
                exc
            )

    # ----------------------------------------------------------------------
    # FINISH CAPTURE
    # ----------------------------------------------------------------------

    def finish_capture(
        self,
        context,
        cancelled=False
    ):

        global _PLAYBLAST_RUNNING

        # --------------------------------------------------------------
        # Remove timer.
        # --------------------------------------------------------------

        safe_remove_timer(
            context.window_manager,
            self._timer
        )

        self._timer = None

        # --------------------------------------------------------------
        # Restore viewport state.
        # --------------------------------------------------------------

        self.restore_state()

        # --------------------------------------------------------------
        # Restore original frame.
        # --------------------------------------------------------------

        try:

            self.scene.frame_set(
                self.original_frame
            )

            context.view_layer.update()

        except Exception:
            pass

        # --------------------------------------------------------------
        # Update properties.
        # --------------------------------------------------------------

        try:

            self.scene.qp_props.is_playblasting = False

        except Exception:
            pass

        _PLAYBLAST_RUNNING = False


# ============================================================================
# COMBINE IMAGES TO VIDEO
# ============================================================================

class QP_OT_combine_images_to_video(bpy.types.Operator):

    bl_idname = "qp.combine_images_to_video"
    bl_label = "Combine Images to Video"
    bl_description = "Encode the captured PNG sequence into a movie"

    def execute(self, context):

        props = context.scene.qp_props

        output_path = get_output_path(
            props.render_filepath
        )

        folder = get_temp_folder(
            output_path
        )

        # --------------------------------------------------------------
        # Find images.
        # --------------------------------------------------------------

        images = get_frame_files(
            folder
        )

        if not images:

            self.report(
                {'ERROR'},
                "No Playblast PNG frames were found"
            )

            return {'CANCELLED'}

        print(
            "Playblast Quad View: Found {} image frames".format(
                len(images)
            )
        )

        # --------------------------------------------------------------
        # Calculate FPS.
        # --------------------------------------------------------------

        scene = context.scene

        fps = float(scene.render.fps)

        if scene.render.fps_base != 0:

            fps = (
                fps /
                float(scene.render.fps_base)
            )

        if fps <= 0:

            fps = 24.0

        # --------------------------------------------------------------
        # External FFMPEG.
        # --------------------------------------------------------------

        if props.use_ffmpeg:

            ffmpeg_path = shutil.which(
                "ffmpeg"
            )

            if ffmpeg_path is not None:

                ffmpeg_result = self.encode_with_ffmpeg(
                    context,
                    ffmpeg_path,
                    output_path,
                    folder,
                    fps
                )

                if ffmpeg_result:

                    clean_folder(folder)

                    return {'FINISHED'}

                self.report(
                    {'WARNING'},
                    "FFMPEG failed. Trying Blender VSE."
                )

            else:

                self.report(
                    {'WARNING'},
                    "FFMPEG executable not found. "
                    "Trying Blender VSE."
                )

        # --------------------------------------------------------------
        # Blender 5.1 VSE.
        # --------------------------------------------------------------

        return self.encode_with_vse(
            context,
            output_path,
            folder,
            images
        )

    # ----------------------------------------------------------------------
    # FFMPEG
    # ----------------------------------------------------------------------

    def encode_with_ffmpeg(
        self,
        context,
        ffmpeg_path,
        output_path,
        folder,
        fps
    ):

        input_pattern = os.path.join(
            folder,
            "quadview_frame_%04d.png"
        )

        command = [
            ffmpeg_path,
            "-y",
            "-framerate",
            "{:.6f}".format(fps),
            "-i",
            input_pattern,
            "-c:v",
            "libx264",
            "-pix_fmt",
            "yuv420p",
        ]

        # --------------------------------------------------------------
        # Resolution scaling.
        # --------------------------------------------------------------

        scale = context.scene.qp_props.resolution_scale

        if scale < 0.999:

            scale_filter = (
                "scale="
                "trunc(iw*{}/2)*2:"
                "trunc(ih*{}/2)*2"
            ).format(
                scale,
                scale
            )

            command.extend([
                "-vf",
                scale_filter
            ])

        command.extend([
            "-movflags",
            "+faststart",
            output_path
        ])

        print(
            "Playblast Quad View: Running FFMPEG..."
        )

        try:

            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )

        except Exception as exc:

            print(
                "FFMPEG execution error:",
                exc
            )

            return False

        if result.returncode != 0:

            print(
                "FFMPEG stderr:"
            )

            print(
                result.stderr
            )

            return False

        if not os.path.isfile(output_path):

            print(
                "FFMPEG reported success but output file "
                "does not exist."
            )

            return False

        print(
            "Playblast Quad View: FFMPEG video created:",
            output_path
        )

        self.report(
            {'INFO'},
            "Video created with FFMPEG"
        )

        return True

    # ----------------------------------------------------------------------
    # BLENDER 5.1 VSE
    # ----------------------------------------------------------------------

    def encode_with_vse(
        self,
        context,
        output_path,
        folder,
        images
    ):

        scene = context.scene

        # --------------------------------------------------------------
        # Save render state.
        # --------------------------------------------------------------

        old_filepath = scene.render.filepath

        old_file_format = (
            scene.render.image_settings.file_format
        )

        old_resolution_x = scene.render.resolution_x
        old_resolution_y = scene.render.resolution_y
        old_resolution_percentage = (
            scene.render.resolution_percentage
        )

        old_fps = scene.render.fps
        old_fps_base = scene.render.fps_base

        old_frame_start = scene.frame_start
        old_frame_end = scene.frame_end

        # Save whether scene had a sequence editor.
        had_sequence_editor = (
            scene.sequence_editor is not None
        )

        try:

            # ----------------------------------------------------------
            # Get/create sequence editor.
            # ----------------------------------------------------------

            if scene.sequence_editor is None:

                scene.sequence_editor_create()

            seq = scene.sequence_editor

            # ----------------------------------------------------------
            # Blender 5.1 API:
            #
            # seq.strips       -> top-level strips
            # seq.strips_all   -> all strips recursively
            #
            # We remove top-level strips. If a meta-strip exists,
            # removing the top-level meta removes its contents too.
            # ----------------------------------------------------------

            for strip in list(seq.strips):

                try:

                    seq.strips.remove(
                        strip
                    )

                except Exception as exc:

                    print(
                        "Could not remove strip:",
                        strip.name,
                        exc
                    )

            # ----------------------------------------------------------
            # First image.
            # ----------------------------------------------------------

            first_image = os.path.join(
                folder,
                images[0]
            )

            if not os.path.isfile(first_image):

                raise RuntimeError(
                    "First image is missing:\n{}".format(
                        first_image
                    )
                )

            # ----------------------------------------------------------
            # Read source dimensions.
            # ----------------------------------------------------------

            width, height = get_image_resolution(
                first_image
            )

            if width is None or height is None:

                raise RuntimeError(
                    "Unable to determine image resolution"
                )

            print(
                "Playblast Quad View: Image size = {} x {}".format(
                    width,
                    height
                )
            )

            # ----------------------------------------------------------
            # Create Blender 5.1 image strip.
            #
            # This is the important API fix:
            #
            # OLD:
            #     seq.sequences.new_image(...)
            #
            # NEW:
            #     seq.strips.new_image(...)
            # ----------------------------------------------------------

            strip = seq.strips.new_image(
                name="QuadView",
                filepath=first_image,
                channel=1,
                frame_start=1
            )

            if strip is None:

                raise RuntimeError(
                    "Blender failed to create the image strip"
                )

            # ----------------------------------------------------------
            # Add remaining images.
            # ----------------------------------------------------------

            for filename in images[1:]:

                image_path = os.path.join(
                    folder,
                    filename
                )

                if not os.path.isfile(image_path):

                    raise RuntimeError(
                        "Missing Playblast image:\n{}".format(
                            image_path
                        )
                    )

                # StripElements.append expects the filename
                # relative to the image strip directory.
                strip.elements.append(
                    filename
                )

            # ----------------------------------------------------------
            # Number of video frames.
            # ----------------------------------------------------------

            frame_count = len(images)

            # ----------------------------------------------------------
            # Resolution scale.
            # ----------------------------------------------------------

            scale = float(
                context.scene.qp_props.resolution_scale
            )

            if scale <= 0:
                scale = 1.0

            output_width = int(
                width * scale
            )

            output_height = int(
                height * scale
            )

            # H.264 requires even dimensions.
            output_width -= (
                output_width % 2
            )

            output_height -= (
                output_height % 2
            )

            output_width = max(
                2,
                output_width
            )

            output_height = max(
                2,
                output_height
            )

            scene.render.resolution_x = (
                output_width
            )

            scene.render.resolution_y = (
                output_height
            )

            scene.render.resolution_percentage = 100

            # ----------------------------------------------------------
            # Video format.
            # ----------------------------------------------------------

            scene.render.image_settings.file_format = (
                'FFMPEG'
            )

            # These properties are standard Blender movie settings.
            scene.render.ffmpeg.format = 'MPEG4'
            scene.render.ffmpeg.codec = 'H264'

            # ----------------------------------------------------------
            # Output.
            # ----------------------------------------------------------

            scene.render.filepath = output_path

            # ----------------------------------------------------------
            # Keep original FPS.
            # ----------------------------------------------------------

            scene.render.fps = old_fps
            scene.render.fps_base = old_fps_base

            # ----------------------------------------------------------
            # Render only the generated image sequence.
            # ----------------------------------------------------------

            scene.frame_start = 1
            scene.frame_end = frame_count

            # ----------------------------------------------------------
            # Make VSE the source.
            # ----------------------------------------------------------

            scene.render.use_sequencer = True

            # ----------------------------------------------------------
            # Refresh sequence editor.
            # ----------------------------------------------------------

            try:

                bpy.ops.sequencer.refresh_all()

            except Exception:
                pass

            # ----------------------------------------------------------
            # Force strip information to update.
            # ----------------------------------------------------------

            try:

                context.view_layer.update()

            except Exception:
                pass

            # ----------------------------------------------------------
            # Render VSE animation.
            # ----------------------------------------------------------

            print(
                "Playblast Quad View: Rendering VSE video..."
            )

            result = bpy.ops.render.render(
                animation=True,
                sequencer=True
            )

            if 'FINISHED' not in result:

                raise RuntimeError(
                    "VSE render returned: {}".format(
                        result
                    )
                )

            # ----------------------------------------------------------
            # Verify output.
            # ----------------------------------------------------------

            if not os.path.isfile(output_path):

                raise RuntimeError(
                    "Blender completed the render operation, "
                    "but the video file was not created:\n{}".format(
                        output_path
                    )
                )

            print(
                "Playblast Quad View: Video created:",
                output_path
            )

            self.report(
                {'INFO'},
                "Video created successfully"
            )

            return {'FINISHED'}

        except Exception as exc:

            print(
                "=================================================="
            )

            print(
                "Playblast Quad View VSE ERROR:"
            )

            print(
                repr(exc)
            )

            print(
                "=================================================="
            )

            self.report(
                {'ERROR'},
                "VSE encoding failed: {}".format(
                    exc
                )
            )

            return {'CANCELLED'}

        finally:

            # ----------------------------------------------------------
            # Restore scene render settings.
            # ----------------------------------------------------------

            try:

                scene.render.filepath = (
                    old_filepath
                )

                scene.render.image_settings.file_format = (
                    old_file_format
                )

                scene.render.resolution_x = (
                    old_resolution_x
                )

                scene.render.resolution_y = (
                    old_resolution_y
                )

                scene.render.resolution_percentage = (
                    old_resolution_percentage
                )

                scene.render.fps = old_fps
                scene.render.fps_base = old_fps_base

                scene.frame_start = old_frame_start
                scene.frame_end = old_frame_end

            except Exception as exc:

                print(
                    "Could not restore render settings:",
                    exc
                )

            # ----------------------------------------------------------
            # Delete temporary images only after encoding attempt.
            # ----------------------------------------------------------

            clean_folder(
                folder
            )


# ============================================================================
# UI PANEL
# ============================================================================

class QP_PT_panel(bpy.types.Panel):

    bl_label = "Playblast Panel"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Playblast"

    def draw(self, context):

        layout = self.layout
        props = context.scene.qp_props

        # --------------------------------------------------------------
        # Quad View
        # --------------------------------------------------------------

        row = layout.row()

        row.operator(
            "qp.switch_layout",
            icon='WINDOW'
        )

        # --------------------------------------------------------------
        # Save Path
        # --------------------------------------------------------------

        layout.prop(
            props,
            "render_filepath"
        )

        # --------------------------------------------------------------
        # Screenshot / Animation
        # --------------------------------------------------------------

        row = layout.row(
            align=True
        )

        row.operator(
            "qp.screenshot_quadview",
            icon='IMAGE_DATA'
        )

        row.operator(
            "qp.screenshot_quadview_anim",
            icon='RENDER_ANIMATION'
        )

        # --------------------------------------------------------------
        # Options
        # --------------------------------------------------------------

        layout.separator()

        layout.label(
            text="Extra Options",
            icon='PREFERENCES'
        )

        layout.prop(
            props,
            "use_ffmpeg"
        )

        layout.prop(
            props,
            "frame_step"
        )

        layout.prop(
            props,
            "resolution_scale"
        )

        layout.prop(
            props,
            "shading_mode"
        )

        # --------------------------------------------------------------
        # Status
        # --------------------------------------------------------------

        if props.is_playblasting:

            layout.separator()

            box = layout.box()

            box.label(
                text="PLAYBLAST IN PROGRESS",
                icon='TIME'
            )


# ============================================================================
# REGISTER
# ============================================================================

classes = (
    QP_Props,
    QP_OT_switch_layout,
    QP_OT_screenshot_quadview,
    QP_OT_screenshot_quadview_anim,
    QP_OT_combine_images_to_video,
    QP_PT_panel,
)


def register():

    for cls in classes:
        bpy.utils.register_class(
            cls
        )

    bpy.types.Scene.qp_props = PointerProperty(
        type=QP_Props
    )


def unregister():

    global _PLAYBLAST_RUNNING

    _PLAYBLAST_RUNNING = False

    if hasattr(
        bpy.types.Scene,
        "qp_props"
    ):

        del bpy.types.Scene.qp_props

    for cls in reversed(classes):

        bpy.utils.unregister_class(
            cls
        )


# ============================================================================
# RUN
# ============================================================================

if __name__ == "__main__"q:
    register()
