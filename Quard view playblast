# ============================================================================
# GENERAL HELPERS
# ============================================================================

def get_view3d_area(context):
    area = getattr(context, "area", None)

    if area and area.type == 'VIEW_3D':
        return area

    screen = getattr(context, "screen", None)

    if screen:
        for candidate in screen.areas:
            if candidate.type == 'VIEW_3D':
                return candidate

    return None


def get_window_region(area):
    if area:
        for region in area.regions:
            if region.type == 'WINDOW':
                return region
    return None


def safe_remove_timer(wm, timer):
    if wm and timer:
        try:
            wm.event_timer_remove(timer)
        except Exception:
            pass


def ensure_folder(path):
    if path:
        os.makedirs(path, exist_ok=True)


def clean_folder(path):
    if path and os.path.isdir(path):
        try:
            shutil.rmtree(path)
        except Exception as exc:
            print("Playblast: Temporary cleanup failed:", exc)


def get_output_path(filepath):
    filepath = (filepath or "//quadview_render.mp4").strip()
    filepath = bpy.path.abspath(filepath)

    root, _ = os.path.splitext(filepath)

    return root + ".mp4"


def get_temp_folder(output_path):
    root, _ = os.path.splitext(output_path)
    return root + "_temp"


def get_frame_files(folder):
    if not os.path.isdir(folder):
        return []

    pattern = re.compile(
        r"^quadview_frame_(\d+)\.png$",
        re.IGNORECASE
    )

    found = []

    for filename in os.listdir(folder):
        match = pattern.match(filename)

        if match:
            found.append((int(match.group(1)), filename))

    found.sort(key=lambda item: item[0])

    return [filename for number, filename in found]


def wait_for_file(filepath, timeout=3.0):
    start = time.monotonic()
    previous_size = -1
    stable = 0

    while time.monotonic() - start < timeout:
        try:
            if os.path.isfile(filepath):
                size = os.path.getsize(filepath)

                if size > 0 and size == previous_size:
                    stable += 1

                    if stable >= 2:
                        return True
                else:
                    stable = 0
                    previous_size = size

        except Exception:
            pass

        time.sleep(0.05)

    return False


def capture_area_screenshot(context, area, filepath):
    region = get_window_region(area)

    if area is None or region is None:
        raise RuntimeError("VIEW_3D window region unavailable")

    with context.temp_override(
        window=context.window,
        screen=context.screen,
        area=area,
        region=region,
    ):
        result = bpy.ops.screen.screenshot_area(
            filepath=filepath,
            check_existing=False,
        )

    if 'FINISHED' not in result:
        raise RuntimeError("Screenshot operation failed: {}".format(result))


def get_image_resolution(filepath):
    image = None

    try:
        image = bpy.data.images.load(
            filepath,
            check_existing=False
        )

        return int(image.size[0]), int(image.size[1])

    finally:
        if image:
            bpy.data.images.remove(image)


def save_image_with_settings(
    context,
    source_png,
    target_path,
    image_format,
    quality
):
    scene = context.scene
    settings = scene.render.image_settings

    old = {
        "file_format": settings.file_format,
        "quality": settings.quality,
        "compression": settings.compression,
        "color_mode": settings.color_mode,
    }

    image = None
    success = False

    try:
        settings.file_format = image_format

        try:
            settings.color_mode = 'RGB'
        except Exception:
            pass

        if image_format in {'JPEG', 'TIFF'}:
            settings.quality = int(quality)

        elif image_format == 'PNG':
            settings.compression = max(
                0,
                min(100, 100 - int(quality))
            )

        image = bpy.data.images.load(
            source_png,
            check_existing=False
        )

        image.filepath_raw = target_path
        image.file_format = image_format
        image.save()

        success = (
            os.path.isfile(target_path)
            and os.path.getsize(target_path) > 0
        )

    except Exception as exc:
        print("Playblast image error:", repr(exc))

    finally:
        if image:
            try:
                bpy.data.images.remove(image)
            except Exception:
                pass

        for name, value in old.items():
            try:
                setattr(settings, name, value)
            except Exception:
                pass

    return success


# ============================================================================
# PROPERTIES
# ============================================================================

class QP_Props(bpy.types.PropertyGroup):

    render_filepath: StringProperty(
        name="Save Path",
        subtype='FILE_PATH',
        default="//quadview_render.mp4",
    )

    is_quad_active: BoolProperty(
        name="Quad View Active",
        default=False
    )

    is_playblasting: BoolProperty(
        name="Playblast Running",
        default=False
    )

    use_ffmpeg: BoolProperty(
        name="Use External FFmpeg",
        description="Use external FFmpeg before Blender VSE",
        default=False,
    )

    frame_step: IntProperty(
        name="Frame Step",
        default=1,
        min=1,
        max=10,
    )

    resolution_scale: FloatProperty(
        name="Resolution Scale",
        default=1.0,
        min=0.25,
        max=1.0,
        subtype='FACTOR',
    )

    video_quality: IntProperty(
        name="Quality",
        default=90,
        min=0,
        max=100,
        subtype='PERCENTAGE',
    )

    image_format: EnumProperty(
        name="Image Format",
        items=[
            ('PNG', "PNG", "Lossless"),
            ('JPEG', "JPEG", "Compressed"),
            ('BMP', "BMP", "Bitmap"),
            ('TIFF', "TIFF", "Tagged image"),
        ],
        default='PNG',
    )

    shading_mode: EnumProperty(
        name="Viewport Shading",
        items=[
            ('SOLID', "Solid", "Solid"),
            ('MATERIAL', "Material Preview", "Material"),
            ('RENDERED', "Rendered", "Rendered"),
            ('WIREFRAME', "Wireframe", "Wireframe"),
        ],
        default='SOLID',
    )


