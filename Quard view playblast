def get_view3d_area(context):
    """Find a VIEW_3D area on the current screen."""
    if context.area and context.area.type == 'VIEW_3D':
        return context.area

    if context.screen:
        for area in context.screen.areas:
            if area.type == 'VIEW_3D':
                return area

    return None

def get_window_region(area):
    """Find the WINDOW region of a VIEW_3D area."""
    if area is None:
        return None

    for region in area.regions:
        if region.type == 'WINDOW':
            return region

    return None

def safe_remove_timer(window_manager, timer):
    """Safely remove a Blender event timer."""
    if timer is None:
        return

    try:
        window_manager.event_timer_remove(timer)
    except Exception:
        pass

def ensure_folder(path):
    """Create a folder if it does not exist."""
    if path:
        os.makedirs(path, exist_ok=True)

def clean_folder(path):
    """Delete a temporary folder safely."""
    if not path:
        return

    try:
        if os.path.isdir(path):
            shutil.rmtree(path)
    except Exception as exc:
        print(
            "Playblast Quad View: Failed to remove temp folder:",
            exc
        )

def get_output_path(filepath):
    """Resolve and normalize the output path."""

    filepath = bpy.path.abspath(filepath)

    if not filepath:
        filepath = bpy.path.abspath(
            "//quadview_render.mp4"
        )

    root, ext = os.path.splitext(filepath)

    if not ext:
        filepath = filepath + ".mp4"

    return filepath

def get_temp_folder(output_path):
    """Temporary PNG directory."""

    root, _ext = os.path.splitext(output_path)

    return root + "_temp"

def get_frame_files(folder):
    """Return Playblast PNG files in numerical order."""

    if not os.path.isdir(folder):
        return []

    files = []

    for filename in os.listdir(folder):

        if not filename.lower().endswith(".png"):
            continue

        if not filename.startswith("quadview_frame_"):
            continue

        files.append(filename)

    def sort_number(filename):
        try:
            number_text = filename.rsplit("_", 1)[1]
            number_text = os.path.splitext(number_text)[0]
            return int(number_text)
        except Exception:
            return 0

    files.sort(key=sort_number)

    return files

def get_image_resolution(filepath):
    """Load one PNG temporarily and return its dimensions."""

    image = None

    try:

        image = bpy.data.images.load(
            filepath,
            check_existing=False
        )

        width = int(image.size[0])
        height = int(image.size[1])

        return width, height

    except Exception as exc:

        print(
            "Playblast Quad View: Could not read image size:",
            exc
        )

        return None, None

    finally:

        if image is not None:

            try:
                bpy.data.images.remove(image)
            except Exception:
                pass

def wait_for_file(filepath, timeout=2.0):
    """
    Wait until a freshly written file is readable and non-empty.
    Returns True when the file is ready.
    """

    start_time = time.time()

    while (time.time() - start_time) < timeout:

        try:

            if os.path.isfile(filepath):

                size = os.path.getsize(filepath)

                if size > 0:

                    # Try to open it to confirm it is valid.
                    try:

                        with open(filepath, "rb") as fh:
                            fh.read(8)

                        return True

                    except Exception:
                        pass

        except Exception:
            pass

        time.sleep(0.05)

    return False

def save_image_with_settings(
    context,
    source_png,
    target_path,
    image_format,
    quality
):
    """
    Load a PNG and re-save it using the requested format and quality.

    Uses multiple fallback strategies because Blender's image format
    constraints differ per format.
    """

    scene = context.scene

    old_file_format = scene.render.image_settings.file_format
    old_quality = scene.render.image_settings.quality
    old_compression = scene.render.image_settings.compression
    old_color_depth = scene.render.image_settings.color_depth
    old_color_mode = scene.render.image_settings.color_mode

    image = None
    success = False
    last_error = None

    quality = max(0, min(100, int(quality)))

    try:

        # ------------------------------------------------------------------
        # Configure image settings in the safest order:
        # 1. file_format first (resets dependent fields)
        # 2. color_mode / color_depth second (accepted values depend on format)
        # 3. quality / compression last
        # ------------------------------------------------------------------

        scene.render.image_settings.file_format = image_format

        # --- color mode ---
        preferred_modes = ['RGB', 'BW']

        for mode in preferred_modes:

            try:
                scene.render.image_settings.color_mode = mode
                break

            except Exception:
                continue

        # --- color depth ---
        preferred_depths = ['8']

        for depth in preferred_depths:

            try:
                scene.render.image_settings.color_depth = depth
                break

            except Exception:
                continue

        # --- quality / compression ---
        if image_format == 'JPEG':

            try:
                scene.render.image_settings.quality = quality
            except Exception:
                pass

        elif image_format == 'TIFF':

            try:
                scene.render.image_settings.quality = quality
            except Exception:
                pass

        elif image_format == 'PNG':

            try:
                scene.render.image_settings.compression = max(
                    0,
                    min(100, 100 - quality)
                )
            except Exception:
                pass

        # ------------------------------------------------------------------
        # Load the source PNG
        # ------------------------------------------------------------------

        image = bpy.data.images.load(
            source_png,
            check_existing=False
        )

        # ------------------------------------------------------------------
        # Strategy 1: save_render with quality parameter
        # ------------------------------------------------------------------

        try:

            image.save_render(
                target_path,
                scene=scene,
                quality=quality
            )

            if os.path.isfile(target_path) and os.path.getsize(target_path) > 0:
                success = True

        except TypeError as exc:
            last_error = exc
        except Exception as exc:
            last_error = exc

        # ------------------------------------------------------------------
        # Strategy 2: save_render without quality parameter
        # ------------------------------------------------------------------

        if not success:

            try:

                image.save_render(
                    target_path,
                    scene=scene
                )

                if os.path.isfile(target_path) and os.path.getsize(target_path) > 0:
                    success = True

            except Exception as exc:
                last_error = exc

        # ------------------------------------------------------------------
        # Strategy 3: direct image.save() with explicit file format
        # ------------------------------------------------------------------

        if not success:

            try:

                image.filepath_raw = target_path
                image.file_format = image_format
                image.save()

                if os.path.isfile(target_path) and os.path.getsize(target_path) > 0:
                    success = True

            except Exception as exc:
                last_error = exc

    except Exception as exc:

        last_error = exc

    finally:

        if image is not None:

            try:
                bpy.data.images.remove(image)
            except Exception:
                pass

        try:
            scene.render.image_settings.file_format = old_file_format
            scene.render.image_settings.quality = old_quality
            scene.render.image_settings.compression = old_compression
            scene.render.image_settings.color_depth = old_color_depth
            scene.render.image_settings.color_mode = old_color_mode
        except Exception:
            pass

    if not success and last_error is not None:

        print(
            "Playblast Quad View: Save image failed ({}):".format(
                image_format
            ),
            repr(last_error)
        )

    return success

