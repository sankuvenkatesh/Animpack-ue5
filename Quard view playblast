class QP_OT_switch_layout(bpy.types.Operator):

    bl_idname = "qp.switch_layout"
    bl_label = "Toggle Quad View"
    bl_description = "Toggle Quad View in the active 3D Viewport"

    def execute(self, context):

        area = get_view3d_area(context)

        if area is None:
            self.report({'ERROR'}, "No 3D Viewport found")
            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:
            self.report({'ERROR'}, "No VIEW_3D window region found")
            return {'CANCELLED'}

        space = area.spaces.active

        try:

            with context.temp_override(
                area=area,
                region=region,
                space_data=space
            ):
                result = bpy.ops.screen.region_quadview()

            if 'FINISHED' in result:

                context.scene.qp_props.is_quad_active = (
                    not context.scene.qp_props.is_quad_active
                )

                self.report({'INFO'}, "Quad View toggled")
                return {'FINISHED'}

            self.report({'ERROR'}, "Quad View operation failed")
            return {'CANCELLED'}

        except Exception as exc:

            self.report(
                {'ERROR'},
                "Could not toggle Quad View: {}".format(exc)
            )
            return {'CANCELLED'}

# ============================================================================
# SINGLE SCREENSHOT
# ============================================================================

class QP_OT_screenshot_quadview(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview"
    bl_label = "Playblast Screenshot"
    bl_description = "Save the current VIEW_3D editor as an image"

    def execute(self, context):

        props = context.scene.qp_props

        filepath = bpy.path.abspath(
            props.render_filepath
        )

        ext_map = {
            'PNG': '.png',
            'JPEG': '.jpg',
            'BMP': '.bmp',
            'TIFF': '.tif',
        }

        image_format = props.image_format
        target_ext = ext_map.get(image_format, '.png')

        root, _ext = os.path.splitext(filepath)
        filepath = root + target_ext

        directory = os.path.dirname(filepath)

        if directory:
            ensure_folder(directory)

        area = get_view3d_area(context)

        if area is None:
            self.report({'ERROR'}, "No VIEW_3D area found")
            return {'CANCELLED'}

        region = get_window_region(area)

        if region is None:
            self.report({'ERROR'}, "No VIEW_3D window region found")
            return {'CANCELLED'}

        temp_png = filepath + ".tmp_capture.png"

        # Clean any stale temp file.
        try:
            if os.path.isfile(temp_png):
                os.remove(temp_png)
        except Exception:
            pass

        try:

            with context.temp_override(
                area=area,
                region=region,
                space_data=area.spaces.active
            ):
                result = bpy.ops.screen.screenshot_area(
                    filepath=temp_png,
                    check_existing=False
                )

            if 'FINISHED' not in result:
                self.report({'ERROR'}, "Screenshot operation failed")
                return {'CANCELLED'}

        except Exception as exc:

            self.report(
                {'ERROR'},
                "Screenshot failed: {}".format(exc)
            )
            return {'CANCELLED'}

        # Wait for the OS to flush the file.
        if not wait_for_file(temp_png):
            self.report(
                {'ERROR'},
                "Screenshot file was not written properly"
            )
            return {'CANCELLED'}

        success = save_image_with_settings(
            context,
            temp_png,
            filepath,
            image_format,
            props.video_quality
        )

        try:
            if os.path.isfile(temp_png):
                os.remove(temp_png)
        except Exception:
            pass

        if not success:
            self.report(
                {'ERROR'},
                "Could not save image with requested settings"
            )
            return {'CANCELLED'}

        if not os.path.isfile(filepath):
            self.report({'ERROR'}, "Screenshot file was not created")
            return {'CANCELLED'}

        self.report(
            {'INFO'},
            "Screenshot saved: {}".format(filepath)
        )
        return {'FINISHED'}

# ============================================================================
# PLAYBLAST ANIMATION CAPTURE
