# ============================================================================
# REGISTRATION
# ============================================================================

classes = (
    QP_Props,
    QP_OT_switch_layout,
    QP_OT_screenshot_quadview,
    QP_OT_screenshot_quadview_anim,
    QP_OT_combine_images_to_video,
    QP_PT_panel,
)


def register():

    for cls in reversed(classes):

        existing = getattr(
            bpy.types,
            cls.__name__,
            None
        )

        if existing is not None:

            try:
                bpy.utils.unregister_class(existing)
            except Exception:
                pass

    if hasattr(bpy.types.Scene, "qp_props"):

        try:
            del bpy.types.Scene.qp_props
        except Exception:
            pass

    for cls in classes:
        bpy.utils.register_class(cls)

    bpy.types.Scene.qp_props = PointerProperty(
        type=QP_Props
    )

    print(
        "Playblast Quad View 1.8.3 registered for Blender 5.2+"
    )


def unregister():

    global _PLAYBLAST_RUNNING
    global _ACTIVE_PLAYBLAST_OPERATOR

    operator = _ACTIVE_PLAYBLAST_OPERATOR

    if operator is not None:

        try:
            safe_remove_timer(
                operator._window_manager,
                operator._timer
            )

            operator.restore_state()

            operator.scene.frame_set(
                operator.original_frame
            )

        except Exception:
            pass

    _PLAYBLAST_RUNNING = False
    _ACTIVE_PLAYBLAST_OPERATOR = None

    if hasattr(bpy.types.Scene, "qp_props"):

        try:
            del bpy.types.Scene.qp_props
        except Exception:
            pass

    for cls in reversed(classes):

        existing = getattr(
            bpy.types,
            cls.__name__,
            None
        )

        if existing is not None:

            try:
                bpy.utils.unregister_class(existing)
            except Exception:
                pass

    print("Playblast Quad View unregistered")


if __name__ == "__main__":
    register()
