# COMBINE IMAGES TO VIDEO
# ============================================================================

class QP_OT_combine_images_to_video(bpy.types.Operator):

    bl_idname = "qp.combine_images_to_video"
    bl_label = "Combine Images to Video"
    bl_description = "Encode the captured PNG sequence into a movie"

    def execute(self, context):

        props = context.scene.qp_props

        output_path = get_output_path(props.render_filepath)
        folder = get_temp_folder(output_path)

        images = get_frame_files(folder)

        if not images:
            self.report({'ERROR'}, "No Playblast PNG frames were found")
            return {'CANCELLED'}

        print(
            "Playblast Quad View: Found {} image frames".format(
                len(images)
            )
        )

        scene = context.scene

        fps = float(scene.render.fps)

        if scene.render.fps_base != 0:
            fps = fps / float(scene.render.fps_base)

        if fps <= 0:
            fps = 24.0

        if props.use_ffmpeg:

            ffmpeg_path = shutil.which("ffmpeg")

            if ffmpeg_path is not None:

                ffmpeg_result = self.encode_with_ffmpeg(
                    context,
                    ffmpeg_path,
                    output_path,
                    folder,
                    fps
                )

                if ffmpeg_result:
                    clean_folder(folder)
                    return {'FINISHED'}

                self.report(
                    {'WARNING'},
                    "FFMPEG failed. Trying Blender VSE."
                )

            else:

                self.report(
                    {'WARNING'},
                    "FFMPEG executable not found. "
                    "Trying Blender VSE."
                )

        return self.encode_with_vse(
            context,
            output_path,
            folder,
            images
        )

    def encode_with_ffmpeg(
        self,
        context,
        ffmpeg_path,
        output_path,
        folder,
        fps
    ):

        input_pattern = os.path.join(
            folder,
            "quadview_frame_%04d.png"
        )

        quality = int(context.scene.qp_props.video_quality)
        quality = max(0, min(100, quality))

        crf_value = int(round((100 - quality) * 51 / 100.0))
        crf_value = max(0, min(51, crf_value))

        # -pix_fmt yuv420p guarantees RGB -> YUV 4:2:0 with color.
        command = [
            ffmpeg_path,
            "-y",
            "-framerate",
            "{:.6f}".format(fps),
            "-i",
            input_pattern,
            "-c:v",
            "libx264",
            "-pix_fmt",
            "yuv420p",
            "-crf",
            str(crf_value),
        ]

        scale = context.scene.qp_props.resolution_scale

        if scale < 0.999:

            scale_filter = (
                "scale="
                "trunc(iw*{}/2)*2:"
                "trunc(ih*{}/2)*2"
            ).format(scale, scale)

            command.extend(["-vf", scale_filter])

        command.extend([
            "-movflags",
            "+faststart",
            output_path
        ])

        print(
            "Playblast Quad View: Running FFMPEG "
            "(quality={}, crf={})...".format(quality, crf_value)
        )

        try:

            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )

        except Exception as exc:
            print("FFMPEG execution error:", exc)
            return False

        if result.returncode != 0:
            print("FFMPEG stderr:")
            print(result.stderr)
            return False

        if not os.path.isfile(output_path):
            print("FFMPEG reported success but output file does not exist.")
            return False

        size_mb = os.path.getsize(output_path) / (1024.0 * 1024.0)
        print(
            "Playblast Quad View: FFMPEG video created: {} ({:.2f} MB)".format(
                output_path, size_mb
            )
        )

        self.report({'INFO'}, "Video created with FFMPEG")
        return True

    # ----------------------------------------------------------------------
    # BLENDER VSE (COMPATIBLE WITH 3.x, 4.x, 5.x)
    # ----------------------------------------------------------------------

    def encode_with_vse(self, context, output_path, folder, images):

        scene = context.scene

        # Save render state
        old_filepath = scene.render.filepath
        old_file_format = scene.render.image_settings.file_format
        old_color_mode = scene.render.image_settings.color_mode
        old_color_depth = scene.render.image_settings.color_depth
        old_resolution_x = scene.render.resolution_x
        old_resolution_y = scene.render.resolution_y
        old_resolution_percentage = scene.render.resolution_percentage
        old_fps = scene.render.fps
        old_fps_base = scene.render.fps_base
        old_frame_start = scene.frame_start
        old_frame_end = scene.frame_end
        old_use_sequencer = scene.render.use_sequencer

        old_ffmpeg_format = scene.render.ffmpeg.format
        old_ffmpeg_codec = scene.render.ffmpeg.codec
        old_ffmpeg_crf = scene.render.ffmpeg.constant_rate_factor
        old_ffmpeg_video_bitrate = scene.render.ffmpeg.video_bitrate

        old_ffmpeg_minrate = None
        old_ffmpeg_maxrate = None

        try:
            old_ffmpeg_minrate = scene.render.ffmpeg.minrate
        except Exception:
            pass

        try:
            old_ffmpeg_maxrate = scene.render.ffmpeg.maxrate
        except Exception:
            pass

        try:

            # 1. Get or create sequence editor
            if scene.sequence_editor is None:
                scene.sequence_editor_create()

            seq = scene.sequence_editor

            # 2. Compatibility: get strips collection
            if hasattr(seq, "strips"):
                strips_coll = seq.strips
            else:
                strips_coll = seq.sequences

            # 3. Clear existing strips
            for strip in list(strips_coll):
                try:
                    strips_coll.remove(strip)
                except Exception as exc:
                    print("Could not remove strip:", strip.name, exc)

            first_image = os.path.join(folder, images[0])

            if not os.path.isfile(first_image):
                raise RuntimeError(
                    "First image is missing:\n{}".format(first_image)
                )

            width, height = get_image_resolution(first_image)

            if width is None or height is None:
                raise RuntimeError("Unable to determine image resolution")

            # 4. Create image strip
            strip = strips_coll.new_image(
                name="QuadView",
                filepath=first_image,
                channel=1,
                frame_start=1
            )

            if strip is None:
                raise RuntimeError(
                    "Blender failed to create the image strip"
                )

            for filename in images[1:]:
                image_path = os.path.join(folder, filename)
                if not os.path.isfile(image_path):
                    raise RuntimeError(
                        "Missing Playblast image:\n{}".format(image_path)
                    )
                strip.elements.append(filename)

            frame_count = len(images)

            # 5. Resolution scaling
            scale = float(context.scene.qp_props.resolution_scale)

            if scale <= 0:
                scale = 1.0

            output_width = int(width * scale)
            output_height = int(height * scale)
            output_width -= (output_width % 2)
            output_height -= (output_height % 2)
            output_width = max(2, output_width)
            output_height = max(2, output_height)

            scene.render.resolution_x = output_width
            scene.render.resolution_y = output_height
            scene.render.resolution_percentage = 100

            # ------------------------------------------------------------------
            # 6. Video format settings
            #
            # IMPORTANT: set file_format FIRST, then force color_mode = 'RGB'.
            # Blender resets color_mode whenever file_format changes, and if
            # it stays at 'BW' the video will be grayscale.
            # ------------------------------------------------------------------

            scene.render.image_settings.file_format = 'FFMPEG'

            # Force RGB (with a fallback loop in case the mode is rejected).
            color_mode_set = False

            for mode in ('RGB', 'RGBA'):

                try:
                    scene.render.image_settings.color_mode = mode
                    color_mode_set = True
                    break
                except Exception:
                    continue

            # Force 8-bit depth.
            try:
                scene.render.image_settings.color_depth = '8'
            except Exception:
                pass

            # Verification print for debugging.
            print(
                "Playblast Quad View: VSE color_mode = '{}', "
                "color_depth = '{}', file_format = '{}'".format(
                    scene.render.image_settings.color_mode,
                    scene.render.image_settings.color_depth,
                    scene.render.image_settings.file_format
                )
            )

            if not color_mode_set:
                print(
                    "Playblast Quad View: WARNING - could not force "
                    "RGB color mode; output may be grayscale."
                )

            scene.render.ffmpeg.format = 'MPEG4'
            scene.render.ffmpeg.codec = 'H264'

            # ------------------------------------------------------------------
            # 7. Quality -> bitrate (CBR)
            # ------------------------------------------------------------------

            quality = int(context.scene.qp_props.video_quality)
            quality = max(0, min(100, quality))

            bitrate_kbps = int(500 + (quality / 100.0) * 49500)

            try:
                scene.render.ffmpeg.constant_rate_factor = 'NONE'
            except Exception as exc:
                print(
                    "Playblast Quad View: Could not set CRF preset:",
                    exc
                )

            scene.render.ffmpeg.video_bitrate = bitrate_kbps

            try:
                scene.render.ffmpeg.minrate = bitrate_kbps
            except Exception:
                pass

            try:
                scene.render.ffmpeg.maxrate = bitrate_kbps
            except Exception:
                pass

            print(
                "Playblast Quad View: VSE quality={} -> "
                "bitrate={} kbps (CBR)".format(
                    quality, bitrate_kbps
                )
            )

            # 8. Output path and frame range
            scene.render.filepath = output_path
            scene.render.fps = old_fps
            scene.render.fps_base = old_fps_base
            scene.frame_start = 1
            scene.frame_end = frame_count

            # 9. Enable VSE rendering
            scene.render.use_sequencer = True

            # 10. Refresh VSE
            try:
                bpy.ops.sequencer.refresh_all()
            except Exception:
                pass

            try:
                context.view_layer.update()
            except Exception:
                pass

            # 11. Render VSE animation
            print("Playblast Quad View: Rendering VSE video...")

            result = bpy.ops.render.render(animation=True)

            if 'FINISHED' not in result:
                raise RuntimeError(
                    "VSE render returned: {}".format(result)
                )

            if not os.path.isfile(output_path):
                raise RuntimeError(
                    "Blender completed the render operation, "
                    "but the video file was not created:\n{}".format(
                        output_path
                    )
                )

            size_mb = os.path.getsize(output_path) / (1024.0 * 1024.0)

            print(
                "Playblast Quad View: Video created: {} ({:.2f} MB)".format(
                    output_path, size_mb
                )
            )

            self.report({'INFO'}, "Video created successfully")
            return {'FINISHED'}

        except Exception as exc:

            print("Playblast Quad View VSE ERROR:", repr(exc))

            self.report(
                {'ERROR'},
                "VSE encoding failed: {}".format(exc)
            )
            return {'CANCELLED'}

        finally:

            try:

                scene.render.filepath = old_filepath
                scene.render.image_settings.file_format = old_file_format
                scene.render.image_settings.color_mode = old_color_mode
                scene.render.image_settings.color_depth = old_color_depth
                scene.render.resolution_x = old_resolution_x
                scene.render.resolution_y = old_resolution_y
                scene.render.resolution_percentage = (
                    old_resolution_percentage
                )
                scene.render.fps = old_fps
                scene.render.fps_base = old_fps_base
                scene.frame_start = old_frame_start
                scene.frame_end = old_frame_end
                scene.render.use_sequencer = old_use_sequencer

                scene.render.ffmpeg.format = old_ffmpeg_format
                scene.render.ffmpeg.codec = old_ffmpeg_codec
                scene.render.ffmpeg.constant_rate_factor = old_ffmpeg_crf
                scene.render.ffmpeg.video_bitrate = old_ffmpeg_video_bitrate

                if old_ffmpeg_minrate is not None:
                    try:
                        scene.render.ffmpeg.minrate = old_ffmpeg_minrate
                    except Exception:
                        pass

                if old_ffmpeg_maxrate is not None:
                    try:
                        scene.render.ffmpeg.maxrate = old_ffmpeg_maxrate
                    except Exception:
                        pass

            except Exception as exc:
                print("Could not restore render settings:", exc)

            clean_folder(folder)

# ============================================================================
# UI PANEL
# ============================================================================

class QP_PT_panel(bpy.types.Panel):

    bl_label = "Playblast Panel"
    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = "Playblast"

    def draw(self, context):

        layout = self.layout
        props = context.scene.qp_props

        row = layout.row()
        row.operator("qp.switch_layout", icon='WINDOW')

        layout.prop(props, "render_filepath")

        row = layout.row(align=True)
        row.operator("qp.screenshot_quadview", icon='IMAGE_DATA')
        row.operator(
            "qp.screenshot_quadview_anim",
            icon='RENDER_ANIMATION'
        )

        layout.separator()

        layout.label(text="Extra Options", icon='PREFERENCES')

        layout.prop(props, "image_format")
        layout.prop(props, "video_quality")
        layout.prop(props, "use_ffmpeg")
        layout.prop(props, "frame_step")
        layout.prop(props, "resolution_scale")
        layout.prop(props, "shading_mode")

        if props.is_playblasting:

            layout.separator()

            box = layout.box()
            box.label(text="PLAYBLAST IN PROGRESS", icon='TIME')

# ============================================================================
# REGISTER
# ============================================================================

classes = (
    QP_Props,
    QP_OT_switch_layout,
    QP_OT_screenshot_quadview,
    QP_OT_screenshot_quadview_anim,
    QP_OT_combine_images_to_video,
    QP_PT_panel,
)

def register():

    for cls in classes:
        bpy.utils.register_class(cls)

    bpy.types.Scene.qp_props = PointerProperty(type=QP_Props)

def unregister():

    global _PLAYBLAST_RUNNING

    _PLAYBLAST_RUNNING = False

    if hasattr(bpy.types.Scene, "qp_props"):
        del bpy.types.Scene.qp_props

    for cls in reversed(classes):
        bpy.utils.unregister_class(cls)

# ============================================================================
# RUN
# ============================================================================

if __name__ == "__main__":
    register()
