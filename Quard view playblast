class QP_Props(bpy.types.PropertyGroup):

    render_filepath: StringProperty(
        name="Save Path",
        subtype='FILE_PATH',
        default="//quadview_render.mp4"
    )

    is_quad_active: BoolProperty(
        name="Quad View Active",
        default=False
    )

    is_playblasting: BoolProperty(
        name="Playblast Running",
        default=False
    )

    use_ffmpeg: BoolProperty(
        name="Use FFMPEG Encode",
        default=False
    )

    frame_step: IntProperty(
        name="Frame Step",
        default=1,
        min=1,
        max=10
    )

    resolution_scale: FloatProperty(
        name="Resolution Scale",
        default=1.0,
        min=0.25,
        max=1.0
    )

    video_quality: IntProperty(
        name="Quality",
        description=(
            "Quality 0-100. "
            "For JPEG/TIFF images it is visual quality. "
            "For PNG it controls file compression. "
            "For video it controls the bitrate"
        ),
        default=90,
        min=0,
        max=100,
        subtype='PERCENTAGE'
    )

    image_format: EnumProperty(
        name="Image Format",
        description="Format used for saved screenshots",
        items=[
            ('PNG', "PNG", "Lossless. Quality controls compression only"),
            ('JPEG', "JPEG", "Lossy. Quality controls visual quality"),
            ('BMP', "BMP", "Uncompressed bitmap"),
            ('TIFF', "TIFF", "Lossy or lossless TIFF"),
        ],
        default='PNG'
    )

    shading_mode: EnumProperty(
        name="Viewport Shading",
        items=[
            ('SOLID', "Solid", ""),
            ('MATERIAL', "Material", ""),
            ('RENDERED', "Rendered", ""),
            ('WIREFRAME', "Wireframe", "")
        ],
        default='SOLID'
    )

