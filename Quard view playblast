class QP_OT_switch_layout(bpy.types.Operator):

    bl_idname = "qp.switch_layout"
    bl_label = "Toggle Quad View"

    @classmethod
    def poll(cls, context):
        return get_view3d_area(context) is not None

    def execute(self, context):
        area = get_view3d_area(context)
        region = get_window_region(area)

        if not region:
            self.report({'ERROR'}, "No VIEW_3D region")
            return {'CANCELLED'}

        try:
            with context.temp_override(
                window=context.window,
                screen=context.screen,
                area=area,
                region=region,
            ):
                result = bpy.ops.screen.region_quadview()

            if 'FINISHED' not in result:
                raise RuntimeError("Quad View operation failed")

            context.scene.qp_props.is_quad_active = bool(
                len(area.spaces.active.region_quadviews)
            )

            return {'FINISHED'}

        except Exception as exc:
            self.report({'ERROR'}, str(exc))
            return {'CANCELLED'}


# ============================================================================
# SINGLE SCREENSHOT
# ============================================================================

class QP_OT_screenshot_quadview(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview"
    bl_label = "Playblast Screenshot"

    @classmethod
    def poll(cls, context):
        return get_view3d_area(context) is not None

    def execute(self, context):
        props = context.scene.qp_props

        filepath = bpy.path.abspath(
            props.render_filepath or "//quadview_render"
        )

        root, _ = os.path.splitext(filepath)

        extensions = {
            'PNG': '.png',
            'JPEG': '.jpg',
            'BMP': '.bmp',
            'TIFF': '.tif',
        }

        target = root + extensions[props.image_format]
        ensure_folder(os.path.dirname(target))

        temp_png = target + ".capture_tmp.png"

        try:
            area = get_view3d_area(context)

            if os.path.exists(temp_png):
                os.remove(temp_png)

            capture_area_screenshot(
                context,
                area,
                temp_png
            )

            if not wait_for_file(temp_png):
                raise RuntimeError("Screenshot was not written")

            success = save_image_with_settings(
                context,
                temp_png,
                target,
                props.image_format,
                props.video_quality,
            )

            if not success:
                raise RuntimeError("Image conversion failed")

        except Exception as exc:
            self.report({'ERROR'}, "Screenshot failed: {}".format(exc))
            return {'CANCELLED'}

        finally:
            if os.path.exists(temp_png):
                try:
                    os.remove(temp_png)
                except Exception:
                    pass

        self.report({'INFO'}, "Screenshot saved: " + target)

        return {'FINISHED'}


# ============================================================================
# ANIMATION CAPTURE
# ============================================================================

class QP_OT_screenshot_quadview_anim(bpy.types.Operator):

    bl_idname = "qp.screenshot_quadview_anim"
    bl_label = "Playblast Animation"

    _timer = None
    _window_manager = None

    def execute(self, context):
        global _PLAYBLAST_RUNNING
        global _ACTIVE_PLAYBLAST_OPERATOR

        if _PLAYBLAST_RUNNING:
            self.report({'WARNING'}, "Playblast already running")
            return {'CANCELLED'}

        scene = context.scene
        props = scene.qp_props

        area = get_view3d_area(context)

        if not area:
            self.report({'ERROR'}, "No VIEW_3D area")
            return {'CANCELLED'}

        region = get_window_region(area)

        if not region:
            self.report({'ERROR'}, "No VIEW_3D region")
            return {'CANCELLED'}

        self.scene = scene
        self.area = area
        self.region = region
        self.space = area.spaces.active

        self._window_manager = context.window_manager
        self._timer = None

        self.original_frame = scene.frame_current
        self.start = scene.frame_start
        self.end = scene.frame_end

        self.step = max(1, props.frame_step)
        self.frame = self.start
        self.capture_index = 1

        self.output_path = get_output_path(
            props.render_filepath
        )

        self.folder = get_temp_folder(
            self.output_path
        )

        self.old_settings = {}

        try:
            self.old_settings = {
                "shading": self.space.shading.type,
                "overlays": self.space.overlay.show_overlays,
                "ui": self.space.show_region_ui,
                "toolbar": self.space.show_region_toolbar,
                "gizmo": self.space.show_gizmo,
                "header": self.space.show_region_header,
            }

            self.space.shading.type = props.shading_mode
            self.space.overlay.show_overlays = False
            self.space.show_region_ui = False
            self.space.show_region_toolbar = False
            self.space.show_gizmo = False
            self.space.show_region_header = False

            clean_folder(self.folder)
            ensure_folder(self.folder)

        except Exception as exc:
            self.restore_state()
            self.report({'ERROR'}, str(exc))
            return {'CANCELLED'}

        _PLAYBLAST_RUNNING = True
        _ACTIVE_PLAYBLAST_OPERATOR = self

        props.is_playblasting = True

        try:
            scene.frame_set(self.frame)
            context.view_layer.update()

            self.area.tag_redraw()

            self._timer = context.window_manager.event_timer_add(
                0.10,
                window=context.window,
            )

            context.window_manager.modal_handler_add(self)

        except Exception as exc:
            self.finish_capture(context)
            self.report({'ERROR'}, str(exc))
            return {'CANCELLED'}

        self.report({'INFO'}, "Playblast started")

        return {'RUNNING_MODAL'}

    def modal(self, context, event):

        if event.type == 'ESC':
            self.finish_capture(context)

            self.report(
                {'WARNING'},
                "Playblast cancelled. PNG frames retained."
            )

            return {'CANCELLED'}

        if event.type != 'TIMER':
            return {'PASS_THROUGH'}

        if self.frame > self.end:
            self.finish_capture(context)

            result = bpy.ops.qp.combine_images_to_video()

            return (
                {'FINISHED'}
                if 'FINISHED' in result
                else {'CANCELLED'}
            )

        try:
            self.scene.frame_set(self.frame)
            context.view_layer.update()

            self.area.tag_redraw()

            with context.temp_override(
                window=context.window,
                screen=context.screen,
                area=self.area,
                region=self.region,
            ):
                bpy.ops.wm.redraw_timer(
                    type='DRAW_WIN_SWAP',
                    iterations=1
                )

            filepath = os.path.join(
                self.folder,
                "quadview_frame_{:04d}.png".format(
                    self.capture_index
                )
            )

            if os.path.exists(filepath):
                os.remove(filepath)

            capture_area_screenshot(
                context,
                self.area,
                filepath
            )

            if not wait_for_file(filepath):
                raise RuntimeError("Frame image was not saved")

            print(
                "Playblast: Captured frame {}".format(
                    self.frame
                )
            )

            self.frame += self.step
            self.capture_index += 1

            return {'RUNNING_MODAL'}

        except Exception as exc:
            failed_frame = self.frame

            self.finish_capture(context)

            self.report(
                {'ERROR'},
                "Capture failed at frame {}: {}".format(
                    failed_frame,
                    exc
                )
            )

            return {'CANCELLED'}

    def restore_state(self):
        space = getattr(self, "space", None)

        if not space:
            return

        settings = getattr(self, "old_settings", {})

        try:
            space.shading.type = settings["shading"]
            space.overlay.show_overlays = settings["overlays"]
            space.show_region_ui = settings["ui"]
            space.show_region_toolbar = settings["toolbar"]
            space.show_gizmo = settings["gizmo"]
            space.show_region_header = settings["header"]

        except Exception as exc:
            print("Playblast restore warning:", exc)

    def finish_capture(self, context):
        global _PLAYBLAST_RUNNING
        global _ACTIVE_PLAYBLAST_OPERATOR

        safe_remove_timer(
            self._window_manager,
            self._timer
        )

        self._timer = None

        self.restore_state()

        try:
            self.scene.frame_set(self.original_frame)
            context.view_layer.update()
        except Exception:
            pass

        try:
            self.scene.qp_props.is_playblasting = False
        except Exception:
            pass

        _PLAYBLAST_RUNNING = False
        _ACTIVE_PLAYBLAST_OPERATOR = None


# ============================================================================
# VIDEO ENCODING
# ============================================================================

class QP_OT_combine_images_to_video(bpy.types.Operator):

    bl_idname = "qp.combine_images_to_video"
    bl_label = "Combine Images to Video"

    def execute(self, context):

        props = context.scene.qp_props

        output_path = get_output_path(
            props.render_filepath
        )

        folder = get_temp_folder(output_path)
        images = get_frame_files(folder)

        if not images:
            self.report({'ERROR'}, "No PNG frames found")
            return {'CANCELLED'}

        ensure_folder(os.path.dirname(output_path))

        scene = context.scene

        fps = float(scene.render.fps)

        if scene.render.fps_base > 0:
            fps /= scene.render.fps_base

        fps /= max(1, props.frame_step)

        if fps <= 0:
            fps = 24.0

        print(
            "Playblast: Encoding {} frames at {:.4f} FPS".format(
                len(images), fps
            )
        )

        if props.use_ffmpeg:
            ffmpeg_path = shutil.which("ffmpeg")

            if ffmpeg_path:
                if self.encode_with_ffmpeg(
                    context,
                    ffmpeg_path,
                    output_path,
                    folder,
                    fps,
                ):
                    clean_folder(folder)
                    return {'FINISHED'}

                self.report(
                    {'WARNING'},
                    "External FFmpeg failed. Trying Blender VSE."
                )

            else:
                self.report(
                    {'WARNING'},
                    "FFmpeg not found. Trying Blender VSE."
                )

        result = self.encode_with_vse(
            context,
            output_path,
            folder,
            images,
            fps,
        )

        if 'FINISHED' in result:
            clean_folder(folder)

        return result

    # ------------------------------------------------------------------------
    # EXTERNAL FFMPEG
    # ------------------------------------------------------------------------

    def encode_with_ffmpeg(
        self,
        context,
        ffmpeg_path,
        output_path,
        folder,
        fps
    ):

        props = context.scene.qp_props

        quality = max(
            0,
            min(100, int(props.video_quality))
        )

        crf = int(round((100 - quality) * 51 / 100.0))

        scale = max(
            0.25,
            min(1.0, float(props.resolution_scale))
        )

        input_pattern = os.path.join(
            folder,
            "quadview_frame_%04d.png"
        )

        scale_filter = (
            "scale=trunc(iw*{}/2)*2:"
            "trunc(ih*{}/2)*2"
        ).format(scale)

        command = [
            ffmpeg_path,
            "-hide_banner",
            "-loglevel", "error",
            "-y",
            "-framerate", str(fps),
            "-start_number", "1",
            "-i", input_pattern,
            "-vf", scale_filter,
            "-c:v", "libx264",
            "-preset", "medium",
            "-pix_fmt", "yuv420p",
            "-crf", str(crf),
            "-movflags", "+faststart",
            output_path,
        ]

        try:
            completed = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
            )

            if completed.returncode != 0:
                print(
                    "FFmpeg ERROR:",
                    completed.stderr[-6000:]
                )
                return False

            if not os.path.isfile(output_path):
                return False

            if os.path.getsize(output_path) <= 0:
                return False

            self.report(
                {'INFO'},
                "MP4 created using FFmpeg"
            )

            return True

        except Exception as exc:
            print("FFmpeg launch error:", repr(exc))
            return False

    # ------------------------------------------------------------------------
    # BLENDER 5.2 VSE ENCODER
    # ------------------------------------------------------------------------

    def encode_with_vse(
        self,
        context,
        output_path,
        folder,
        images,
        fps
    ):

        source_scene = context.scene
        temp_scene = None

        try:

            first_image = os.path.join(
                folder,
                images[0]
            )

            if not os.path.isfile(first_image):
                raise RuntimeError(
                    "First PNG image is missing"
                )

            width, height = get_image_resolution(
                first_image
            )

            if width <= 0 or height <= 0:
                raise RuntimeError(
                    "Invalid image resolution"
                )

            # Create isolated encoding scene.
            temp_scene = bpy.data.scenes.new(
                "QP_Playblast_Encode_TEMP"
            )

            # --------------------------------------------------------------
            # CONFIGURE SCENE
            # --------------------------------------------------------------

            render = temp_scene.render

            render.resolution_x = width
            render.resolution_y = height
            render.resolution_percentage = 100

            render.fps = source_scene.render.fps

            render.fps_base = (
                float(source_scene.render.fps_base)
                * max(1, source_scene.qp_props.frame_step)
            )

            scale = max(
                0.25,
                min(
                    1.0,
                    float(source_scene.qp_props.resolution_scale)
                )
            )

            render.resolution_x = max(
                2,
                int(width * scale) // 2 * 2
            )

            render.resolution_y = max(
                2,
                int(height * scale) // 2 * 2
            )

            render.use_sequencer = True
            render.use_file_extension = True

            # --------------------------------------------------------------
            # CREATE IMAGE SEQUENCE
            # --------------------------------------------------------------

            editor = temp_scene.sequence_editor_create()

            strips = editor.strips

            strip = strips.new_image(
                name="PlayblastFrames",
                filepath=first_image,
                channel=1,
                frame_start=1,
            )

            for filename in images[1:]:

                image_path = os.path.join(
                    folder,
                    filename
                )

                if not os.path.isfile(image_path):
                    raise RuntimeError(
                        "Missing PNG frame: {}".format(filename)
                    )

                strip.elements.append(filename)

            frame_count = len(images)

            temp_scene.frame_start = 1
            temp_scene.frame_end = frame_count
            temp_scene.frame_set(1)

            # Explicitly set the strip duration.
            if strip.frame_final_duration != frame_count:
                try:
                    strip.frame_final_duration = frame_count
                except Exception:
                    pass

            # --------------------------------------------------------------
            # MP4 OUTPUT SETTINGS
            # --------------------------------------------------------------

            output_dir = os.path.dirname(output_path)

            if not output_dir:
                output_dir = os.getcwd()

            ensure_folder(output_dir)

            # Remove previous output.
            if os.path.isfile(output_path):
                os.remove(output_path)

            # IMPORTANT:
            # Blender's render filepath is the output filename base.
            # Do not use only the directory here.

            render.filepath = output_path

            # Blender 5.2 FFmpeg output.
            #
            # Do not set image_settings.media_type.
            # This property is not required for FFmpeg output.

            render.image_settings.file_format = 'FFMPEG'

            ffmpeg = render.ffmpeg

            ffmpeg.format = 'MPEG4'
            ffmpeg.codec = 'H264'

            try:
                ffmpeg.audio_codec = 'NONE'
            except Exception:
                pass

            try:
                ffmpeg.constant_rate_factor = 'MEDIUM'
            except Exception:
                pass

            quality = max(
                0,
                min(
                    100,
                    int(source_scene.qp_props.video_quality)
                )
            )

            ffmpeg.video_bitrate = int(
                500 + (quality / 100.0) * 49500
            )

            try:
                ffmpeg.ffmpeg_preset = 'GOOD'
            except Exception:
                pass

            # --------------------------------------------------------------
            # COLOR SETTINGS
            # --------------------------------------------------------------

            for owner_name, property_names in (
                (
                    "view_settings",
                    (
                        "view_transform",
                        "look",
                        "exposure",
                        "gamma",
                    )
                ),
                (
                    "display_settings",
                    ("display_device",)
                ),
            ):

                source_owner = getattr(
                    source_scene,
                    owner_name,
                    None
                )

                target_owner = getattr(
                    temp_scene,
                    owner_name,
                    None
                )

                if source_owner is None or target_owner is None:
                    continue

                for prop_name in property_names:
                    try:
                        setattr(
                            target_owner,
                            prop_name,
                            getattr(source_owner, prop_name)
                        )
                    except Exception:
                        pass

            # --------------------------------------------------------------
            # RENDER VIDEO
            # --------------------------------------------------------------

            print(
                "Playblast VSE: Starting render"
            )

            print(
                "Frames: {}".format(frame_count)
            )

            print(
                "Resolution: {} x {}".format(
                    render.resolution_x,
                    render.resolution_y
                )
            )

            print(
                "Output: {}".format(output_path)
            )

            with bpy.context.temp_override(
                scene=temp_scene
            ):

                result = bpy.ops.render.render(
                    animation=True
                )

            if 'FINISHED' not in result:
                raise RuntimeError(
                    "Blender animation render did not finish: {}".format(
                        result
                    )
                )

            # --------------------------------------------------------------
            # VERIFY OUTPUT
            # --------------------------------------------------------------

            # Check the requested output first.
            generated_file = None

            if (
                os.path.isfile(output_path)
                and os.path.getsize(output_path) > 0
            ):
                generated_file = output_path

            # Blender may append an extension or use another filename.
            if generated_file is None:

                root = os.path.splitext(
                    os.path.basename(output_path)
                )[0]

                candidates = []

                for extension in (
                    ".mp4",
                    ".mov",
                    ".mkv",
                    ".avi",
                ):

                    candidates.extend(
                        glob.glob(
                            os.path.join(
                                output_dir,
                                root + "*" + extension
                            )
                        )
                    )

                candidates = [
                    path for path in candidates
                    if os.path.isfile(path)
                    and os.path.getsize(path) > 0
                ]

                if candidates:

                    generated_file = max(
                        candidates,
                        key=os.path.getmtime
                    )

            if generated_file is None:
                raise RuntimeError(
                    "VSE render finished but MP4 file was not found. "
                    "Check Blender console for FFmpeg errors."
                )

            # Rename generated video if necessary.
            if os.path.abspath(generated_file) != os.path.abspath(output_path):

                if os.path.exists(output_path):
                    os.remove(output_path)

                shutil.move(
                    generated_file,
                    output_path
                )

            if not os.path.isfile(output_path):
                raise RuntimeError(
                    "Final MP4 file does not exist"
                )

            if os.path.getsize(output_path) <= 0:
                raise RuntimeError(
                    "Final MP4 file is empty"
                )

            size_mb = (
                os.path.getsize(output_path)
                / (1024.0 * 1024.0)
            )

            print(
                "Playblast SUCCESS: {} ({:.2f} MB)".format(
                    output_path,
                    size_mb
                )
            )

            self.report(
                {'INFO'},
                "MP4 video created successfully"
            )

            return {'FINISHED'}

        except Exception as exc:

            print("\n================================")
            print("PLAYBLAST VSE ENCODING ERROR")
            print(repr(exc))
            print("================================\n")

            self.report(
                {'ERROR'},
                "VSE encoding failed: {}".format(exc)
            )

            return {'CANCELLED'}

        finally:

            if temp_scene is not None:

                try:
                    bpy.data.scenes.remove(
                        temp_scene
                    )

                except Exception as exc:
                    print(
                        "Temporary scene cleanup error:",
                        repr(exc)
                    )


