import re
import shutil
import subprocess
import time
import traceback

from bpy.props import (
    StringProperty, BoolProperty, IntProperty,
    EnumProperty, FloatProperty, PointerProperty,
)

_PLAYBLAST_RUNNING = False
_ACTIVE_PLAYBLAST_OPERATOR = None


# ---------------------------------------------------------------------------
# GENERAL HELPERS
# ---------------------------------------------------------------------------

def get_view3d_area(context):
    area = getattr(context, "area", None)
    if area and area.type == 'VIEW_3D':
        return area
    screen = getattr(context, "screen", None)
    if screen:
        for candidate in screen.areas:
            if candidate.type == 'VIEW_3D':
                return candidate
    return None


def get_window_region(area):
    if area:
        for region in area.regions:
            if region.type == 'WINDOW':
                return region
    return None


def ensure_folder(path):
    if path:
        os.makedirs(path, exist_ok=True)


def safe_remove_timer(wm, timer):
    if wm and timer:
        try:
            wm.event_timer_remove(timer)
        except Exception:
            pass


def get_output_path(filepath):
    filepath = (filepath or "//quadview_render.mp4").strip()
    filepath = bpy.path.abspath(filepath)
    root, _ext = os.path.splitext(filepath)
    return (root or filepath) + ".mp4"


def get_temp_folder(output_path):
    return os.path.splitext(output_path)[0] + "_temp"


def clean_folder(path):
    if path and os.path.isdir(path):
        try:
            shutil.rmtree(path)
        except Exception as exc:
            print("Playblast: temporary-folder cleanup failed:", repr(exc))


def get_frame_files(folder):
    if not os.path.isdir(folder):
        return []
    pattern = re.compile(r"^quadview_frame_(\d+)\.png$", re.IGNORECASE)
    found = []
    for filename in os.listdir(folder):
        match = pattern.match(filename)
        if match:
            found.append((int(match.group(1)), filename))
    found.sort(key=lambda item: item[0])
    return [filename for _number, filename in found]


def wait_for_file(filepath, timeout=4.0):
    start = time.monotonic()
    previous_size = -1
    stable = 0
    while time.monotonic() - start < timeout:
        try:
            if os.path.isfile(filepath):
                size = os.path.getsize(filepath)
                if size > 0 and size == previous_size:
                    stable += 1
                    if stable >= 2:
                        return True
                else:
                    stable = 0
                    previous_size = size
        except Exception:
            pass
        time.sleep(0.05)
    return False


def capture_viewport_png(context, area, filepath):
    """
    Blender 5.2 preferred path:
      Window.screenshot(region=...) -> imbuf.write().
    screenshot_area is retained as a fallback for builds where the
    window framebuffer API is unavailable.
    """
    window = context.window
    region = get_window_region(area)
    if window is None or region is None:
        raise RuntimeError("No active window or VIEW_3D WINDOW region")

    # Ensure the viewport has had a chance to redraw before reading pixels.
    try:
        area.tag_redraw()
        with context.temp_override(
            window=window, screen=context.screen, area=area, region=region
        ):
            bpy.ops.wm.redraw_timer(type='DRAW_WIN_SWAP', iterations=1)
    except Exception:
        pass

    primary_error = None

    # Blender 5.2 Window.screenshot API.
    try:
        import imbuf

        rect = (
            (int(region.x), int(region.y)),
            (int(region.x + region.width), int(region.y + region.height)),
        )
        pixels = window.screenshot(region=rect, use_alpha=False)
        height = int(pixels.shape[0])
        width = int(pixels.shape[1])
        if width <= 0 or height <= 0:
            raise RuntimeError("Window screenshot returned an empty image")

        ibuf = imbuf.new((width, height))
        try:
            ibuf.file_type = 'PNG'
            with ibuf.with_buffer(write=True) as buffer:
                buffer.cast('B')[:] = pixels.cast('B')
            imbuf.write(ibuf, filepath=filepath)
        finally:
            try:
                ibuf.free()
            except Exception:
                pass

        if wait_for_file(filepath):
            return
        raise RuntimeError("Window.screenshot did not write a valid PNG")
    except Exception as exc:
        primary_error = exc
        print("Playblast: Window.screenshot path failed:", repr(exc))

    # Fallback operator path.
    try:
        with context.temp_override(
            window=window,
            screen=context.screen,
            area=area,
            region=region,
        ):
            result = bpy.ops.screen.screenshot_area(
                filepath=filepath,
                check_existing=False,
            )
        if result and 'FINISHED' in result and wait_for_file(filepath):
            return
        raise RuntimeError("screenshot_area returned {}".format(result))
    except Exception as fallback_error:
        raise RuntimeError(
            "Both screenshot methods failed. Window.screenshot: {}; "
            "screenshot_area: {}".format(primary_error, fallback_error)
        )


def image_dimensions(filepath):
    image = None
    try:
        image = bpy.data.images.load(filepath, check_existing=False)
        return int(image.size[0]), int(image.size[1])
    finally:
        if image:
            try:
                bpy.data.images.remove(image)
            except Exception:
                pass


def convert_png(context, source_png, target_path, image_format, quality):
    if image_format == 'PNG':
        shutil.copy2(source_png, target_path)
        return os.path.isfile(target_path) and os.path.getsize(target_path) > 0

    scene = context.scene
    settings = scene.render.image_settings
    old = {
        "file_format": settings.file_format,
        "quality": settings.quality,
        "compression": settings.compression,
        "color_mode": settings.color_mode,
    }
    image = None
    try:
        settings.file_format = image_format
        try:
            settings.color_mode = 'RGB'
        except Exception:
            pass
        if image_format in {'JPEG', 'TIFF'}:
            settings.quality = max(0, min(100, int(quality)))
        elif image_format == 'PNG':
            settings.compression = max(0, min(100, 100 - int(quality)))

        image = bpy.data.images.load(source_png, check_existing=False)
        image.filepath_raw = target_path
        image.file_format = image_format
        image.save()
        return os.path.isfile(target_path) and os.path.getsize(target_path) > 0
    finally:
        if image:
            try:
                bpy.data.images.remove(image)
            except Exception:
                pass
        for key, value in old.items():
            try:
                setattr(settings, key, value)
            except Exception:
                pass


# ---------------------------------------------------------------------------
# PROPERTIES
# ---------------------------------------------------------------------------

class QP_Props(bpy.types.PropertyGroup):
    render_filepath: StringProperty(
        name="Save Path", subtype='FILE_PATH',
        default="//quadview_render.mp4",
    )
    is_quad_active: BoolProperty(default=False)
    is_playblasting: BoolProperty(default=False)
    use_ffmpeg: BoolProperty(
        name="Use External FFmpeg",
        description="Try an installed FFmpeg executable before Blender VSE",
        default=False,
    )
    frame_step: IntProperty(
        name="Frame Step", default=1, min=1, max=10,
        description="Capture every Nth scene frame; playback timing is preserved",
    )
    resolution_scale: FloatProperty(
        name="Resolution Scale", default=1.0,
        min=0.25, max=1.0, subtype='FACTOR',
    )
    video_quality: IntProperty(
        name="Quality", default=90, min=0, max=100,
        subtype='PERCENTAGE',
    )
    image_format: EnumProperty(
        name="Image Format",
        items=[
            ('PNG', "PNG", "Lossless image"),
            ('JPEG', "JPEG", "Compressed image"),
            ('BMP', "BMP", "Bitmap image"),
            ('TIFF', "TIFF", "Tagged image"),
        ],
        default='PNG',
    )
    shading_mode: EnumProperty(
        name="Viewport Shading",
        items=[
            ('SOLID', "Solid", "Solid viewport shading"),
            ('MATERIAL', "Material Preview", "Material Preview shading"),
            ('RENDERED', "Rendered", "Rendered viewport shading"),
            ('WIREFRAME', "Wireframe", "Wireframe viewport shading"),
        ],
        default='SOLID',
    )


# ---------------------------------------------------------------------------
# QUAD VIEW TOGGLE
# ---------------------------------------------------------------------------

class QP_OT_switch_layout(bpy.types.Operator):
    bl_idname = "qp.switch_layout"
    bl_label = "Toggle Quad View"
    bl_description = "Toggle Quad View in the active 3D Viewport"

    @classmethod
    def poll(cls, context):
        return get_view3d_area(context) is not None

    def execute(self, context):
        area = get_view3d_area(context)
        region = get_window_region(area)
        if region is None:
            self.report({'ERROR'}, "No VIEW_3D WINDOW region found")
            return {'CANCELLED'}
        try:
            with context.temp_override(
                window=context.window, screen=context.screen,
                area=area, region=region,
            ):
                result = bpy.ops.screen.region_quadview()
            if not result or 'FINISHED' not in result:
                raise RuntimeError("Quad View operation did not finish")
            context.scene.qp_props.is_quad_active = bool(
                len(area.spaces.active.region_quadviews)
            )
            return {'FINISHED'}
        except Exception as exc:
            self.report({'ERROR'}, "Quad View failed: {}".format(exc))
            return {'CANCELLED'}


# ---------------------------------------------------------------------------
# SINGLE SCREENSHOT
# ---------------------------------------------------------------------------

class QP_OT_screenshot_quadview(bpy.types.Operator):
    bl_idname = "qp.screenshot_quadview"
    bl_label = "Playblast Screenshot"
    bl_description = "Save the current 3D Viewport as an image"

    @classmethod
    def poll(cls, context):
        return get_view3d_area(context) is not None

    def execute(self, context):
        props = context.scene.qp_props
        filepath = bpy.path.abspath(props.render_filepath or "//quadview_render")
        root, _ext = os.path.splitext(filepath)
        extension = {
            'PNG': '.png', 'JPEG': '.jpg',
            'BMP': '.bmp', 'TIFF': '.tif',
        }
        target = root + extension.get(props.image_format, '.png')
        ensure_folder(os.path.dirname(target))
        temp_png = target + ".capture_tmp.png"

        try:
            if os.path.exists(temp_png):
                os.remove(temp_png)
            capture_viewport_png(context, get_view3d_area(context), temp_png)
            if not wait_for_file(temp_png):
                raise RuntimeError("Temporary screenshot PNG is missing or empty")
            if not convert_png(
                context, temp_png, target,
                props.image_format, props.video_quality,
            ):
                raise RuntimeError("Could not write output image")
        except Exception as exc:
            traceback.print_exc()
            self.report({'ERROR'}, "Screenshot failed: {}".format(exc))
            return {'CANCELLED'}
        finally:
            try:
                if os.path.isfile(temp_png):
                    os.remove(temp_png)
            except Exception:
                pass

        self.report({'INFO'}, "Screenshot saved: {}".format(target))
        return {'FINISHED'}


# ---------------------------------------------------------------------------
# ANIMATION CAPTURE
# ---------------------------------------------------------------------------

class QP_OT_screenshot_quadview_anim(bpy.types.Operator):
    bl_idname = "qp.screenshot_quadview_anim"
    bl_label = "Playblast Animation"
    bl_description = "Capture the active VIEW_3D / Quad View animation"

    _timer = None
    _window_manager = None

    def execute(self, context):
        global _PLAYBLAST_RUNNING, _ACTIVE_PLAYBLAST_OPERATOR

        if _PLAYBLAST_RUNNING:
            self.report({'WARNING'}, "A Playblast is already running")
            return {'CANCELLED'}

        scene = context.scene
        props = scene.qp_props
        area = get_view3d_area(context)
        region = get_window_region(area)

        if area is None or region is None:
            self.report({'ERROR'}, "No usable VIEW_3D area was found")
            return {'CANCELLED'}

        self.scene = scene
        self.area = area
        self.region = region
        self.space = area.spaces.active
        self._window_manager = context.window_manager
        self._timer = None

        self.original_frame = scene.frame_current
        self.start = scene.frame_start
        self.end = scene.frame_end
        self.step = max(1, int(props.frame_step))
        self.frame = self.start
        self.capture_index = 1
        self.output_path = get_output_path(props.render_filepath)
        self.folder = get_temp_folder(self.output_path)

        self.old_settings = {}
        try:
            if hasattr(self.space, "shading"):
                self.old_settings["shading"] = self.space.shading.type
            if hasattr(self.space, "overlay"):
                self.old_settings["overlays"] = self.space.overlay.show_overlays
            for name in (
                "show_region_ui", "show_region_toolbar",
                "show_gizmo", "show_region_header",
            ):
                if hasattr(self.space, name):
                    self.old_settings[name] = getattr(self.space, name)

            if hasattr(self.space, "shading"):
                self.space.shading.type = props.shading_mode
            if hasattr(self.space, "overlay"):
                self.space.overlay.show_overlays = False
            for name in (
                "show_region_ui", "show_region_toolbar",
                "show_gizmo", "show_region_header",
            ):
                if hasattr(self.space, name):
                    setattr(self.space, name, False)

            clean_folder(self.folder)
            ensure_folder(self.folder)
        except Exception as exc:
            self.restore_state()
            self.report({'ERROR'}, "Could not prepare viewport: {}".format(exc))
            return {'CANCELLED'}

        _PLAYBLAST_RUNNING = True
        _ACTIVE_PLAYBLAST_OPERATOR = self
        props.is_playblasting = True

        try:
            scene.frame_set(self.frame)
            context.view_layer.update()
            area.tag_redraw()
            self._timer = context.window_manager.event_timer_add(
                0.12, window=context.window
            )
            context.window_manager.modal_handler_add(self)
        except Exception as exc:
            self.finish_capture(context)
            self.report({'ERROR'}, "Could not start Playblast: {}".format(exc))
            return {'CANCELLED'}

        self.report({'INFO'}, "Playblast capture started")
        return {'RUNNING_MODAL'}

    def modal(self, context, event):
        if event.type == 'ESC':
            self.finish_capture(context)
            self.report({'WARNING'}, "Cancelled. Captured PNG frames were retained.")
            return {'CANCELLED'}

        if event.type != 'TIMER':
            return {'PASS_THROUGH'}

        if self.frame > self.end:
            self.finish_capture(context)
            result = bpy.ops.qp.combine_images_to_video()
            return {'FINISHED'} if 'FINISHED' in result else {'CANCELLED'}

        try:
            self.scene.frame_set(self.frame)
            context.view_layer.update()
            self.area.tag_redraw()

            filepath = os.path.join(
                self.folder,
                "quadview_frame_{:04d}.png".format(self.capture_index),
            )
            if os.path.exists(filepath):
                os.remove(filepath)

            capture_viewport_png(context, self.area, filepath)
            if not wait_for_file(filepath):
                raise RuntimeError("Frame PNG was not written completely")

            print(
                "Playblast: captured scene frame {} -> {}".format(
                    self.frame, os.path.basename(filepath)
                )
            )
            self.frame += self.step
            self.capture_index += 1
            return {'RUNNING_MODAL'}

        except Exception as exc:
            failed_frame = self.frame
            traceback.print_exc()
            self.finish_capture(context)
            self.report(
                {'ERROR'},
                "Capture failed at frame {}: {}".format(failed_frame, exc),
            )
            return {'CANCELLED'}

    def restore_state(self):
        space = getattr(self, "space", None)
        if space is None:
            return
        for name, value in getattr(self, "old_settings", {}).items():
            try:
                if name == "shading":
                    space.shading.type = value
                elif name == "overlays":
                    space.overlay.show_overlays = value
                else:
                    setattr(space, name, value)
            except Exception as exc:
                print("Playblast: restore {} failed: {}".format(name, exc))

    def finish_capture(self, context):
        global _PLAYBLAST_RUNNING, _ACTIVE_PLAYBLAST_OPERATOR
        safe_remove_timer(self._window_manager, self._timer)
        self._timer = None
        self.restore_state()
        try:
            self.scene.frame_set(self.original_frame)
            context.view_layer.update()
        except Exception:
            pass
        try:
            self.scene.qp_props.is_playblasting = False
        except Exception:
            pass
        _PLAYBLAST_RUNNING = False
        _ACTIVE_PLAYBLAST_OPERATOR = None


# ---------------------------------------------------------------------------
# VIDEO ENCODING
# ---------------------------------------------------------------------------

class QP_OT_combine_images_to_video(bpy.types.Operator):
    bl_idname = "qp.combine_images_to_video"
    bl_label = "Combine Images to Video"
    bl_description = "Encode captured PNG frames into an MP4 video"

    def execute(self, context):
        props = context.scene.qp_props
        output_path = get_output_path(props.render_filepath)
        folder = get_temp_folder(output_path)
        images = get_frame_files(folder)

        if not images:
            self.report({'ERROR'}, "No Playblast PNG frames found")
            return {'CANCELLED'}

        ensure_folder(os.path.dirname(output_path))
        scene = context.scene

        source_fps = float(scene.render.fps)
        if scene.render.fps_base > 0:
            source_fps /= float(scene.render.fps_base)
        fps = source_fps / max(1, int(props.frame_step))
        if fps <= 0:
            fps = 24.0

        print("Playblast: encoding {} frames at {:.4f} FPS".format(len(images), fps))

        if props.use_ffmpeg:
            ffmpeg_path = shutil.which("ffmpeg")
            if ffmpeg_path and self.encode_with_ffmpeg(
                context, ffmpeg_path, output_path, folder, fps
            ):
                clean_folder(folder)
                return {'FINISHED'}
            self.report({'WARNING'}, "External FFmpeg unavailable/failed; trying Blender VSE")

        result = self.encode_with_vse(
            context, output_path, folder, images, fps
        )
        if 'FINISHED' in result:
            clean_folder(folder)
        return result

    def encode_with_ffmpeg(self, context, ffmpeg_path, output_path, folder, fps):
        props = context.scene.qp_props
        quality = max(0, min(100, int(props.video_quality)))
        crf = max(0, min(51, int(round((100 - quality) * 51 / 100.0))))
        scale = max(0.25, min(1.0, float(props.resolution_scale)))
        pattern = os.path.join(folder, "quadview_frame_%04d.png")
        scale_filter = "scale=trunc(iw*{}/2)*2:trunc(ih*{}/2)*2".format(scale, scale)

        command = [
            ffmpeg_path, "-hide_banner", "-loglevel", "error", "-y",
            "-framerate", "{:.8f}".format(fps),
            "-start_number", "1", "-i", pattern,
            "-vf", scale_filter,
            "-c:v", "libx264", "-preset", "medium",
            "-pix_fmt", "yuv420p", "-crf", str(crf),
            "-movflags", "+faststart", output_path,
        ]
        try:
            completed = subprocess.run(
                command, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE, text=True, check=False,
            )
            if completed.returncode != 0:
                print("FFmpeg error:\n{}".format(completed.stderr[-8000:]))
                return False
            if not os.path.isfile(output_path) or os.path.getsize(output_path) <= 0:
                return False
            self.report({'INFO'}, "MP4 created using external FFmpeg")
            return True
        except Exception as exc:
            print("FFmpeg launch failed:", repr(exc))
            return False

    def encode_with_vse(self, context, output_path, folder, images, fps):
        """
        Build a temporary scene and add one still-image strip per captured
        frame. Every strip is forced to 1 frame duration.
        """
        source_scene = context.scene
        temp_scene = None

        try:
            first_path = os.path.join(folder, images[0])
            if not os.path.isfile(first_path):
                raise RuntimeError("First captured PNG is missing: " + first_path)

            width, height = image_dimensions(first_path)
            if width < 2 or height < 2:
                raise RuntimeError("Invalid PNG dimensions: {}x{}".format(width, height))

            temp_scene = bpy.data.scenes.new("QP_Playblast_Encode_TEMP")
            temp_scene.render.engine = source_scene.render.engine

            editor = temp_scene.sequence_editor_create()
            strips = editor.strips

            # One still image strip per frame, forced to 1 frame duration.
            for index, filename in enumerate(images):
                image_path = os.path.join(folder, filename)
                if not os.path.isfile(image_path):
                    raise RuntimeError("Missing captured frame: " + image_path)

                strip = strips.new_image(
                    name="Playblast_{:04d}".format(index + 1),
                    filepath=image_path,
                    channel=1,
                    frame_start=index + 1,
                    fit_method='ORIGINAL',
                )
                if strip is None:
                    raise RuntimeError("Could not create VSE strip for " + filename)

                # *** FIX: Force each still to exactly 1 frame ***
                strip.frame_final_duration = 1

            frame_count = len(images)
            temp_scene.frame_start = 1
            temp_scene.frame_end = frame_count
            temp_scene.frame_set(1)

            scale = max(
                0.25,
                min(1.0, float(source_scene.qp_props.resolution_scale))
            )
            out_w = max(2, int(width * scale))
            out_h = max(2, int(height * scale))
            out_w -= out_w % 2
            out_h -= out_h % 2

            render = temp_scene.render
            render.resolution_x = out_w
            render.resolution_y = out_h
            render.resolution_percentage = 100

            # Use the captured output frame rate directly.
            render.fps = max(1, int(round(fps)))
            render.fps_base = render.fps / fps if fps > 0 else 1.0

            render.use_sequencer = True
            render.use_file_extension = True

            # Blender appends its movie extension to this extension-free base.
            output_root = os.path.splitext(output_path)[0]
            render.filepath = output_root

            image_settings = render.image_settings
            image_settings.file_format = 'FFMPEG'

            ffmpeg = render.ffmpeg
            ffmpeg.format = 'MPEG4'
            ffmpeg.codec = 'H264'
            try:
                ffmpeg.audio_codec = 'NONE'
            except Exception:
                pass
            try:
                ffmpeg.constant_rate_factor = 'MEDIUM'
            except Exception:
                pass
            try:
                ffmpeg.ffmpeg_preset = 'GOOD'
            except Exception:
                pass

            quality = max(
                0, min(100, int(source_scene.qp_props.video_quality))
            )
            try:
                ffmpeg.video_bitrate = int(500 + (quality / 100.0) * 49500)
            except Exception:
                pass

            # Copy compatible color-management settings.
            for owner_name, names in (
                ("view_settings", ("view_transform", "look", "exposure", "gamma")),
                ("display_settings", ("display_device",)),
            ):
                src = getattr(source_scene, owner_name, None)
                dst = getattr(temp_scene, owner_name, None)
                if src is not None and dst is not None:
                    for name in names:
                        try:
                            setattr(dst, name, getattr(src, name))
                        except Exception:
                            pass

            # Remove old target and possible Blender-generated target variants.
            for candidate in (
                output_path,
                output_root + ".mp4",
                output_root + ".mkv",
                output_root + ".mov",
            ):
                try:
                    if os.path.isfile(candidate):
                        os.remove(candidate)
                except Exception:
                    pass

            print(
                "Playblast VSE: {} frames, {}x{}, {:.4f} FPS, output base {}".format(
                    frame_count, out_w, out_h, fps, output_root
                )
            )

            # Render operator's scene argument is explicit. This avoids
            # accidentally rendering the active user scene.
            result = bpy.ops.render.render(
                animation=True,
                scene=temp_scene.name,
            )
            if not result or 'FINISHED' not in result:
                raise RuntimeError("bpy.ops.render.render returned {}".format(result))

            # Blender normally writes output_root + .mp4.
            candidates = [
                output_root + ".mp4",
                output_root + ".mkv",
                output_root + ".mov",
                output_path,
            ]
            generated = next(
                (
                    p for p in candidates
                    if os.path.isfile(p) and os.path.getsize(p) > 0
                ),
                None,
            )

            if generated is None:
                raise RuntimeError(
                    "VSE render returned FINISHED but no non-empty video was "
                    "created. Expected: {}".format(output_root + ".mp4")
                )

            if os.path.abspath(generated) != os.path.abspath(output_path):
                if os.path.exists(output_path):
                    os.remove(output_path)
                shutil.move(generated, output_path)

            if not os.path.isfile(output_path) or os.path.getsize(output_path) <= 0:
                raise RuntimeError("Final MP4 is missing or empty")

            size_mb = os.path.getsize(output_path) / (1024.0 * 1024.0)
            print("Playblast VSE SUCCESS: {} ({:.2f} MB)".format(output_path, size_mb))
            self.report({'INFO'}, "MP4 created with Blender VSE ({:.2f} MB)".format(size_mb))
            return {'FINISHED'}

        except Exception as exc:
            print("\n========== PLAYBLAST VSE ERROR ==========")
            traceback.print_exc()
            print("=========================================\n")
            self.report({'ERROR'}, "VSE encoding failed: {}".format(exc))
            return {'CANCELLED'}

        finally:
            if temp_scene is not None:
                try:
                    bpy.data.scenes.remove(temp_scene)
                except Exception as exc:
                    print("Playblast: temporary scene cleanup failed:", repr(exc))


