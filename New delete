def delete_bone_custom_properties(pb, frame):
    deleted = 0

    for key in get_bone_custom_properties(pb):

        try:
            if pb.keyframe_delete(
                data_path='["{}"]'.format(
                    str(key).replace("\\", "\\\\").replace('"', '\\"')
                ),
                frame=frame
            ):
                deleted += 1

        except Exception:
            pass

    return deleted


# ============================================================================
# DELETE OPERATOR
# ============================================================================

class DeleteKeyframeOperator(Operator):

    bl_idname = "object.delete_keyframe_by_interval"
    bl_label = "Delete Keyframes"
    bl_description = (
        "Delete selected animation channels at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return bool(context.selected_objects)

    def execute(self, context):

        props = context.scene.del_keyframe_props
        objects = list(context.selected_objects)

        if not objects:
            self.report(
                {'WARNING'},
                "No objects selected"
            )
            return {'CANCELLED'}

        frames = build_target_frames(props)

        if not frames:
            self.report(
                {'WARNING'},
                "No frames selected by the current interval settings"
            )
            status_message("No frames to process")
            return {'CANCELLED'}

        deleted = 0

        # ------------------------------------------------------------------
        # IMPORTANT:
        # Snapshot selected bones for every armature before processing.
        # ------------------------------------------------------------------

        armature_bones = {}

        for obj in objects:
            if obj.type == 'ARMATURE':
                armature_bones[obj.name] = get_selected_pose_bones(obj)

        # ------------------------------------------------------------------
        # PROCESS OBJECTS
        # ------------------------------------------------------------------

        for obj in objects:

            # Object transforms
            if props.pos or props.rot or props.scl:

                for frame in frames:
                    deleted += delete_object_transform_keys(
                        obj,
                        frame,
                        props
                    )

            # Bone animation
            if obj.type == 'ARMATURE':

                selected_bones = armature_bones.get(
                    obj.name,
                    []
                )

                if not selected_bones:
                    continue

                for pb in selected_bones:

                    for frame in frames:

                        deleted += delete_bone_transform_keys(
                            pb,
                            frame,
                            props
                        )

                        if props.custom_props:
                            deleted += delete_bone_custom_properties(
                                pb,
                                frame
                            )

        refresh_animation_editors(context)

        status_message(
            f"Deleted keyframes: {deleted}"
        )

        self.report(
            {'INFO'},
            f"Deleted keyframes: {deleted}"
        )

        return {'FINISHED'}


