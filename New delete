def insert_object_transform_keys(obj, frame, props):
    baked = 0

    try:
        if props.pos:
            obj.keyframe_insert(
                data_path="location",
                frame=frame
            )
            baked += 1
    except Exception:
        pass

    try:
        if props.rot:
            rotation_path = get_rotation_path(obj)

            obj.keyframe_insert(
                data_path=rotation_path,
