class Target:
    """One animated target: an Object or one of its PoseBones."""

    __slots__ = ("owner", "struct", "group", "is_bone")

    def __init__(self, owner, struct, group, is_bone):
        self.owner = owner
        self.struct = struct
        self.group = group
        self.is_bone = is_bone


def bone_is_visible(bone):
    """Check bone visibility with API fallbacks."""
    if bone is None:
        return True

    try:
        visible = getattr(bone, "is_visible", None)
        if visible is not None:
            return bool(visible)
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    try:
        hide = getattr(bone, "hide", None)
        if hide is not None:
            return not bool(hide)
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    return True


def _same_rna_item(a, b):
    """Compare Blender RNA wrappers without relying only on Python identity."""
    if a is b:
        return True

    try:
        return a.as_pointer() == b.as_pointer()
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        return False


def _pose_bone_selected(pb, context=None, owner=None):
    """Return True when the PoseBone is selected, using version-safe fallbacks."""
    # Blender 5.x exposes selection directly on PoseBone. Prefer this API.
    try:
        selected = getattr(pb, "select", None)
        if selected is not None:
            return bool(selected)
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    bone = getattr(pb, "bone", None)

    # Older builds expose a selection getter on Bone.
    if bone is not None:
        getter = getattr(bone, "select_get", None)
        if callable(getter):
            try:
                return bool(getter())
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                pass

        # Legacy fallback. Some Blender versions do not expose Bone.select.
        try:
            selected = getattr(bone, "select", None)
            if selected is not None:
                return bool(selected)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
            pass

    # Context fallback is useful for the active armature on older builds.
    if context is None:
        context = bpy.context

    try:
        if owner is None or context.object is owner:
            selected_bones = context.selected_pose_bones
        else:
            selected_bones = None
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        selected_bones = None

    if selected_bones:
        for selected_bone in selected_bones:
            if _same_rna_item(selected_bone, pb):
                return True

    return False


def selected_pose_bones(obj, context=None):
    if getattr(obj, "type", None) != 'ARMATURE':
        return []

    pose = getattr(obj, "pose", None)
    if pose is None:
        return []

    result = []

    for pb in pose.bones:
        if _pose_bone_selected(pb, context=context, owner=obj):
            if bone_is_visible(getattr(pb, "bone", None)):
                result.append(pb)

    return result


def collect_targets(context):
    """
    Pose Mode:
        Collect selected bones from every armature in the current Pose Mode set.
        The armature object does not need to be the active selected object.

    Object Mode:
        Collect selected objects.
    """
    targets = []

    if context.mode == 'POSE':
        objects = list(getattr(context, "objects_in_mode", None) or [])

        if not objects and context.object is not None:
            objects = [context.object]

        seen = set()

        for obj in objects:
            if getattr(obj, "type", None) != 'ARMATURE':
                continue

            try:
                key = obj.as_pointer()
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                key = id(obj)

            if key in seen:
                continue

            seen.add(key)

            for pb in selected_pose_bones(obj, context):
                targets.append(Target(obj, pb, pb.name, True))

    elif context.mode == 'OBJECT':
        for obj in context.selected_objects:
            targets.append(Target(obj, obj, OBJECT_GROUP, False))

    return targets


def group_by_owner(targets):
    groups = {}

    for target in targets:
        try:
            key = target.owner.as_pointer()
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
            key = id(target.owner)

        if key not in groups:
            groups[key] = (target.owner, [])

        groups[key][1].append(target)

    return list(groups.values())


def is_editable(owner):
    try:
        return owner.library is None or owner.override_library is not None
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        return False


def filter_usable_targets(targets, problems):
    """Skip linked read-only owners and owners in NLA tweak mode."""
    usable = []
    rejected = set()

    for target in targets:
        owner = target.owner

        try:
            key = owner.as_pointer()
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
            key = id(owner)

        if key in rejected:
            continue

        reason = None

        if not is_editable(owner):
            reason = "linked data is read-only"
        else:
            try:
                anim = owner.animation_data
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                anim = None

            if anim is not None and getattr(anim, "use_tweak_mode", False):
                reason = "NLA tweak mode is on (leave it first)"

        if reason:
            rejected.add(key)
            problems.append(f"{owner.name}: skipped, {reason}")
            continue

        usable.append(target)

    return usable


def describe_targets(context):
    if context.mode == 'POSE':
        count = len(collect_targets(context))
        return f"Selected bones: {count}" if count else "No bones selected (Pose Mode)"

    if context.mode == 'OBJECT':
        count = len(context.selected_objects)
        return f"Selected objects: {count}" if count else "No objects selected"

    return "Switch to Object or Pose Mode"


def nothing_selected_message(context):
    if context.mode == 'POSE':
        return "No bones selected - select bones in Pose Mode first"

    return "No objects selected"


