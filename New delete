    def execute(self, context):
        scene = context.scene
        settings = get_settings(context)

        settings.start_frame = scene.frame_start
        settings.end_frame = scene.frame_end + 1

        return {'FINISHED'}


class KEYFRAME_INTERVAL_OT_delete(Operator):

    bl_idname = "keyframe_interval.delete"
    bl_label = "Delete Keyframes"
    bl_description = (
        "Delete keyframes of selected bones (Pose Mode) or objects "
        "(Object Mode) at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return tool_poll(context)

    def execute(self, context):
        settings = get_settings(context)
        frames = build_target_frames(settings)

        if not frames:
            self.report(
                {'WARNING'},
                "No frames to process - check Start, End and Interval",
            )
            return {'CANCELLED'}

        targets = collect_targets(context)
        if not targets:
            self.report({'WARNING'}, nothing_selected_message(context))
            return {'CANCELLED'}

        flags = channel_flags(settings)
        if not any(flags):
            self.report({'WARNING'}, "No channel type is enabled")
            return {'CANCELLED'}

        messages = []
        targets = filter_usable_targets(targets, messages)
        if not targets:
            self.report(
                {'WARNING'},
                join_messages("No editable targets to process", messages),
            )
            return {'CANCELLED'}

        frame_set = set(frames)
        removed = 0
        changed = 0

        for owner, owner_targets in group_by_owner(targets):
            try:
                count, changed_curves = delete_keys_for_owner(
                    owner,
                    owner_targets,
                    flags,
                    frame_set,
                )
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError) as exc:
                traceback.print_exc()
                messages.append(f"{owner.name}: {exc}")
                continue

            if count:
                removed += count
                changed += changed_curves
                owner.update_tag()

        if removed == 0:
            self.report(
                {'WARNING'},
                join_messages(
                    "No keyframes found on the selection at those frames "
                    "(check Start / End / Interval and the selected channels)",
                    messages,
                ),
            )
            return {'CANCELLED'}

        context.view_layer.update()
        refresh_animation_editors(context)

        self.report(
            {'WARNING' if messages else 'INFO'},
            join_messages(
                f"Deleted {removed} keyframes on {changed} F-Curves",
                messages,
            ),
        )

        return {'FINISHED'}


class KEYFRAME_INTERVAL_OT_bake(Operator):

    bl_idname = "keyframe_interval.bake"
    bl_label = "Bake Keyframes"
    bl_description = (
        "Bake keyframes of selected bones (Pose Mode) or objects "
        "(Object Mode) at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return tool_poll(context)

    def execute(self, context):
        scene = context.scene
        settings = get_settings(context)
        frames = build_target_frames(settings)

        if not frames:
            self.report(
                {'WARNING'},
                "No frames to bake - check Start, End and Interval",
            )
            return {'CANCELLED'}

        targets = collect_targets(context)
        if not targets:
            self.report({'WARNING'}, nothing_selected_message(context))
            return {'CANCELLED'}

        flags = channel_flags(settings)
        if not any(flags):
            self.report({'WARNING'}, "No channel type is enabled")
            return {'CANCELLED'}

        messages = []
        targets = filter_usable_targets(targets, messages)
        if not targets:
            self.report(
                {'WARNING'},
                join_messages("No editable targets to bake", messages),
            )
            return {'CANCELLED'}

        try:
            channels = build_bake_channels(targets, flags)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError) as exc:
            traceback.print_exc()
            self.report({'ERROR'}, f"Could not prepare bake channels: {exc}")
            return {'CANCELLED'}

        if not channels:
            self.report(
                {'WARNING'},
                join_messages("Nothing to bake on the selection", messages),
            )
            return {'CANCELLED'}

        # ------------------------------------------------------------------
        # 1) Sample every requested frame before writing any new keys.
        # ------------------------------------------------------------------
        wm = context.window_manager
        original_frame = scene.frame_current
        original_subframe = scene.frame_subframe
        sample_error = None

        wm.progress_begin(0, len(frames))

        try:
            for frame_index, frame in enumerate(frames):
                scene.frame_set(frame)

                for channel in channels:
                    channel.values.append(channel.read())

                wm.progress_update(frame_index + 1)

        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError) as exc:
            traceback.print_exc()
            sample_error = exc

        finally:
            wm.progress_end()
            scene.frame_set(original_frame, subframe=original_subframe)

        if sample_error is not None:
            self.report({'ERROR'}, f"Sampling failed: {sample_error}")
            return {'CANCELLED'}

        # ------------------------------------------------------------------
        # 2) Write the sampled values into the assigned Action Slot.
        # ------------------------------------------------------------------
        written, curve_count, locked, errors, owners = write_channels(
            channels,
            frames,
        )
        messages.extend(errors)

        if locked:
            messages.append(f"{locked} locked F-Curves skipped")

        for owner in owners:
            try:
                owner.update_tag()
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                pass

        context.view_layer.update()
        refresh_animation_editors(context)

        if written == 0:
            self.report(
                {'WARNING'},
                join_messages("No keyframes were written", messages),
            )
            return {'CANCELLED'}

        self.report(
            {'WARNING' if messages else 'INFO'},
            join_messages(
                f"Baked {written} keyframes on {curve_count} F-Curves",
                messages,
            ),
        )

        return {'FINISHED'}


