def _all_channels_update(self, context):
    # Keep the (greyed-out) individual toggles in sync with "All Channels".
    if self.all_channels:
        self.pos = True
        self.rot = True
        self.scl = True
        self.custom_props = True


class KeyframeIntervalSettings(PropertyGroup):

    start_frame: IntProperty(
        name="Start Frame",
        description="First frame to process",
        default=1,
    )

    end_frame: IntProperty(
        name="End Frame",
        description="Frame where processing stops (this frame itself is NOT included)",
        default=250,
    )

    interval: IntProperty(
        name="Interval",
        description=(
            "Number of frames between the frames that are kept "
            "(0 = process every frame)"
        ),
        default=0,
        min=0,
        max=500,
    )

    inverse_interval: BoolProperty(
        name="Inverse Interval",
        description="Process only the kept frames instead of the in-between frames",
        default=False,
    )

    pos: BoolProperty(name="Position", default=True)
    rot: BoolProperty(name="Rotation", default=True)
    scl: BoolProperty(name="Scale", default=True)

    custom_props: BoolProperty(
        name="Custom Properties",
        description="Bone custom properties (numeric ones only)",
        default=True,
    )

    all_channels: BoolProperty(
        name="All Channels",
        description="Position, rotation, scale and bone custom properties",
        default=True,
        update=_all_channels_update,
    )


def get_settings(context):
    return getattr(context.scene, SETTINGS_ATTR)


def channel_flags(settings):
    """(use_pos, use_rot, use_scl, use_custom) - 'All Channels' overrides the rest."""
    if settings.all_channels:
        return True, True, True, True

    return (
        bool(settings.pos),
        bool(settings.rot),
        bool(settings.scl),
        bool(settings.custom_props),
    )


# ============================================================================
# TARGETS  (what will be affected)
# ============================================================================

class Target:
    """One animated thing: an object, or a pose bone of an armature object."""

    __slots__ = ("owner", "struct", "group", "is_bone")

    def __init__(self, owner, struct, group, is_bone):
        self.owner = owner      # the Object that owns the animation data
        self.struct = struct    # the Object itself, or its PoseBone
        self.group = group      # F-Curve group name for newly created curves
        self.is_bone = is_bone


def bone_is_visible(bone):
    visible = getattr(bone, "is_visible", None)

    if visible is not None:
        return bool(visible)

    return not bone.hide


def selected_pose_bones(obj):
    pose = getattr(obj, "pose", None)

    if obj.type != 'ARMATURE' or pose is None:
        return []

    return [
        pb for pb in pose.bones
        if pb.bone.select and bone_is_visible(pb.bone)
    ]


def collect_targets(context):
    """
    Pose Mode   -> selected bones of every armature that is in Pose Mode
                   (works even if the armature OBJECT itself is not selected)
    Object Mode -> selected objects
    """
    targets = []

    if context.mode == 'POSE':
        objects = list(getattr(context, "objects_in_mode", None) or [])

        if not objects and context.object is not None:
            objects = [context.object]

        seen = set()

        for obj in objects:
            if obj.type != 'ARMATURE':
                continue

            key = obj.as_pointer()

            if key in seen:
                continue

            seen.add(key)

            for pb in selected_pose_bones(obj):
                targets.append(Target(obj, pb, pb.name, True))

    else:
        for obj in context.selected_objects:
            targets.append(Target(obj, obj, OBJECT_GROUP, False))

    return targets


def group_by_owner(targets):
    groups = {}

    for target in targets:
        key = target.owner.as_pointer()

        if key not in groups:
            groups[key] = (target.owner, [])

        groups[key][1].append(target)

    return list(groups.values())


def is_editable(owner):
    return owner.library is None or owner.override_library is not None


def filter_usable_targets(targets, problems):
    """Drop owners we must not touch (linked data, NLA tweak mode)."""
    usable = []
    rejected = set()

    for target in targets:
        owner = target.owner
        key = owner.as_pointer()

        if key in rejected:
            continue

        reason = None

        if not is_editable(owner):
            reason = "linked data is read-only"
        else:
            anim = owner.animation_data

            if anim is not None and getattr(anim, "use_tweak_mode", False):
                reason = "NLA tweak mode is on (leave it first)"

        if reason:
            rejected.add(key)
            problems.append(f"{owner.name}: skipped, {reason}")
            continue

        usable.append(target)

    return usable


def describe_targets(context):
    if context.mode == 'POSE':
        count = len(collect_targets(context))

        if count:
            return f"Selected bones: {count}"

        return "No bones selected (Pose Mode)"

    if context.mode == 'OBJECT':
        count = len(context.selected_objects)

        if count:
            return f"Selected objects: {count}"

        return "No objects selected"

    return "Switch to Object or Pose Mode"


def nothing_selected_message(context):
    if context.mode == 'POSE':
        return "No bones selected - select bones in Pose Mode first"

    return "No objects selected"


# ============================================================================
# ANIMATION DATA HELPERS  (slotted actions: Blender 4.4+ / 5.x)
# ============================================================================

def find_channelbag(anim, action):
    """Channelbag (= the F-Curves) of the slot assigned to this animation data."""
    slot = getattr(anim, "action_slot", None)

    if slot is None:
        return None

    try:
        from bpy_extras import anim_utils
        return anim_utils.action_get_channelbag_for_slot(action, slot)
    except (ImportError, AttributeError):
        pass

    for layer in action.layers:
        for strip in layer.strips:
            if strip.type == 'KEYFRAME':
                bag = strip.channelbag(slot)

                if bag is not None:
                    return bag

    return None


def get_fcurves(owner):
    """(list of F-Curves, remove function) for the action assigned to `owner`."""
    anim = owner.animation_data
    action = anim.action if anim is not None else None

    if action is None:
        return [], None

    if hasattr(action, "layers"):               # Blender 4.4+ / 5.x
        bag = find_channelbag(anim, action)

        if bag is None:
            return [], None

        return list(bag.fcurves), bag.fcurves.remove

    return list(action.fcurves), action.fcurves.remove    # Blender <= 4.3


def escape_identifier(name):
    fn = getattr(bpy.utils, "escape_identifier", None)

    if fn is not None:
        return fn(name)

    return name.replace("\\", "\\\\").replace('"', '\\"')


def rotation_prop(struct):
    mode = struct.rotation_mode

    if mode == 'QUATERNION':
        return "rotation_quaternion"

    if mode == 'AXIS_ANGLE':
        return "rotation_axis_angle"

    return "rotation_euler"


# ============================================================================
# DELETE
# ============================================================================

def remove_keys_at_frames(fcurve, frame_set):
    """Remove the keyframes that sit exactly on one of `frame_set`."""
    points = fcurve.keyframe_points
    count = len(points)

    if count == 0:
        return 0

    co = [0.0] * (count * 2)
    points.foreach_get("co", co)

    hits = []

    for i in range(count):
        x = co[i * 2]
        frame = round(x)

        if frame in frame_set and abs(x - frame) < 1e-3:
            hits.append(i)

    if not hits:
        return 0

    for i in reversed(hits):
        points.remove(points[i], fast=True)

    fcurve.update()

    return len(hits)


def delete_keys_for_owner(owner, targets, flags, frame_set):
    """Returns (keyframes removed, F-Curves changed)."""
    use_pos, use_rot, use_scl, use_custom = flags

    fcurves, remove_fcurve = get_fcurves(owner)

    if not fcurves:
        return 0, 0

    exact_paths = set()
    custom_prefixes = []

    for target in targets:
        struct = target.struct

        if use_pos:
            exact_paths.add(struct.path_from_id("location"))

        if use_rot:
            exact_paths.update(struct.path_from_id(p) for p in ROTATION_PROPS)

        if use_scl:
            exact_paths.add(struct.path_from_id("scale"))

        if use_custom and target.is_bone:
            custom_prefixes.append(struct.path_from_id() + '["')

    custom_prefixes = tuple(custom_prefixes)

    removed = 0
    changed = 0
    emptied = []

    for fcurve in fcurves:
        path = fcurve.data_path

        wanted = path in exact_paths or (
            custom_prefixes and path.startswith(custom_prefixes)
        )

        if not wanted or fcurve.lock:
            continue

        count = remove_keys_at_frames(fcurve, frame_set)

        if count:
            removed += count
            changed += 1

            if len(fcurve.keyframe_points) == 0:
                emptied.append(fcurve)

    # Same as Blender: an F-Curve without keys is removed.
    for fcurve in emptied:
        remove_fcurve(fcurve)

    return removed, changed


# ============================================================================
# BAKE
# ============================================================================

def custom_prop_info(struct, key):
    """(count, is_array) for numeric custom properties, (0, False) otherwise."""
    try:
        value = struct[key]
    except Exception:
        return 0, False

    if isinstance(value, (bool, int, float)):
        return 1, False

    if isinstance(value, (str, bytes)) or hasattr(value, "keys"):
        return 0, False

    try:
        count = len(value)

        if count and all(isinstance(v, (bool, int, float)) for v in value):
            return count, True
    except TypeError:
        pass

    return 0, False


class BakeChannel:
    """One property (e.g. a bone's location) that is sampled and then keyed."""

    __slots__ = (
        "owner", "struct", "kind", "key", "data_path",
        "group", "count", "is_array", "values",
    )

    def __init__(self, owner, struct, kind, key, data_path, group, count, is_array=True):
        self.owner = owner
        self.struct = struct
        self.kind = kind            # "rna" or "custom"
        self.key = key
        self.data_path = data_path
        self.group = group
        self.count = count
        self.is_array = is_array
        self.values = []            # one list of `count` floats per sampled frame

    def read(self):
        if self.kind == "rna":
            return list(getattr(self.struct, self.key))

        value = self.struct[self.key]

        if self.is_array:
            return [float(v) for v in value]

        return [float(value)]


def build_bake_channels(targets, flags):
    use_pos, use_rot, use_scl, use_custom = flags
    channels = []

    for target in targets:
        struct = target.struct

        rna_props = []

        if use_pos:
            rna_props.append("location")

        if use_rot:
            rna_props.append(rotation_prop(struct))

        if use_scl:
            rna_props.append("scale")

        for prop in rna_props:
            channels.append(
                BakeChannel(
                    target.owner, struct, "rna", prop,
                    struct.path_from_id(prop), target.group,
                    len(getattr(struct, prop)),
                )
            )

        if use_custom and target.is_bone:
            base = struct.path_from_id()

            for key in struct.keys():
                if key == "_RNA_UI":
                    continue

                count, is_array = custom_prop_info(struct, key)

                if not count:
                    continue

                channels.append(
                    BakeChannel(
                        target.owner, struct, "custom", key,
                        base + '["{}"]'.format(escape_identifier(key)),
                        target.group, count, is_array,
                    )
                )

    return channels


def ensure_slot(owner, anim, action):
    slot = anim.action_slot

    if slot is not None:
        return slot

    wanted = "OB" + owner.name

    for candidate in action.slots:
        if getattr(candidate, "identifier", None) == wanted:
            slot = candidate
            break

    if slot is None:
        slot = action.slots.new(id_type='OBJECT', name=owner.name)

    anim.action_slot = slot

    return slot


def ensure_channelbag(action, slot):
    try:
        from bpy_extras import anim_utils
        ensure = getattr(anim_utils, "action_ensure_channelbag_for_slot", None)

        if ensure is not None:
            return ensure(action, slot)
    except ImportError:
        pass

    layer = action.layers[0] if len(action.layers) else action.layers.new("Layer")
    strip = layer.strips[0] if len(layer.strips) else layer.strips.new(type='KEYFRAME')

    return strip.channelbag(slot, ensure=True)


class AnimStore:
    """Finds or creates the F-Curves of one object (slotted-action aware)."""

    def __init__(self, owner):
        self.owner = owner

        anim = owner.animation_data

        if anim is None:
            anim = owner.animation_data_create()

        action = anim.action

        if action is None:
            action = bpy.data.actions.new(owner.name + "Action")
            anim.action = action

        self.action = action
        self.bag = None

        if hasattr(action, "layers"):           # Blender 4.4+ / 5.x
            slot = ensure_slot(owner, anim, action)
            self.bag = ensure_channelbag(action, slot)

    def fcurve(self, data_path, index, group):
        if self.bag is not None:
            return self.bag.fcurves.ensure(
                data_path, index=index, group_name=group
            )

        fcurve = self.action.fcurves.find(data_path, index=index)    # <= 4.3

        if fcurve is None:
            fcurve = self.action.fcurves.new(
                data_path, index=index, action_group=group
            )

        return fcurve


def write_channels(channels, frames):
    """
    Insert the sampled values.
    Returns (keys written, F-Curves written, locked F-Curves skipped, errors, owners).
    """
    stores = {}
    written = 0
    curves = 0
    locked = 0
    errors = []

    for channel in channels:
        try:
            pointer = channel.owner.as_pointer()
            store = stores.get(pointer)

            if store is None:
                store = AnimStore(channel.owner)
                stores[pointer] = store

            for index in range(channel.count):
                fcurve = store.fcurve(channel.data_path, index, channel.group)

                if fcurve.lock:
                    locked += 1
                    continue

                points = fcurve.keyframe_points

                for frame, values in zip(frames, channel.values):
                    points.insert(frame, values[index], options={'FAST'})

                fcurve.update()

                written += len(frames)
                curves += 1

        except Exception as exc:
            traceback.print_exc()
            errors.append(f"{channel.owner.name}: {exc}")

    return written, curves, locked, errors, [s.owner for s in stores.values()]


