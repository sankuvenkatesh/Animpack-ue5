def refresh_animation_editors(context):
    """Redraw only the active area; avoid scanning every window and editor."""
    area = getattr(context, "area", None)
    if area is not None:
        area.tag_redraw()


def tool_poll(context):
    return context.mode in {'OBJECT', 'POSE'}


def join_messages(base_text, messages):
    if messages:
        return f"{base_text}  ({messages[0]})"
    return base_text


def safe_describe_targets(context):
    try:
        return describe_targets(context)
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        return "Selection info unavailable"


