# ============================================================================
# PROPERTIES
# ============================================================================

class DelKeyProperties(PropertyGroup):

    start_frame: bpy.props.IntProperty(
        name="Start Frame",
        default=1,
        min=0,
        update=lambda self, ctx: self._schedule_preview(ctx)
    )

    end_frame: bpy.props.IntProperty(
        name="End Frame",
        default=250,
        min=1,
        update=lambda self, ctx: self._schedule_preview(ctx)
    )

    interval: bpy.props.IntProperty(
        name="Interval",
        default=0,
        min=0,
        max=500,
        update=lambda self, ctx: self._schedule_preview(ctx)
    )

    inverse_interval: bpy.props.BoolProperty(
        name="Inverse Interval",
        default=False,
        update=lambda self, ctx: self._schedule_preview(ctx)
    )

    pos: bpy.props.BoolProperty(
        name="Position",
        default=True
    )

    rot: bpy.props.BoolProperty(
        name="Rotation",
        default=True
    )

    scl: bpy.props.BoolProperty(
        name="Scale",
        default=True
    )

    custom_props: bpy.props.BoolProperty(
        name="Custom Properties",
        description="Bone custom properties only",
        default=False
    )

    all_channels: bpy.props.BoolProperty(
        name="All Channels",
        default=True,
        update=lambda self, ctx: self._all_channels_update(ctx)
    )

    preview_keyframes: bpy.props.StringProperty(
        default=""
    )

    preview_count: bpy.props.IntProperty(
        default=0
    )

    _preview_timer_pending = False

    def _all_channels_update(self, context):
        if self.all_channels:
            self.pos = True
            self.rot = True
            self.scl = True
            self.custom_props = True

        self._schedule_preview(context)

    def _schedule_preview(self, context):
        """
        Schedule a preview update without creating a large number
        of simultaneous timers while the user is dragging properties.
        """

        if self._preview_timer_pending:
            return

        self._preview_timer_pending = True

        props = self

        def callback():
            props._preview_timer_pending = False

            try:
                update_live_preview(
                    bpy.context.scene,
                    props
                )
            except Exception:
                pass

            return None

        try:
            bpy.app.timers.register(
                callback,
                first_interval=0.05
            )
        except Exception:
            self._preview_timer_pending = False


# ============================================================================
# FRAME / INTERVAL UTILITIES
# ============================================================================

def get_frame_range(props):
    """
    End frame is treated as exclusive, matching the original addon.
    """

    start = int(props.start_frame)
    end = int(props.end_frame)

    if end <= start:
        return None

    return start, end


def build_target_frames(props):
    """
    Build the exact frames affected by Delete/Bake.

    interval = 0:
        Normal mode  -> every frame
        Inverse mode -> no frames

    interval > 0:
        Example:
            start = 1
            interval = 2

        key frames:
            1, 4, 7, 10...

        Normal:
            everything EXCEPT those frames

        Inverse:
            only those frames
    """

    frame_range = get_frame_range(props)

    if frame_range is None:
        return []

    start, end = frame_range
    interval = int(props.interval)

    if interval == 0:
        if props.inverse_interval:
            return []

        return list(range(start, end))

    step = interval + 1

    key_frames = set(range(start, end, step))

    if props.inverse_interval:
        return sorted(key_frames)

    return [
        frame
        for frame in range(start, end)
        if frame not in key_frames
    ]


def frame_allowed(frame, interval, key_frames, inverse):
    """
    Kept as a utility for compatibility with the original logic.
    """

    if interval == 0:
        return not inverse

    if inverse:
        return frame in key_frames

    return frame not in key_frames


# ============================================================================
# LIVE PREVIEW
# ============================================================================

def update_live_preview(scene, props):

    frame_range = get_frame_range(props)

    if frame_range is None:
        props.preview_keyframes = "Invalid frame range"
        props.preview_count = 0
        return

    frames = build_target_frames(props)

    props.preview_keyframes = ", ".join(
        str(f) for f in frames[:15]
    )

    if len(frames) > 15:
        props.preview_keyframes += "..."

    props.preview_count = len(frames)


# ============================================================================
# ANIMATION HELPERS
# ============================================================================

def get_selected_pose_bones(obj):
    """
    Return selected pose bones belonging to this specific armature.

    This avoids using context.selected_pose_bones, which can become
    incorrect when multiple armatures are selected.
    """

    if obj.type != 'ARMATURE':
        return []

    result = []

    try:
        for pb in obj.pose.bones:
            if pb.bone.select:
                result.append(pb)
    except Exception:
        pass

    return result


def get_rotation_path(id_data):
    """
    Return the correct rotation RNA path.
    """

    if id_data.rotation_mode == 'QUATERNION':
        return "rotation_quaternion"

    if id_data.rotation_mode == 'AXIS_ANGLE':
        return "rotation_axis_angle"

    return "rotation_euler"


def get_bone_custom_property_path(pb, key):
    """
    Build a reliable custom-property path.

    PoseBone.path_from_id() gives us the correct bone path,
    including Blender's required escaping for the bone name.
    """

    return pb.path_from_id() + '["{}"]'.format(
        str(key).replace("\\", "\\\\").replace('"', '\\"')
    )


def has_bone_custom_property(pb, key):
    try:
        return key in pb.keys() and key != "_RNA_UI"
    except Exception:
        return False


def get_bone_custom_properties(pb):
    """
    Return user-created custom properties only.
    """

    try:
        return [
            key
            for key in pb.keys()
            if key != "_RNA_UI"
        ]
    except Exception:
        return []


def refresh_animation_editors(context):
    """
    Refresh Timeline / Dope Sheet / Graph Editor.
    """

    wm = context.window_manager

    for window in wm.windows:
        screen = window.screen

        if not screen:
            continue

        for area in screen.areas:
            if area.type in {
                'TIMELINE',
                'GRAPH_EDITOR',
                'DOPESHEET_EDITOR'
            }:
                area.tag_redraw()


def status_message(text, clear_after=3.0):
    """
    Display a temporary status message safely.
    """

    try:
        workspace = bpy.context.workspace

        if workspace is None:
            return

        workspace.status_text_set(text)

        def clear():
            try:
                if bpy.context.workspace:
                    bpy.context.workspace.status_text_set(None)
            except Exception:
                pass

            return None

        bpy.app.timers.register(
            clear,
            first_interval=clear_after
        )

    except Exception:
        pass


# ============================================================================
# OBJECT KEYFRAME DELETE
# ============================================================================

def delete_object_transform_keys(obj, frame, props):
    deleted = 0

    try:
        if props.pos:
            if obj.keyframe_delete(
                data_path="location",
                frame=frame
            ):
                deleted += 1
    except Exception:
        pass

    try:
        if props.rot:
            rotation_path = get_rotation_path(obj)

            if obj.keyframe_delete(
                data_path=rotation_path,
                frame=frame
            ):
                deleted += 1
    except Exception:
        pass

    try:
        if props.scl:
            if obj.keyframe_delete(
                data_path="scale",
                frame=frame
            ):
                deleted += 1
    except Exception:
        pass

    return deleted


