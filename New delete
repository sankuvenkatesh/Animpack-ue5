def refresh_animation_editors(context):
    for window in context.window_manager.windows:
        screen = window.screen

        if not screen:
            continue

        for area in screen.areas:
            if area.type in {'GRAPH_EDITOR', 'DOPESHEET_EDITOR', 'NLA_EDITOR', 'VIEW_3D'}:
                area.tag_redraw()


def tool_poll(context):
    # Deliberately NOT based on the object selection: in Pose Mode the armature
    # object is often not "selected", which used to grey the buttons out.
    return context.mode in {'OBJECT', 'POSE'}


def join_messages(text, messages):
    if messages:
        return f"{text}  ({messages[0]})"

    return text


def safe_describe_targets(context):
    try:
        return describe_targets(context)
    except Exception:
        return "Selection info unavailable"


