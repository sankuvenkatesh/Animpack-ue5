class KEYFRAME_INTERVAL_OT_scene_range(Operator):

    bl_idname = "keyframe_interval.scene_range"
    bl_label = "Use Scene Range"
    bl_description = (
        "Set Start / End from the scene frame range "
        "(End = scene end + 1, because End itself is not processed)"
    )
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        scene = context.scene
        settings = get_settings(context)

        settings.start_frame = scene.frame_start
        settings.end_frame = scene.frame_end + 1

        return {'FINISHED'}


class KEYFRAME_INTERVAL_OT_delete(Operator):

    bl_idname = "keyframe_interval.delete"
    bl_label = "Delete Keyframes"
    bl_description = (
        "Delete keyframes of the selected bones (Pose Mode) or objects "
        "(Object Mode) at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return tool_poll(context)

    def execute(self, context):
        settings = get_settings(context)

        frames = build_target_frames(settings)

        if not frames:
            self.report({'WARNING'}, "No frames to process - check Start, End and Interval")
            return {'CANCELLED'}

        targets = collect_targets(context)

        if not targets:
            self.report({'WARNING'}, nothing_selected_message(context))
            return {'CANCELLED'}

        flags = channel_flags(settings)

        if not any(flags):
            self.report({'WARNING'}, "No channel type is enabled")
            return {'CANCELLED'}

        messages = []
        targets = filter_usable_targets(targets, messages)
        frame_set = set(frames)

        removed = 0
        changed = 0

        for owner, owner_targets in group_by_owner(targets):
            try:
                count, curves = delete_keys_for_owner(
                    owner, owner_targets, flags, frame_set
                )
            except Exception as exc:
                traceback.print_exc()
                messages.append(f"{owner.name}: {exc}")
                continue

            if count:
                removed += count
                changed += curves
                owner.update_tag()

        if removed == 0:
            self.report(
                {'WARNING'},
                join_messages(
                    "No keyframes found on the selection at those frames "
                    "(check Start / End / Interval and the selected channels)",
                    messages,
                ),
            )
            return {'CANCELLED'}

        context.view_layer.update()
        refresh_animation_editors(context)

        self.report(
            {'WARNING' if messages else 'INFO'},
            join_messages(
                f"Deleted {removed} keyframes on {changed} F-Curves", messages
            ),
        )

        return {'FINISHED'}


class KEYFRAME_INTERVAL_OT_bake(Operator):

    bl_idname = "keyframe_interval.bake"
    bl_label = "Bake Keyframes"
    bl_description = (
        "Bake keyframes of the selected bones (Pose Mode) or objects "
        "(Object Mode) at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return tool_poll(context)

    def execute(self, context):
        scene = context.scene
        settings = get_settings(context)

        frames = build_target_frames(settings)

        if not frames:
            self.report({'WARNING'}, "No frames to bake - check Start, End and Interval")
            return {'CANCELLED'}

        targets = collect_targets(context)

        if not targets:
            self.report({'WARNING'}, nothing_selected_message(context))
            return {'CANCELLED'}

        flags = channel_flags(settings)

        if not any(flags):
            self.report({'WARNING'}, "No channel type is enabled")
            return {'CANCELLED'}

        messages = []
        targets = filter_usable_targets(targets, messages)
        channels = build_bake_channels(targets, flags)

        if not channels:
            self.report(
                {'WARNING'},
                join_messages("Nothing to bake on the selection", messages),
            )
            return {'CANCELLED'}

        # ------------------------------------------------------------------
        # 1) Sample every frame first ...
        # ------------------------------------------------------------------
        wm = context.window_manager
        original_frame = scene.frame_current
        original_subframe = scene.frame_subframe

        wm.progress_begin(0, len(frames))

        try:
            for i, frame in enumerate(frames):
                scene.frame_set(frame)

                for channel in channels:
                    channel.values.append(channel.read())

                wm.progress_update(i + 1)
        finally:
            wm.progress_end()
            scene.frame_set(original_frame, subframe=original_subframe)

        # ------------------------------------------------------------------
        # 2) ... then write the keys.
        # ------------------------------------------------------------------
        written, curves, locked, errors, owners = write_channels(channels, frames)
        messages.extend(errors)

        if locked:
            messages.append(f"{locked} locked F-Curves skipped")

        for owner in owners:
            owner.update_tag()

        context.view_layer.update()
        refresh_animation_editors(context)

        if written == 0:
            self.report(
                {'WARNING'},
                join_messages("No keyframes were written", messages),
            )
            return {'CANCELLED'}

        self.report(
            {'WARNING' if messages else 'INFO'},
            join_messages(
                f"Baked {written} keyframes on {curves} F-Curves", messages
            ),
        )

        return {'FINISHED'}


