"""
Keyframe Tools Interval  -  v3.1.0  (Blender 5.1+)

Delete or bake keyframes at an interval on
  * selected bones   (Pose Mode)   : position / rotation / scale + numeric bone custom properties
  * selected objects (Object Mode) : position / rotation / scale

Install: Edit > Preferences > Add-ons > Install from Disk (or run it from the Text Editor).
Panel  : 3D Viewport > Sidebar (N) > Item tab > "Keyframe Interval Tools".

What changed in 3.1.0
  * The Delete / Bake buttons sit at the TOP of the panel and are enabled in Object
    Mode and Pose Mode no matter what is selected (the old poll needed a *selected
    object*, which is often not the case in Pose Mode, so the buttons were greyed out).
  * Unique operator / panel / property ids, so an older copy of this add-on can no
    longer clash with (or remove) the buttons of this one.
  * Keys are edited directly on the F-Curves of the action slot assigned to the object
    (Blender 4.4+/5.x slotted actions) instead of tens of thousands of
    keyframe_insert()/keyframe_delete() calls whose errors were hidden by "except: pass".
  * Bake samples ALL frames first and writes the keys afterwards (no curve drift).
  * Pose Mode only touches the selected bones (not the armature object itself); every
    armature in Pose Mode is handled; hidden bones are ignored.
  * "All Channels" really means everything (custom properties used to stay off).
  * Real counts / errors are shown in the status bar and the System Console.
"""

bl_info = {
    "name": "Keyframe Tools Interval",
    "author": "Venkatesh Sanku",
    "version": (3, 1, 0),
    "blender": (5, 1, 0),
    "location": "View3D > Sidebar > Item",
    "description": "Delete or bake keyframes by interval on transforms and bone custom properties",
    "category": "Animation",
}

import traceback
from itertools import islice

import bpy
from bpy.props import BoolProperty, IntProperty, PointerProperty
from bpy.types import Operator, Panel, PropertyGroup


ROTATION_PROPS = ("rotation_euler", "rotation_quaternion", "rotation_axis_angle")
OBJECT_GROUP = "Object Transforms"
SETTINGS_ATTR = "keyframe_interval_settings"


# ============================================================================
# FRAME / INTERVAL LOGIC  (pure python, touches no Blender data)
# ============================================================================

def get_frame_range(settings):
    """End frame is exclusive, like in the original add-on."""
    start = int(settings.start_frame)
    end = int(settings.end_frame)

    if end <= start:
        return None

    return start, end


def iter_target_frames(start, end, interval, inverse):
    """
    interval = 0 : normal -> every frame            | inverse -> no frame
    interval = n : the frames start, start+(n+1), start+2(n+1) ... are "kept"
                   normal  -> every OTHER frame (the in-betweens)
                   inverse -> only the kept frames
    """
    if interval <= 0:
        if not inverse:
            yield from range(start, end)
        return

    step = interval + 1

    if inverse:
        yield from range(start, end, step)
    else:
        for frame in range(start, end):
            if (frame - start) % step:
                yield frame


def count_target_frames(start, end, interval, inverse):
    total = end - start

    if total <= 0:
        return 0

    if interval <= 0:
        return 0 if inverse else total

    kept = len(range(start, end, interval + 1))

    return kept if inverse else total - kept


def build_target_frames(settings):
    frame_range = get_frame_range(settings)

    if frame_range is None:
        return []

    return list(
        iter_target_frames(
            frame_range[0],
            frame_range[1],
            int(settings.interval),
            bool(settings.inverse_interval),
        )
    )


