class VIEW3D_PT_kfi_tools(Panel):

    bl_label = "Keyframe Interval Tools"
    bl_idname = "VIEW3D_PT_kfi_tools"

    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = 'Item'

    def draw(self, context):
        layout = self.layout

        # Buttons first: always drawn, whatever happens further down. -----------
        row = layout.row(align=True)
        row.scale_y = 1.3
        row.operator(KEYFRAME_INTERVAL_OT_delete.bl_idname, icon='KEY_HLT')
        row.operator(KEYFRAME_INTERVAL_OT_bake.bl_idname, icon='REC')

        layout.label(text=safe_describe_targets(context))

        settings = get_settings(context)

        # Frame range --------------------------------------------------------
        layout.separator()
        layout.label(text="Frame Range")

        row = layout.row(align=True)
        row.prop(settings, "start_frame", text="Start")
        row.prop(settings, "end_frame", text="End")

        layout.operator(KEYFRAME_INTERVAL_OT_scene_range.bl_idname)

        # Interval -----------------------------------------------------------
        layout.prop(settings, "interval")
        layout.prop(settings, "inverse_interval")

        # Channels -----------------------------------------------------------
        layout.separator()
        layout.label(text="Channels")
        layout.prop(settings, "all_channels", toggle=True)

        col = layout.column(align=True)
        col.enabled = not settings.all_channels
        col.prop(settings, "pos")
        col.prop(settings, "rot")
        col.prop(settings, "scl")
        col.prop(settings, "custom_props")

        # Preview ------------------------------------------------------------
        layout.separator()

        box = layout.box()
        box.label(text="Live Preview")

        frame_range = get_frame_range(settings)

        if frame_range is None:
            box.label(text="End must be greater than Start", icon='ERROR')
        else:
            start, end = frame_range
            interval = int(settings.interval)
            inverse = bool(settings.inverse_interval)

            total = count_target_frames(start, end, interval, inverse)

            shown = ", ".join(
                str(f)
                for f in islice(iter_target_frames(start, end, interval, inverse), 15)
            )

            if total > 15:
                shown += ", ..."

            box.label(text="Frames: " + (shown or "None"))
            box.label(text=f"Total: {total}")


