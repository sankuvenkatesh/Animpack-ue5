def custom_prop_info(struct, key):
    """Return (component_count, is_array) for numeric custom properties."""
    try:
        value = struct[key]
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        return 0, False

    if isinstance(value, (bool, int, float)):
        return 1, False

    if isinstance(value, (str, bytes)) or hasattr(value, "keys"):
        return 0, False

    try:
        count = len(value)
        if count and all(isinstance(component, (bool, int, float)) for component in value):
            return count, True
    except (TypeError, ValueError):
        pass

    return 0, False


class BakeChannel:
    """One property that is sampled and then keyed on the selected frames."""

    __slots__ = (
        "owner", "struct", "kind", "key", "data_path",
        "group", "count", "is_array", "values",
    )

    def __init__(
        self, owner, struct, kind, key, data_path, group,
        count, is_array=True,
    ):
        self.owner = owner
        self.struct = struct
        self.kind = kind
        self.key = key
        self.data_path = data_path
        self.group = group
        self.count = count
        self.is_array = is_array
        self.values = []

    def read(self):
        if self.kind == "rna":
            return [float(value) for value in getattr(self.struct, self.key)]

        value = self.struct[self.key]

        if self.is_array:
            return [float(component) for component in value]

        return [float(value)]


def build_bake_channels(targets, flags):
    use_pos, use_rot, use_scl, use_custom = flags
    channels = []

    for target in targets:
        struct = target.struct
        rna_props = []

        if use_pos:
            rna_props.append("location")

        if use_rot:
            rna_props.append(rotation_prop(struct))

        if use_scl:
            rna_props.append("scale")

        for prop in rna_props:
            try:
                count = len(getattr(struct, prop))
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                continue

            channels.append(
                BakeChannel(
                    target.owner,
                    struct,
                    "rna",
                    prop,
                    struct.path_from_id(prop),
                    target.group,
                    count,
                )
            )

        if use_custom and target.is_bone:
            base_path = struct.path_from_id()

            try:
                custom_keys = list(struct.keys())
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                custom_keys = []

            for key in custom_keys:
                if key == "_RNA_UI":
                    continue

                count, is_array = custom_prop_info(struct, key)
                if not count:
                    continue

                data_path = base_path + '["' + escape_identifier(key) + '"]'

                channels.append(
                    BakeChannel(
                        target.owner,
                        struct,
                        "custom",
                        key,
                        data_path,
                        target.group,
                        count,
                        is_array,
                    )
                )

    return channels


def ensure_slot(owner, anim, action):
    """Find a compatible existing slot or create one for this owner."""
    slot = getattr(anim, "action_slot", None)
    if slot is not None:
        return slot

    # If the Action already has a compatible slot, reuse it.
    try:
        suitable = list(anim.action_suitable_slots)
        if suitable:
            slot = suitable[0]
            anim.action_slot = slot
            return slot
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    # Prefer an exact name match before creating a new slot.
    owner_name = getattr(owner, "name", "Object")

    try:
        for candidate in action.slots:
            if (
                getattr(candidate, "target_id_type", None) == 'OBJECT'
                and getattr(candidate, "name_display", None) == owner_name
            ):
                anim.action_slot = candidate
                return candidate

            if getattr(candidate, "identifier", None) == "OB" + owner_name:
                anim.action_slot = candidate
                return candidate
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    slot = action.slots.new(id_type='OBJECT', name=owner_name)
    anim.action_slot = slot
    return slot


def ensure_channelbag(action, slot):
    """Ensure and return a channelbag for the slot, preferring Blender's helper."""
    try:
        from bpy_extras import anim_utils
        ensure_fn = getattr(anim_utils, "action_ensure_channelbag_for_slot", None)
        if callable(ensure_fn):
            bag = ensure_fn(action, slot)
            if bag is not None:
                return bag
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    # Direct fallback: find an existing bag in a KEYFRAME strip.
    for layer in action.layers:
        for strip in layer.strips:
            if getattr(strip, "type", None) != 'KEYFRAME':
                continue

            try:
                bag = strip.channelbag(slot)
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                bag = None

            if bag is not None:
                return bag

    # No bag exists: use the first layer or create one, then a KEYFRAME strip.
    if len(action.layers):
        layer = action.layers[0]
    else:
        layer = action.layers.new("Layer")

    strip = None
    for candidate in layer.strips:
        if getattr(candidate, "type", None) == 'KEYFRAME':
            strip = candidate
            break

    if strip is None:
        strip = layer.strips.new(type='KEYFRAME')

    return strip.channelbag(slot, ensure=True)


class AnimStore:
    """Find or create F-Curves on one owner's assigned Action Slot."""

    def __init__(self, owner):
        self.owner = owner

        anim = owner.animation_data
        if anim is None:
            anim = owner.animation_data_create()

        action = anim.action
        if action is None:
            action = bpy.data.actions.new(owner.name + "Action")
            anim.action = action

        self.action = action
        self.bag = None

        if hasattr(action, "layers"):
            slot = ensure_slot(owner, anim, action)
            self.bag = ensure_channelbag(action, slot)

    def fcurve(self, data_path, index, group):
        if self.bag is not None:
            curves = self.bag.fcurves

            ensure_fn = getattr(curves, "ensure", None)
            if callable(ensure_fn):
                return ensure_fn(data_path, index=index, group_name=group)

            fcurve = curves.find(data_path, index=index)
            if fcurve is None:
                fcurve = curves.new(data_path, index=index, group_name=group)
            return fcurve

        # Legacy fallback for pre-slotted Actions.
        fcurve = self.action.fcurves.find(data_path, index=index)
        if fcurve is None:
            fcurve = self.action.fcurves.new(
                data_path,
                index=index,
                action_group=group,
            )
        return fcurve


def _write_or_update_key(points, frame, value, existing_by_frame):
    """Update an existing key at this frame, otherwise insert a new key."""
    point = existing_by_frame.get(frame)

    if point is not None:
        point.co[1] = value
        return

    point = points.insert(frame, value, options={'FAST'})
    if point is not None:
        existing_by_frame[frame] = point


def write_channels(channels, frames):
    """
    Write sampled values.

    Returns:
      (keys written, F-Curves written, locked F-Curves skipped, errors, owners)

    Existing keys exactly on the sampled frames are updated in place, preventing
    duplicate keys when Bake is run more than once on the same frame range.
    """
    stores = {}
    written = 0
    curves = 0
    locked = 0
    errors = []

    for channel in channels:
        try:
            try:
                pointer = channel.owner.as_pointer()
            except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
                pointer = id(channel.owner)

            store = stores.get(pointer)
            if store is None:
                store = AnimStore(channel.owner)
                stores[pointer] = store

            for index in range(channel.count):
                fcurve = store.fcurve(channel.data_path, index, channel.group)

                if fcurve.lock:
                    locked += 1
                    continue

                points = fcurve.keyframe_points
                existing_by_frame = {}

                for point in points:
                    x = float(point.co[0])
                    nearest = round(x)
                    if abs(x - nearest) < 1e-4:
                        existing_by_frame[nearest] = point

                for frame, values in zip(frames, channel.values):
                    _write_or_update_key(
                        points,
                        frame,
                        values[index],
                        existing_by_frame,
                    )

                fcurve.update()
                written += len(frames)
                curves += 1

        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError) as exc:
            traceback.print_exc()
            errors.append(f"{channel.owner.name}: {exc}")

    return written, curves, locked, errors, [store.owner for store in stores.values()]


