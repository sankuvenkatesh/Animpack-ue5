def remove_keys_at_frames(fcurve, frame_set):
    """Remove keyframes whose X coordinate matches one of the requested frames."""
    points = fcurve.keyframe_points
    count = len(points)

    if count == 0:
        return 0

    coordinates = [0.0] * (count * 2)
    points.foreach_get("co", coordinates)

    hits = []

    for index in range(count):
        x = coordinates[index * 2]
        frame = round(x)

        if frame in frame_set and abs(x - frame) < 1e-3:
            hits.append(index)

    if not hits:
        return 0

    for index in reversed(hits):
        points.remove(points[index], fast=True)

    fcurve.update()
    return len(hits)


def delete_keys_for_owner(owner, targets, flags, frame_set):
    """Return (keyframes removed, F-Curves changed)."""
    use_pos, use_rot, use_scl, use_custom = flags
    fcurves, remove_fcurve = get_fcurves(owner)

    if not fcurves:
        return 0, 0

    exact_paths = set()
    custom_prefixes = []

    for target in targets:
        struct = target.struct

        if use_pos:
            exact_paths.add(struct.path_from_id("location"))

        if use_rot:
            exact_paths.update(struct.path_from_id(prop) for prop in ROTATION_PROPS)

        if use_scl:
            exact_paths.add(struct.path_from_id("scale"))

        if use_custom and target.is_bone:
            custom_prefixes.append(struct.path_from_id() + '["')

    custom_prefixes = tuple(custom_prefixes)

    removed = 0
    changed = 0
    emptied = []

    for fcurve in fcurves:
        path = fcurve.data_path
        wanted = path in exact_paths or (
            custom_prefixes and path.startswith(custom_prefixes)
        )

        if not wanted or fcurve.lock:
            continue

        count = remove_keys_at_frames(fcurve, frame_set)

        if count:
            removed += count
            changed += 1

            if len(fcurve.keyframe_points) == 0:
                emptied.append(fcurve)

    # Remove curves that became completely empty, as in the original add-on.
    for fcurve in emptied:
        try:
            remove_fcurve(fcurve)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
            # Keep the remaining operation safe if Blender refuses a removal.
            pass

    return removed, changed


