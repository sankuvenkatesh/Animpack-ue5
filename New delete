# ============================================================================
# ENSURE ACTION
# ============================================================================

def ensure_action(obj):
    """
    Blender 5.1 still supports normal keyframe_insert() usage,
    but creating an Action explicitly is useful when baking an object
    that does not already have animation.
    """

    if obj.animation_data is None:
        obj.animation_data_create()

    if obj.animation_data.action is None:
        action = bpy.data.actions.new(
            obj.name + "_Baked"
        )

        obj.animation_data.action = action

    return obj.animation_data.action


# ============================================================================
# BAKE OPERATOR
# ============================================================================

class BakeKeyframeOperator(Operator):

    bl_idname = "object.bake_keyframe_by_interval"
    bl_label = "Bake Keyframes"
    bl_description = (
        "Bake selected animation channels at the selected interval"
    )
    bl_options = {'REGISTER', 'UNDO'}

    @classmethod
    def poll(cls, context):
        return bool(context.selected_objects)

    def execute(self, context):

        props = context.scene.del_keyframe_props
        scene = context.scene
        objects = list(context.selected_objects)

        if not objects:
            self.report(
                {'WARNING'},
                "No objects selected"
            )
            return {'CANCELLED'}

        frames = build_target_frames(props)

        if not frames:
            self.report(
                {'WARNING'},
                "No frames selected by the current interval settings"
            )
            status_message("No frames to bake")
            return {'CANCELLED'}

        # Save current frame
        original_frame = scene.frame_current

        baked = 0

        # Snapshot selected bones for each armature.
        armature_bones = {}

        for obj in objects:

            if obj.type == 'ARMATURE':
                armature_bones[obj.name] = get_selected_pose_bones(
                    obj
                )

        try:

            # --------------------------------------------------------------
            # Create actions only for objects that actually need them.
            # --------------------------------------------------------------

            for obj in objects:

                if props.pos or props.rot or props.scl:

                    ensure_action(obj)

                if obj.type == 'ARMATURE' and props.custom_props:

                    # Bone custom properties are stored in the armature
                    # object's animation data.
                    ensure_action(obj)

            # --------------------------------------------------------------
            # Bake
            # --------------------------------------------------------------

            for frame in frames:

                scene.frame_set(frame)

                for obj in objects:

                    # ------------------------------------------------------
                    # Object transforms
                    # ------------------------------------------------------

                    if props.pos or props.rot or props.scl:

                        baked += insert_object_transform_keys(
                            obj,
                            frame,
                            props
                        )

                    # ------------------------------------------------------
                    # Bone animation
                    # ------------------------------------------------------

                    if obj.type != 'ARMATURE':
                        continue

                    selected_bones = armature_bones.get(
                        obj.name,
                        []
                    )

                    for pb in selected_bones:

                        baked += insert_bone_transform_keys(
                            pb,
                            frame,
                            props
                        )

                        if props.custom_props:
                            baked += insert_bone_custom_properties(
                                pb,
                                frame
                            )

        finally:

            # Always restore the original frame,
            # even if something goes wrong.
            try:
                scene.frame_set(original_frame)
            except Exception:
                scene.frame_current = original_frame

        refresh_animation_editors(context)

        status_message(
            f"Baked keyframes: {baked}"
        )

        self.report(
            {'INFO'},
            f"Baked keyframe channels: {baked}"
        )

        return {'FINISHED'}


# ============================================================================
# UI PANEL
# ============================================================================

class KeyframeIntervalPanel(Panel):

    bl_label = "Keyframe Interval Tools"
    bl_idname = "VIEW3D_PT_keyframe_interval_tools"

    bl_space_type = 'VIEW_3D'
    bl_region_type = 'UI'
    bl_category = 'Item'

    def draw(self, context):

        layout = self.layout
        props = context.scene.del_keyframe_props

        # --------------------------------------------------------------
        # Frame Range
        # --------------------------------------------------------------

        layout.label(
            text="Frame Range"
        )

        row = layout.row(
            align=True
        )

        row.prop(
            props,
            "start_frame",
            text="Start"
        )

        row.prop(
            props,
            "end_frame",
            text="End"
        )

        # --------------------------------------------------------------
        # Interval
        # --------------------------------------------------------------

        layout.prop(
            props,
            "interval"
        )

        layout.prop(
            props,
            "inverse_interval"
        )

        # --------------------------------------------------------------
        # Channels
        # --------------------------------------------------------------

        layout.separator()

        layout.label(
            text="Channels"
        )

        layout.prop(
            props,
            "all_channels",
            toggle=True
        )

        col = layout.column(
            align=True
        )

        col.enabled = not props.all_channels

        col.prop(
            props,
            "pos"
        )

        col.prop(
            props,
            "rot"
        )

        col.prop(
            props,
            "scl"
        )

        col.prop(
            props,
            "custom_props"
        )

        # --------------------------------------------------------------
        # Preview
        # --------------------------------------------------------------

        layout.separator()

        box = layout.box()

        box.label(
            text="Live Preview"
        )

        if props.preview_keyframes:
            box.label(
                text=f"Frames: {props.preview_keyframes}"
            )
        else:
            box.label(
                text="Frames: None"
            )

        box.label(
            text=f"Total: {props.preview_count}"
        )

        # --------------------------------------------------------------
        # Operators
        # --------------------------------------------------------------

        layout.separator()

        row = layout.row(
            align=True
        )

        row.operator(
            "object.delete_keyframe_by_interval",
            icon='KEY_HLT'
        )

        row.operator(
            "object.bake_keyframe_by_interval",
            icon='REC'
        )


# ============================================================================
# REGISTER
# ============================================================================

classes = (
    DelKeyProperties,
    DeleteKeyframeOperator,
    BakeKeyframeOperator,
    KeyframeIntervalPanel,
)


def register():

    for cls in classes:
        bpy.utils.register_class(cls)

    bpy.types.Scene.del_keyframe_props = bpy.props.PointerProperty(
        type=DelKeyProperties
    )

    # Initialize preview.
    try:
        props = bpy.context.scene.del_keyframe_props
        update_live_preview(
            bpy.context.scene,
            props
        )
    except Exception:
        pass


def unregister():

    if hasattr(
        bpy.types.Scene,
        "del_keyframe_props"
    ):
        del bpy.types.Scene.del_keyframe_props

    for cls in reversed(classes):
        bpy.utils.unregister_class(cls)


if __name__ == "__main__":
    register()
