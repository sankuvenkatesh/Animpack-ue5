# ============================================================================
# FRAME / INTERVAL LOGIC
# ============================================================================

def get_frame_range(settings):
    """Return the processing range. End frame is exclusive."""
    start = int(settings.start_frame)
    end = int(settings.end_frame)

    if end <= start:
        return None

    return start, end


def iter_target_frames(start, end, interval, inverse):
    """
    Yield frames to process.

    interval = 0:
        normal  -> every frame
        inverse -> no frame

    interval = N:
        Every (N + 1)th frame beginning at Start is a kept frame.
        normal  -> process the in-between frames
        inverse -> process only the kept frames
    """
    if interval <= 0:
        if not inverse:
            yield from range(start, end)
        return

    step = interval + 1

    if inverse:
        yield from range(start, end, step)
    else:
        for frame in range(start, end):
            if (frame - start) % step:
                yield frame


def count_target_frames(start, end, interval, inverse):
    total = end - start

    if total <= 0:
        return 0

    if interval <= 0:
        return 0 if inverse else total

    kept = len(range(start, end, interval + 1))
    return kept if inverse else total - kept


def build_target_frames(settings):
    frame_range = get_frame_range(settings)

    if frame_range is None:
        return []

    start, end = frame_range
    return list(
        iter_target_frames(
            start,
            end,
            int(settings.interval),
            bool(settings.inverse_interval),
        )
    )


