def find_channelbag(anim, action):
    """Return the channelbag belonging to the assigned Action Slot."""
    if anim is None or action is None:
        return None

    # Preferred 5.x helper: it follows the slot assigned to this AnimData.
    try:
        from bpy_extras import anim_utils
        getter = getattr(anim_utils, "animdata_get_channelbag_for_assigned_slot", None)
        if callable(getter):
            bag = getter(anim)
            if bag is not None:
                return bag
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    slot = getattr(anim, "action_slot", None)
    if slot is None:
        return None

    # Compatibility helper available in several slotted-Action builds.
    try:
        from bpy_extras import anim_utils
        getter = getattr(anim_utils, "action_get_channelbag_for_slot", None)
        if callable(getter):
            bag = getter(action, slot)
            if bag is not None:
                return bag
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    # Direct API fallback.
    try:
        for layer in action.layers:
            for strip in layer.strips:
                if getattr(strip, "type", None) == 'KEYFRAME':
                    bag = strip.channelbag(slot)
                    if bag is not None:
                        return bag
    except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
        pass

    return None


def get_fcurves(owner):
    """Return (F-Curves, remove-function) for the owner's active Action slot."""
    anim = getattr(owner, "animation_data", None)
    action = anim.action if anim is not None else None

    if action is None:
        return [], None

    # Blender 4.4+ / 5.x: F-Curves live in the assigned slot's channelbag.
    if hasattr(action, "layers"):
        bag = find_channelbag(anim, action)
        if bag is None:
            return [], None

        curves = bag.fcurves
        return list(curves), curves.remove

    # Legacy fallback for Blender versions that still expose Action.fcurves.
    curves = action.fcurves
    return list(curves), curves.remove


def escape_identifier(name):
    escape_fn = getattr(bpy.utils, "escape_identifier", None)

    if callable(escape_fn):
        try:
            return escape_fn(name)
        except (AttributeError, TypeError, KeyError, IndexError, ValueError, RuntimeError, ReferenceError, ImportError):
            pass

    return str(name).replace("\\", "\\\\").replace('"', '\\"')


def rotation_prop(struct):
    mode = getattr(struct, "rotation_mode", 'XYZ')

    if mode == 'QUATERNION':
        return "rotation_quaternion"

    if mode == 'AXIS_ANGLE':
        return "rotation_axis_angle"

    return "rotation_euler"


