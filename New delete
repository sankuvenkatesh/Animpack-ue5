def delete_bone_transform_keys(pb, frame, props):
    deleted = 0

    try:
        if props.pos:
            if pb.keyframe_delete(
                data_path="location",
                frame=frame
            ):
                deleted += 1
    except Exception:
        pass

    try:
        if props.rot:
            rotation_path = get_rotation_path(pb)

            if pb.keyframe_delete(
                data_path=rotation_path,
                frame=frame
            ):
                deleted += 1
    except Exception:
